@{
    string? currentPage = ViewContext.HttpContext.Request.Path;
    string? role        = Context.Session.GetString("UserRole");
    bool isAdmin        = role == "administrator";
    bool isClient       = role == "customer";
}

<!-- Menu -->
<aside id="layout-menu" class="layout-menu menu-vertical menu">

    <div class="app-brand demo">
        <a asp-controller="Home" asp-action="Index" class="app-brand-link gap-xl-0 gap-2">
            <span class="app-brand-logo demo me-1">
                @await Html.PartialAsync("../_Partials/_Macros")
            </span>
            <span class="app-brand-text demo menu-text fw-semibold ms-2">Bewegdeal</span>
        </a>
        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
            <i class="menu-toggle-icon d-xl-inline-block align-middle"></i>
        </a>
    </div>

    <div class="menu-inner-shadow"></div>

    @if (isClient)
    {
        <!-- Client navigation -->
        <div class="px-4 pt-4 pb-2">
            <a asp-controller="Home" asp-action="NewRequest"
               class="btn btn-primary waves-effect waves-light d-flex align-items-center justify-content-center gap-2 w-100">
                <i class="ri ri-add-circle-line icon-18px"></i>
                <span>New Request</span>
            </a>
        </div>

        <ul class="menu-inner py-1">

            <li class="menu-header small text-uppercase">
                <span class="menu-header-text">My Account</span>
            </li>

            <!-- My Requests -->
            <li class='menu-item@((currentPage == "/Home/Index" || currentPage == "/Home") ? " active" : "")'>
                <a asp-controller="Home" asp-action="Index" class="menu-link">
                    <i class="menu-icon icon-base ri ri-file-list-3-line"></i>
                    <div>My Requests</div>
                </a>
            </li>

            <!-- Settings -->
            <li class='menu-item@(currentPage == "/Home/Settings" ? " active" : "")'>
                <a asp-controller="Home" asp-action="Settings" class="menu-link">
                    <i class="menu-icon icon-base ri ri-settings-4-line"></i>
                    <div>Settings</div>
                </a>
            </li>

        </ul>
    }
    else
    {
        <!-- Admin navigation -->
        <ul class="menu-inner py-1">

            <li class="menu-header mt-7" style="padding-inline: 0 !important"></li>

            <!-- Dashboard -->
            <li class='menu-item@((currentPage == "/Home/Index" || currentPage == "/Home" || currentPage == "/") ? " active" : "")'>
                <a asp-controller="Home" asp-action="Index" class="menu-link">
                    <i class="menu-icon icon-base ri ri-home-smile-line"></i>
                    <div data-i18n="Dashboard">Dashboard</div>
                </a>
            </li>

            <!-- Users -->
            <li class='menu-item@(currentPage == "/Home/Users" ? " active" : "")'>
                <a asp-controller="Home" asp-action="Users" class="menu-link">
                    <i class="menu-icon icon-base ri ri-group-line"></i>
                    <div data-i18n="Users">Users</div>
                </a>
            </li>

            <!-- Settings -->
            <li class='menu-item@(currentPage == "/Home/Settings" ? " active" : "")'>
                <a asp-controller="Home" asp-action="Settings" class="menu-link">
                    <i class="menu-icon icon-base ri ri-settings-4-line"></i>
                    <div data-i18n="Settings">Settings</div>
                </a>
            </li>

        </ul>
    }

</aside>
<!-- / Menu -->
