@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "My Requests";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/@("@form-validation")/form-validation.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/vendor/libs/@("@form-validation")/popular.js"></script>
    <script src="~/vendor/libs/@("@form-validation")/bootstrap5.js"></script>
    <script src="~/vendor/libs/@("@form-validation")/auto-focus.js"></script>
}

@section PageScripts {
    <script src="~/js/app-task-list.js"></script>
}

<!-- Stat Cards -->
<div class="row g-6 mb-6">
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="me-1">
                        <p class="text-heading mb-1">Total Requests</p>
                        <div class="d-flex align-items-center">
                            <h4 class="mb-1 me-2">@ViewBag.TotalCount</h4>
                        </div>
                        <small class="mb-0">All your published requests</small>
                    </div>
                    <div class="avatar">
                        <div class="avatar-initial bg-label-primary rounded">
                            <div class="icon-base ri ri-file-list-3-line icon-26px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="me-1">
                        <p class="text-heading mb-1">Active</p>
                        <div class="d-flex align-items-center">
                            <h4 class="mb-1 me-2">@ViewBag.ActiveCount</h4>
                        </div>
                        <small class="mb-0">Visible to companies</small>
                    </div>
                    <div class="avatar">
                        <div class="avatar-initial bg-label-success rounded">
                            <div class="icon-base ri ri-checkbox-circle-line icon-26px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="me-1">
                        <p class="text-heading mb-1">Pending</p>
                        <div class="d-flex align-items-center">
                            <h4 class="mb-1 me-2">@ViewBag.PendingCount</h4>
                        </div>
                        <small class="mb-0">Awaiting approval</small>
                    </div>
                    <div class="avatar">
                        <div class="avatar-initial bg-label-warning rounded">
                            <div class="icon-base ri ri-time-line icon-26px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="me-1">
                        <p class="text-heading mb-1">Completed</p>
                        <div class="d-flex align-items-center">
                            <h4 class="mb-1 me-2">@ViewBag.CompletedCount</h4>
                        </div>
                        <small class="mb-0">Successfully fulfilled</small>
                    </div>
                    <div class="avatar">
                        <div class="avatar-initial bg-label-info rounded">
                            <div class="icon-base ri ri-medal-line icon-26px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    string? _role = Context.Session.GetString("UserRole");
}
@if (_role == "customer")
{
    <!-- Client CTA -->
    <div class="text-center mb-6">
        <a asp-controller="Home" asp-action="NewRequest"
           class="btn btn-primary btn-lg waves-effect waves-light px-8 py-3">
            <i class="ri ri-add-circle-line icon-20px me-2"></i>
            New Request
        </a>
        <p class="text-muted mt-3 mb-0 small">Publish a new service request and receive offers from registered companies</p>
    </div>
}

<!-- Requests Table -->
<div class="card">
    <div class="card-header border-bottom">
        <h6 class="card-title mb-0">Filters</h6>
        <div class="d-flex justify-content-between align-items-center row pt-4 pb-2 gap-4 gap-md-0 gx-5">
            <div class="col-md-6 task_type"></div>
            <div class="col-md-6 task_status"></div>
        </div>
    </div>
    <div class="card-datatable">
        <table class="datatables-tasks table">
            <thead>
                <tr>
                    <th></th>
                    <th></th>
                    <th>Request</th>
                    <th>Date</th>
                    <th>Cost</th>
                    <th>Status</th>
                    <th>Views</th>
                    <th></th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- ══ Request Preview Offcanvas ════════════════════════════════════════════ -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="requestPreviewOffcanvas"
     aria-labelledby="requestPreviewLabel" style="width:460px;max-width:100vw">

    <div class="offcanvas-header border-bottom py-4">
        <h5 class="offcanvas-title fw-semibold" id="requestPreviewLabel">Request Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body p-0 overflow-y-auto">

        <!-- Main image banner -->
        <div id="previewImageWrap" style="height:220px;overflow:hidden;background:var(--bs-secondary-bg)">
            <img id="previewImage" src="" alt=""
                 style="width:100%;height:100%;object-fit:cover;display:none" />
            <div id="previewImagePlaceholder"
                 class="w-100 h-100 d-flex align-items-center justify-content-center">
                <i id="previewTypePlaceholderIcon" class="ri icon-64px text-secondary" style="font-size:72px"></i>
            </div>
        </div>

        <div class="p-5">

            <!-- Badges row -->
            <div class="d-flex align-items-center gap-2 mb-3">
                <span id="previewTypeBadge"  class="badge rounded-pill"></span>
                <span id="previewStatusBadge" class="badge rounded-pill"></span>
            </div>

            <!-- Title -->
            <h5 id="previewName" class="fw-semibold mb-2"></h5>

            <!-- Description -->
            <p id="previewDescription" class="text-muted mb-5" style="white-space:pre-line"></p>

            <hr class="my-4" />

            <!-- Meta grid -->
            <div class="row g-4 mb-4">
                <div class="col-6">
                    <div class="d-flex align-items-start gap-2">
                        <div class="avatar-initial rounded bg-label-primary d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:38px;height:38px">
                            <i class="ri ri-money-euro-circle-line icon-20px"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">Budget</p>
                            <p id="previewCost" class="fw-medium mb-0"></p>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-flex align-items-start gap-2">
                        <div class="avatar-initial rounded bg-label-info d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:38px;height:38px">
                            <i class="ri ri-calendar-line icon-20px"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">Created</p>
                            <p id="previewDate" class="fw-medium mb-0"></p>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-flex align-items-start gap-2">
                        <div class="avatar-initial rounded bg-label-success d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:38px;height:38px">
                            <i class="ri ri-eye-line icon-20px"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">Company Views</p>
                            <p id="previewViews" class="fw-medium mb-0"></p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Addresses -->
            <div id="previewAddressSection" class="d-none mb-4">
                <hr class="my-4" />
                <h6 class="fw-semibold mb-3">
                    <i class="ri ri-map-pin-line me-1 text-primary"></i>Locations
                </h6>
                <div id="previewPickupWrap" class="d-none mb-3">
                    <p class="text-muted small mb-1">Pickup address</p>
                    <p id="previewPickup" class="fw-medium mb-0"></p>
                </div>
                <div id="previewDeliveryWrap" class="d-none">
                    <p class="text-muted small mb-1">Delivery address</p>
                    <p id="previewDelivery" class="fw-medium mb-0"></p>
                </div>
            </div>

            <!-- Additional media -->
            <div id="previewMediaSection" class="d-none mb-4">
                <hr class="my-4" />
                <h6 class="fw-semibold mb-3">
                    <i class="ri ri-image-line me-1 text-primary"></i>Media
                </h6>
                <div id="previewMediaGrid" class="d-flex flex-wrap gap-2"></div>
            </div>

            <!-- Action buttons -->
            <hr class="my-4" />
            <div class="d-flex gap-3">
                <a id="previewEditBtn" href="#"
                   class="btn btn-primary waves-effect waves-light flex-grow-1">
                    <i class="ri ri-edit-box-line me-1"></i>Edit Request
                </a>
                <button type="button" id="previewDeleteBtn"
                        class="btn btn-outline-danger waves-effect">
                    <i class="ri ri-delete-bin-7-line icon-16px"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary waves-effect"
                        data-bs-dismiss="offcanvas">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>
<!-- /Request Preview Offcanvas -->

<!-- ══ Delete Confirmation Modal ════════════════════════════════════════════ -->
<div class="modal fade" id="deleteTaskModal" tabindex="-1" aria-labelledby="deleteTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:420px">
        <div class="modal-content">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-semibold" id="deleteTaskModalLabel">Delete Request?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="avatar-initial rounded bg-label-danger d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:44px;height:44px">
                        <i class="ri ri-delete-bin-7-line icon-22px text-danger"></i>
                    </div>
                    <div>
                        <p class="mb-1 fw-medium" id="deleteTaskName"></p>
                        <p class="text-muted small mb-0">This action cannot be undone. The request and all uploaded files will be permanently deleted.</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-outline-secondary waves-effect" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteTaskForm" method="post" asp-controller="Home" asp-action="DeleteTask" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteTaskId" value="" />
                    <button type="submit" class="btn btn-danger waves-effect waves-light">
                        <i class="ri ri-delete-bin-7-line icon-16px me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- /Delete Confirmation Modal -->
