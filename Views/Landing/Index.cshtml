@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Home";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/front-page-help-center.css" />
    <link rel="stylesheet" href="~/vendor/css/pages/front-page-landing.css" />
    <link rel="stylesheet" href="~/vendor/libs/animate-on-scroll/animate-on-scroll.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/animate-on-scroll/animate-on-scroll.js"></script>
}

@section PageScripts {
    <script src="~/js/extended-ui-timeline.js" asp-append-version="true"></script>
}

@* ************** Content ************** *@


<!-- Banner: Start -->
<section id="banner" class="section-py first-section-pt help-center-header position-relative overflow-hidden">
    <img class="banner-bg-img z-n1" src="~/img/pages/profile-banner.png" alt="header" data-app-light-img="pages/profile-banner.png" data-app-dark-img="pages/profile-banner.png" />
    <h1 class="text-center fw-bold">Your service, <span class="text-primary">delivered.</span></h1>
    <div class="input-wrapper my-4 input-group input-group-merge position-relative mx-auto">
        <p class="text-center px-4 mb-0">
            Bewegdeal connects you with trusted providers for moving, junk removal,
            store pickup, and vehicle transport — all in one place.
        </p>
    </div>
    
</section>
<!-- Banner: End -->
<!-- Services: Start -->
<section id="services" class="section-py landing-features">
    <div class="container">
        <h6 class="text-center d-flex justify-content-center align-items-center mb-6">
            <img src="~/img/front-pages/icons/section-title-icon.png" alt="section title icon" class="me-2" height="19" />
            <span class="text-uppercase">services</span>
        </h6>
        <div class="text-center mb-8">
            <h2 class="mb-2">Everything you need, on demand</h2>
            <p class="text-muted">
                Four specialised services. One trusted platform.
            </p>
        </div>
        <div class="row gx-0 gy-5 gx-sm-6">
            <div class="col-md-3 col-sm-6 text-center">
                <span class="badge rounded-pill bg-label-success bg-label-hover fun-facts-icon mb-6 p-5"><i class="icon-base ri ri-truck-line icon-42px"></i></span>
                <h5 class="mb-3">@AnnotationEnum.General.Service.Moving</h5>
                <h6 class="mb-0 text-body">
                    Relocating home or office? We match you with professional movers
                    who handle your belongings with care, from packing to delivery.
                </h6>
            </div>
            <div class="col-md-3 col-sm-6 text-center">
                <span class="badge rounded-pill bg-label-danger bg-label-hover fun-facts-icon mb-6 p-5"><i class="icon-base ri ri-recycle-line icon-42px"></i></span>
                <h5 class="mb-3">@AnnotationEnum.General.Service.Removal</h5>
                <h6 class="mb-0 text-body">
                    Clear out unwanted items responsibly. Our providers collect,
                    haul, and dispose of your junk in an eco-friendly manner.
                </h6>
            </div>
            <div class="col-md-3 col-sm-6 text-center">
                <span class="badge rounded-pill bg-label-warning bg-label-hover fun-facts-icon mb-6 p-5"><i class="icon-base ri ri-shopping-bag-4-line icon-42px"></i></span>
                <h5 class="mb-3">@AnnotationEnum.General.Service.Pickup</h5>
                <h6 class="mb-0 text-body">
                    Bought something big? We pick it up from any store and
                    deliver it straight to your door — no van rental needed.
                </h6>
            </div>
            <div class="col-md-3 col-sm-6 text-center">
                <span class="badge rounded-pill bg-label-info bg-label-hover fun-facts-icon mb-6 p-5"><i class="icon-base ri ri-car-line icon-42px"></i></span>
                <h5 class="mb-3">@AnnotationEnum.General.Service.Transport</h5>
                <h6 class="mb-0 text-body">
                    Broken down or need your car moved? We dispatch licensed
                    recovery operators to evacuate your vehicle safely.
                </h6>
            </div>
        </div>
    </div>
</section>
<!-- Services: End -->
<!-- HIW: Start -->
<section id="hiw" class="section-py bg-body" style="isolation: isolate;">
    <div class="container">
        <h6 class="text-center d-flex justify-content-center align-items-center mb-6">
            <img src="~/img/front-pages/icons/section-title-icon.png" alt="section title icon" class="me-2" height="19" />
            <span class="text-uppercase">how it works</span>
        </h6>
        <div class="text-center mb-8">
            <h2 class="mb-2">How Bewegdeal works</h2>
            <p class="text-muted">Four sequential steps — each one unlocks the next.</p>
        </div>
        <div class="row overflow-hidden">
            <div class="col-12">
                <ul class="timeline timeline-center mt-12">
                    <li class="timeline-item">
                        <span class="timeline-indicator timeline-indicator-primary" data-aos="zoom-in" data-aos-delay="200">
                            <i class="icon-base ri ri-user-add-line"></i>
                        </span>
                        <div class="timeline-event card p-0" data-aos="fade-right">
                            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                                <h6 class="card-title mb-0">Register</h6>
                                <div class="meta">
                                    <a asp-controller="Account" asp-action="Register" class="badge rounded-pill bg-label-primary me-1">Get me there</a>
                                </div>
                            </div>
                            <div class="card-body">
                                <p class="mb-2">
                                    Create your free account. Registration takes under a minute.
                                </p>
                                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-primary"></i>
                                        <span class="text-body">Choose your role: client or Company</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-primary"></i>
                                        <span class="text-body">Complete your profile and verify your email</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-primary"></i>
                                        <span class="text-body">Access the full platform instantly</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </li>
                    <li class="timeline-item">
                        <span class="timeline-indicator timeline-indicator-warning" data-aos="zoom-in" data-aos-delay="200">
                            <i class="icon-base ri ri-file-list-3-line"></i>
                        </span>
                        <div class="timeline-event card p-0" data-aos="fade-left">
                            <h6 class="card-header">Make a Request</h6>
                            <div class="card-body">
                                <p class="mb-2">
                                    Describe what you need in detail so providers can give you
                                    accurate quotes and show up prepared.
                                </p>
                                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-warning"></i>
                                        <span class="text-body">Select the service type and location</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-warning"></i>
                                        <span class="text-body">Upload photos and videos to show the job</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-warning"></i>
                                        <span class="text-body">Set your preferred date, time, and budget</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </li>
                    <li class="timeline-item">
                        <span class="timeline-indicator timeline-indicator-info" data-aos="zoom-in" data-aos-delay="200">
                            <i class="icon-base ri ri-discuss-line"></i>
                        </span>
                        <div class="timeline-event card p-0" data-aos="fade-right">
                            <h6 class="card-header">Make a Deal</h6>
                            <div class="card-body">
                                <p class="mb-2">
                                    Interested companies respond to your request. Chat directly,
                                    negotiate the price, and confirm the provider you trust most.
                                </p>
                                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-info"></i>
                                        <span class="text-body">Receive offers from provider(s)</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-info"></i>
                                        <span class="text-body">Chat, ask questions, and negotiate price</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-info"></i>
                                        <span class="text-body">Confirm the deal with a single click</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </li>
                    <li class="timeline-item">
                        <span class="timeline-indicator timeline-indicator-success" data-aos="zoom-in" data-aos-delay="200">
                            <i class="icon-base ri ri-open-arm-line"></i>
                        </span>
                        <div class="timeline-event card p-0" data-aos="fade-left">
                            <h6 class="card-header">Sit Back &amp; Relax</h6>
                            <div class="card-body">
                                <p class="mb-2">
                                    The provider takes it from here. Your deal is in safe hands.
                                </p>
                                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-success"></i>
                                        <span class="text-body">Provider arrives and completes the job</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-success"></i>
                                        <span class="text-body">Pay securely and leave a review</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-success"></i>
                                        <span class="text-body">Get back for more</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>
<!-- HIW: End -->
<!-- Register: Start -->
<section id="register" class="section-py landing-contact">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="mb-3">Ready to get things moving?</h2>
                <p class="text-muted mb-6">
                    Join thousands of clients and providers already using Bewegdeal.
                    Sign up free and post your first job in under two minutes.
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center">
                    <a asp-action="Register" asp-controller="Account" class="btn btn-outline-primary btn-lg">
                        <i class="ri ri-user-add-line me-2"></i>Become A Member
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Register: End -->
<!-- FAQ: Start -->
<section id="faq" class="section-py bg-body landing-faq">
    <div class="container bg-icon-right">
        <img src="~/img/front-pages/icons/bg-right-icon-light.png" alt="section icon" class="position-absolute top-0 end-0" data-speed="1" data-app-light-img="front-pages/icons/bg-right-icon-light.png" data-app-dark-img="front-pages/icons/bg-right-icon-dark.png" />
        <h6 class="text-center d-flex justify-content-center align-items-center mb-6">
            <img src="~/img/front-pages/icons/section-title-icon.png" alt="section title icon" class="me-2" height="19" />
            <span class="text-uppercase">faq</span>
        </h6>
        <h5 class="text-center mb-2">Frequently asked<span class="h4 fw-bold"> questions</span></h5>
        <p class="text-center fw-medium mb-4 mb-md-12 pb-4">Browse through these FAQs to find answers to commonly asked questions.</p>
        <div class="row gy-5">
            <div class="col-lg-5">
                <div class="text-center">
                    <img src="~/img/front-pages/landing-page/sitting-girl-with-laptop.png"
                         alt="sitting girl with laptop"
                         class="faq-image scaleX-n1-rtl" />
                </div>
            </div>
            <div class="col-lg-7">
                <div class="accordion" id="accordionFront">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-One">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionOne" aria-expanded="false" aria-controls="accordionOne">Is Bewegdeal free to use as a customer?</button>
                        </h2>
                        <div id="accordionOne" class="accordion-collapse collapse" data-bs-parent="#accordionFront" aria-labelledby="accordionOne">
                            <div class="accordion-body">Yes, completely free. Posting a request, browsing offers, and chatting with companies costs you nothing. You only pay the company you hire — the price you agree on directly, with no hidden platform fees added on top.</div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Two">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionTwo" aria-expanded="false" aria-controls="accordionTwo">How quickly will companies respond to my request?</button>
                        </h2>
                        <div id="accordionTwo" class="accordion-collapse collapse" aria-labelledby="accordionTwo" data-bs-parent="#accordionFront">
                            <div class="accordion-body">Your request goes live on the marketplace the moment you submit it. Companies browsing for work in your service category will see it right away. Response times depend on demand, but providing clear photos, a realistic budget, and a flexible schedule will attract faster replies.</div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Three">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionThree" aria-expanded="false" aria-controls="accordionThree">Can I change my request after posting it?</button>
                        </h2>
                        <div id="accordionThree" class="accordion-collapse collapse" aria-labelledby="accordionThree" data-bs-parent="#accordionFront">
                            <div class="accordion-body">Yes, as long as the request is still in <strong>Pending</strong> status you can edit any detail — title, description, address, price, photos, and videos. Once a company has entered negotiation and the status moves forward, the request is locked to keep the agreed terms intact.</div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Four">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionFour" aria-expanded="false" aria-controls="accordionFour">What types of jobs can I post?</button>
                        </h2>
                        <div id="accordionFour" class="accordion-collapse collapse" aria-labelledby="accordionFour" data-bs-parent="#accordionFront">
                            <div class="accordion-body">Bewegdeal currently supports four service categories: <strong>Moving</strong> (relocating belongings from A to B), <strong>Junk Removal</strong> (clearing out items you no longer need), <strong>Store Pickup</strong> (having a purchased item collected and delivered to you), and <strong>Vehicle Transport</strong> (moving your car or other vehicle to a new location).</div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Five">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionFive" aria-expanded="false" aria-controls="accordionFive">What happens if I'm not happy with the company?</button>
                        </h2>
                        <div id="accordionFive" class="accordion-collapse collapse" aria-labelledby="accordionFive" data-bs-parent="#accordionFront">
                            <div class="accordion-body">You are in control at every step. During negotiation you can walk away at any time — no obligation until you explicitly agree to a deal. If a company doesn't meet expectations after the job, simply don't mark the request as resolved. Your feedback shapes each company's public rating and helps other customers make informed decisions.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- FAQ: End -->

