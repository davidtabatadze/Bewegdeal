@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Home";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/front-page-help-center.css" />
    <link rel="stylesheet" href="~/vendor/css/pages/front-page-landing.css" />
    <link rel="stylesheet" href="~/vendor/libs/animate-on-scroll/animate-on-scroll.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/animate-on-scroll/animate-on-scroll.js"></script>
}

@section PageScripts {
    <script src="~/js/extended-ui-timeline.js" asp-append-version="true"></script>
}

@* ************** Content ************** *@


<!-- Banner: Start -->
<section id="banner" class="section-py first-section-pt help-center-header position-relative overflow-hidden">
    @* <img class="banner-bg-img z-n1" src="~/img/pages/profile-banner.png" alt="header" data-app-light-img="pages/profile-banner.png" data-app-dark-img="pages/profile-banner.png" /> *@
    <div class="container">
        <img class="img-fluid d-block mx-auto mb-6" style="max-inline-size: 700px; inline-size: 100%;" src="~/img/pages/bewegdeal-banner.png" alt="Bewegdeal" data-app-light-img="pages/bewegdeal-banner.png" data-app-dark-img="pages/bewegdeal-banner.png" />
    </div>
    <h1 class="text-center fw-bold">Ihr Auftrag, <span class="text-primary">Ihr Preis.</span></h1>
    <div class="input-wrapper my-4 input-group input-group-merge position-relative mx-auto">
        <p class="text-center px-4 mb-0">
            Bewegdeal verbindet Sie mit registrierten Unternehmen für Umzug, Entrümpelung, Abholung und Fahrzeugtransport – alles an einem Ort.
        </p>
    </div>
</section>
<!-- Banner: End -->
<!-- Services: Start -->
<section id="services" class="section-py landing-features">
    <div class="container">
        <h6 class="text-center d-flex justify-content-center align-items-center mb-6">
            <img src="~/img/front-pages/icons/section-title-icon.png" alt="section title icon" class="me-2" height="19" />
            <span class="text-uppercase">Dienstleistungen</span>
        </h6>
        <div class="text-center mb-8">
            <h2 class="mb-2">Alles, was Sie brauchen – an einem Ort</h2>
            <p class="text-muted">
                Vier Bereiche. Eine Plattform. Viele Möglichkeiten.
            </p>
        </div>
        <div class="row gx-0 gy-5 gx-sm-6">
            <div class="col-md-3 col-sm-6 text-center">
                <span class="badge rounded-pill bg-label-success bg-label-hover fun-facts-icon mb-6 p-5"><i class="icon-base ri ri-truck-line icon-42px"></i></span>
                <h5 class="mb-3">@AnnotationEnum.General.Service.Moving</h5>
                <h6 class="mb-0 text-body">
                    Umzug zu Hause oder im Büro? Erstellen Sie eine Anfrage für Ihren Umzug. 
                    Registrierte Unternehmen können Ihnen ein Angebot machen – vom Transport einzelner Möbel bis zum kompletten Umzug.
                </h6>
            </div>
            <div class="col-md-3 col-sm-6 text-center">
                <span class="badge rounded-pill bg-label-danger bg-label-hover fun-facts-icon mb-6 p-5"><i class="icon-base ri ri-recycle-line icon-42px"></i></span>
                <h5 class="mb-3">@AnnotationEnum.General.Service.Removal</h5>
                <h6 class="mb-0 text-body">
                    Ob Keller, Wohnung, Büro oder Sperrmüll – erstellen Sie Ihre Anfrage und erhalten Sie Angebote von registrierten Unternehmen.
                </h6>
            </div>
            <div class="col-md-3 col-sm-6 text-center">
                <span class="badge rounded-pill bg-label-warning bg-label-hover fun-facts-icon mb-6 p-5"><i class="icon-base ri ri-shopping-bag-4-line icon-42px"></i></span>
                <h5 class="mb-3">@AnnotationEnum.General.Service.Pickup</h5>
                <h6 class="mb-0 text-body">
                    Ob Möbel, Geräte oder größere Einkäufe – erstellen Sie eine Anfrage und lassen Sie sich Angebote für die Abholung und Lieferung machen.
                </h6>
            </div>
            <div class="col-md-3 col-sm-6 text-center">
                <span class="badge rounded-pill bg-label-info bg-label-hover fun-facts-icon mb-6 p-5"><i class="icon-base ri ri-car-line icon-42px"></i></span>
                <h5 class="mb-3">@AnnotationEnum.General.Service.Transport</h5>
                <h6 class="mb-0 text-body">
                    Muss ein Fahrzeug transportiert werden? Erstellen Sie eine Anfrage und registrierte Unternehmen können Ihnen ein Angebot für den Transport machen.
                </h6>
            </div>
        </div>
    </div>
</section>
<!-- Services: End -->
<!-- HIW: Start -->
<section id="hiw" class="section-py bg-body" style="isolation: isolate;">
    <div class="container">
        <h6 class="text-center d-flex justify-content-center align-items-center mb-6">
            <img src="~/img/front-pages/icons/section-title-icon.png" alt="section title icon" class="me-2" height="19" />
            <span class="text-uppercase">So funktioniert es</span>
        </h6>
        <div class="text-center mb-8">
            <h2 class="mb-2">So funktioniert Bewegdeal</h2>
            <p class="text-muted">In wenigen Schritten von der Anfrage bis zur Buchung.</p>
        </div>
        <div class="row overflow-hidden">
            <div class="col-12">
                <ul class="timeline timeline-center mt-12">
                    <li class="timeline-item">
                        <span class="timeline-indicator timeline-indicator-primary" data-aos="zoom-in" data-aos-delay="200">
                            <i class="icon-base ri ri-user-add-line"></i>
                        </span>
                        <div class="timeline-event card p-0" data-aos="fade-right">
                            <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                                <h6 class="card-title mb-0">Registrieren</h6>
                                <div class="meta">
                                    <a asp-controller="Account" asp-action="Register" class="badge rounded-pill bg-label-primary me-1">Jetzt starten</a>
                                </div>
                            </div>
                            <div class="card-body">
                                <p class="mb-2">
                                    Erstellen Sie Ihr kostenloses Konto und wählen Sie Ihre Rolle: Kunde oder Unternehmen.
                                </p>
                                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-primary"></i>
                                        <span class="text-body">E-Mail-Adresse und Telefonnummer bestätigen</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-primary"></i>
                                        <span class="text-body">Profil vervollständigen</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-primary"></i>
                                        <span class="text-body">Plattformfunktionen nutzen</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </li>
                    <li class="timeline-item">
                        <span class="timeline-indicator timeline-indicator-warning" data-aos="zoom-in" data-aos-delay="200">
                            <i class="icon-base ri ri-file-list-3-line"></i>
                        </span>
                        <div class="timeline-event card p-0" data-aos="fade-left">
                            <h6 class="card-header">Auftrag erstellen</h6>
                            <div class="card-body">
                                <p class="mb-2">
                                    Beschreiben Sie Ihren Auftrag so genau wie möglich, damit Unternehmen ihn gut einschätzen können.
                                </p>
                                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-warning"></i>
                                        <span class="text-body">Servicetyp und PLZ/Region auswählen</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-warning"></i>
                                        <span class="text-body">Termin oder Zeitraum angeben</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-warning"></i>
                                        <span class="text-body">Preisvorstellung eintragen</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-warning"></i>
                                        <span class="text-body">Fotos oder Videos freiwillig hinzufügen</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </li>
                    <li class="timeline-item">
                        <span class="timeline-indicator timeline-indicator-info" data-aos="zoom-in" data-aos-delay="200">
                            <i class="icon-base ri ri-discuss-line"></i>
                        </span>
                        <div class="timeline-event card p-0" data-aos="fade-right">
                            <h6 class="card-header">Einigung erzielen</h6>
                            <div class="card-body">
                                <p class="mb-2">
                                    Interessierte Unternehmen können einen Chat zu Ihrer Anfrage starten. Im Chat klären Sie Details, Preis und Termin. 
                                    Wenn alles passt, können Sie das Angebot verbindlich buchen.
                                </p>
                                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-info"></i>
                                        <span class="text-body">Angebote erhalten</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-info"></i>
                                        <span class="text-body">Fragen im Chat klären</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-info"></i>
                                        <span class="text-body">Angebot annehmen oder ablehnen</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </li>
                    <li class="timeline-item">
                        <span class="timeline-indicator timeline-indicator-success" data-aos="zoom-in" data-aos-delay="200">
                            <i class="icon-base ri ri-open-arm-line"></i>
                        </span>
                        <div class="timeline-event card p-0" data-aos="fade-left">
                            <h6 class="card-header">Auftrag erledigen</h6>
                            <div class="card-body">
                                <p class="mb-2">
                                    Nach der verbindlichen Buchung führt das Unternehmen die vereinbarte Leistung aus. 
                                    Die Zahlung erfolgt direkt zwischen Ihnen und dem Unternehmen.
                                </p>
                                <ul class="list-unstyled mb-0 d-flex flex-column gap-2">
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-success"></i>
                                        <span class="text-body">Unternehmen führt den Auftrag aus</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-success"></i>
                                        <span class="text-body">Zahlung direkt mit dem Unternehmen klären</span>
                                    </li>
                                    <li class="d-flex align-items-center gap-2">
                                        <i class="ri ri-check-line text-success"></i>
                                        <span class="text-body">Auftrag abschließen und Bewertung abgeben</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>
<!-- HIW: End -->
<!-- Register: Start -->
<section id="register" class="section-py landing-contact">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h2 class="mb-3">Bereit, die Dinge in Bewegung zu bringen?</h2>
                <p class="text-muted mb-6">
                    Erstellen Sie kostenlos Ihre erste Anfrage auf Bewegdeal und finden Sie registrierte Unternehmen für Umzug, Entrümpelung, Abholung oder Fahrzeugtransport.
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center">
                    <a asp-action="Register" asp-controller="Account" class="btn btn-outline-primary btn-lg">
                        <i class="ri ri-user-add-line me-2"></i>Jetzt Registrieren
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Register: End -->
<!-- FAQ: Start -->
<section id="faq" class="section-py bg-body landing-faq">
    <div class="container bg-icon-right">
        <img src="~/img/front-pages/icons/bg-right-icon-light.png" alt="section icon" class="position-absolute top-0 end-0" data-speed="1" data-app-light-img="front-pages/icons/bg-right-icon-light.png" data-app-dark-img="front-pages/icons/bg-right-icon-dark.png" />
        <h6 class="text-center d-flex justify-content-center align-items-center mb-6">
            <img src="~/img/front-pages/icons/section-title-icon.png" alt="section title icon" class="me-2" height="19" />
            <span class="text-uppercase">FAQ</span>
        </h6>
        <h5 class="text-center mb-2">Häufig gestellte<span class="h4 fw-bold"> Fragen</span></h5>
        <p class="text-center fw-medium mb-4 mb-md-12 pb-4">Hier finden Sie Antworten auf wichtige Fragen zur Nutzung von Bewegdeal.</p>
        <div class="row gy-5">
            <div class="col-lg-5">
                <div class="text-center">
                    <img src="~/img/front-pages/landing-page/sitting-girl-with-laptop.png"
                         alt="sitting girl with laptop"
                         class="faq-image scaleX-n1-rtl" />
                </div>
            </div>
            <div class="col-lg-7">
                <div class="accordion" id="accordionFront">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-One">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionOne" aria-expanded="false" aria-controls="accordionOne">
                                Ist die Nutzung für Kunden kostenlos?
                            </button>
                        </h2>
                        <div id="accordionOne" class="accordion-collapse collapse" data-bs-parent="#accordionFront" aria-labelledby="accordionOne">
                            <div class="accordion-body">
                                Ja. Kunden nutzen die Plattform kostenlos.
                                Kosten entstehen erst durch die Beauftragung einer Firma – diese werden direkt mit der Firma vereinbart.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Two">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionTwo" aria-expanded="false" aria-controls="accordionTwo">
                                Wie funktioniert die Beauftragung?
                            </button>
                        </h2>
                        <div id="accordionTwo" class="accordion-collapse collapse" aria-labelledby="accordionTwo" data-bs-parent="#accordionFront">
                            <div class="accordion-body">
                                Nachdem du einen Auftrag eingestellt hast, meldet sich eine Firma bei dir.
                                Die Kommunikation erfolgt direkt über den Chat auf der Plattform.
                                Du kannst mit dieser Firma über den Preis und die Details verhandeln.
                                Kommt es zu einer Einigung, gilt der Auftrag als vereinbart.
                                Kommt keine Einigung zustande, kann der Auftrag abgelehnt werden und eine andere Firma erhält die Möglichkeit, dich zu kontaktieren.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Three">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionThree" aria-expanded="false" aria-controls="accordionThree">
                                Kommt der Vertrag über die Plattform zustande?
                            </button>
                        </h2>
                        <div id="accordionThree" class="accordion-collapse collapse" aria-labelledby="accordionThree" data-bs-parent="#accordionFront">
                            <div class="accordion-body">
                                Nein. Der Vertrag kommt immer direkt zwischen Kunde und Firma zustande.
                                <strong>bewegdeal.at</strong> ist keine ausführende Firma, sondern eine Vermittlungsplattform.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Four">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionFour" aria-expanded="false" aria-controls="accordionFour">
                                Darf ich Telefonnummern oder Adressen im Chat austauschen?
                            </button>
                        </h2>
                        <div id="accordionFour" class="accordion-collapse collapse" aria-labelledby="accordionFour" data-bs-parent="#accordionFront">
                            <div class="accordion-body">
                                Nein.
                                Vor einer Einigung dürfen keine Kontaktdaten ausgetauscht werden.
                                Die gesamte Kommunikation erfolgt bis zur Einigung ausschließlich über die Plattform.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Five">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionFive" aria-expanded="false" aria-controls="accordionFive">
                                Werden Nachrichten im Chat kontrolliert?
                            </button>
                        </h2>
                        <div id="accordionFive" class="accordion-collapse collapse" aria-labelledby="accordionFive" data-bs-parent="#accordionFront">
                            <div class="accordion-body">
                                Chats werden automatisiert auf mögliche Verstöße gegen die Plattformregeln überprüft.
                                Eine Einsicht erfolgt  wenn Hinweise auf einen Verstoß vorliegen.
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="head-Six">
                            <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionSix" aria-expanded="false" aria-controls="accordionSix">
                                Welche Firmen sind auf der Plattform?
                            </button>
                        </h2>
                        <div id="accordionSix" class="accordion-collapse collapse" aria-labelledby="accordionSix" data-bs-parent="#accordionFront">
                            <div class="accordion-body">
                                Registrieren können sich ausschließlich gewerblich tätige Unternehmen.
                                Zur Identifikation kann eine gültige UID- oder GISA-Nummer erforderlich sein. 
                                Die Prüfung dient ausschließlich der Feststellung der gewerblichen Registrierung.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- FAQ: End -->

