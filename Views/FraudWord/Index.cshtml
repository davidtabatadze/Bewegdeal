@model List<string>
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Fraud Words";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/tagify/tagify.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/tagify/tagify.js"></script>
}

@section PageScripts {
    <script src="~/js/app-fraud-word.js" asp-append-version="true"></script>
}

<div class="d-flex flex-column gap-6" style="min-height: calc(100dvh - 8rem)">

    <div class="alert alert-danger mb-0" role="alert">
        <div class="d-flex align-items-center mb-2">
            <i class="icon-base ri ri-error-warning-line me-2 icon-22px"></i>
            <strong>Mit Vorsicht verwenden</strong>
        </div>
        <ul class="mb-0">
            <li>Diese Wörter werden verwendet, um Betrug in Chatnachrichten zu erkennen.</li>
            <li>Seien Sie vorsichtig beim Hinzufügen oder Entfernen — Änderungen wirken sofort.</li>
            <li>Falsche Einträge können legitime Nachrichten blockieren oder echten Betrug übersehen.</li>
        </ul>
    </div>

    <div class="card mb-0">
        <div class="card-body">
            <p class="mb-3">Verwenden Sie <code>*</code> als Platzhalter, um zu steuern, wie ein Wort mit Chatnachrichten abgeglichen wird:</p>
            <div class="row g-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="p-3 border rounded h-100">
                        <code class="d-block mb-1 fs-5">wort</code>
                        <div class="text-body-secondary small mb-2">Genaue Übereinstimmung</div>
                        <div class="small">z.B. <code>betrug</code> — markiert nur das Wort „betrug" allein</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="p-3 border rounded h-100">
                        <code class="d-block mb-1 fs-5">wort*</code>
                        <div class="text-body-secondary small mb-2">Beginnt mit</div>
                        <div class="small">z.B. <code>zahl*</code> — markiert „zahlung", „zahlungsmittel"</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="p-3 border rounded h-100">
                        <code class="d-block mb-1 fs-5">*wort</code>
                        <div class="text-body-secondary small mb-2">Endet mit</div>
                        <div class="small">z.B. <code>*betrug</code> — markiert „bankbetrug", „überweisungsbetrug"</div>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="p-3 border rounded h-100">
                        <code class="d-block mb-1 fs-5">*wort*</code>
                        <div class="text-body-secondary small mb-2">Enthält</div>
                        <div class="small">z.B. <code>*bar*</code> — markiert „barzahlung", „sofortbar"</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card flex-grow-1 mb-0">
        <h5 class="card-header">Wörterbuch</h5>
        <div class="card-body">
            <div class="form-floating form-floating-outline">
                <input id="fraudWordsInput"
                       class="form-control"
                       name="fraudWords"
                       value="@string.Join(", ", Model)" />
                <label for="fraudWordsInput">Wörter</label>
            </div>
        </div>
    </div>

</div>
