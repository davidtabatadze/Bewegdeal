@model List<string>
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Fraud Dictionary";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/vendor/libs/tagify/tagify.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="~/vendor/libs/tagify/tagify.js"></script>
}

@section PageScripts {
    <script src="~/js/app-fraud-word.js"></script>
}

<div class="card">
    <h5 class="card-header">Fraud Dictionary</h5>
    <div class="card-body">
        <div class="form-floating form-floating-outline">
            <input id="fraudWordsInput"
                   class="form-control"
                   name="fraudWords"
                   value="@string.Join(", ", Model)" />
            <label for="fraudWordsInput">Fraud Words</label>
        </div>
    </div>
</div>
