@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Dashboard";
}
<div class="row g-6">

    <div class="col-12 col-lg-6">
        <div class="card" id="incomesCard">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Einkommen</h5>
                <div class="dropdown">
                    <button class="btn text-body-secondary p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span id="selectedIncomesYear"></span>
                        <i class="icon-base ri ri-arrow-down-s-line"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" id="incomesYearDropdown"></ul>
                </div>
            </div>
            <div class="card-body">
                <div id="incomesChart"></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card" id="dealsCard">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Verträge</h5>
                <div class="dropdown">
                    <button class="btn text-body-secondary p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span id="selectedDealsYear"></span>
                        <i class="icon-base ri ri-arrow-down-s-line"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" id="dealsYearDropdown"></ul>
                </div>
            </div>
            <div class="card-body">
                <div id="dealsChart"></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card" id="registrationCard">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Anmeldungen</h5>
                <div class="dropdown">
                    <button class="btn text-body-secondary p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span id="selectedRegistrationYear"></span>
                        <i class="icon-base ri ri-arrow-down-s-line"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" id="registrationYearDropdown"></ul>
                </div>
            </div>
            <div class="card-body">
                <div id="registrationChart"></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card" id="rstatusCard">
            <div class="card-header">
                <h5 class="mb-0">Anfragestatus</h5>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 300px;">
                    <canvas id="rstatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/notiflix/notiflix.css" asp-append-version="true" />
}

@section PageScripts {
    <script src="~/vendor/libs/apex-charts/apexcharts.js" asp-append-version="true"></script>
    <script src="~/vendor/libs/chartjs/chartjs.js" asp-append-version="true"></script>
    <script src="~/vendor/libs/notiflix/notiflix.js" asp-append-version="true"></script>
    <script src="~/js/app-admin-dashboard.js" asp-append-version="true"></script>
}