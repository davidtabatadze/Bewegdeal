@using Bewegdeal.Enums
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Dashboard";
}

<!-- Row 1: User Stats -->
<div class="row g-6 mb-6">
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="me-1">
                        <p class="text-heading mb-1">Total Clients</p>
                        <div class="d-flex align-items-center">
                            <h4 class="mb-1 me-2">@ViewBag.TotalClients</h4>
                        </div>
                        <small class="mb-0">All registered clients</small>
                    </div>
                    <div class="avatar">
                        <div class="avatar-initial bg-label-primary rounded">
                            <div class="icon-base ri ri-group-line icon-26px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="me-1">
                        <p class="text-heading mb-1">Total Companies</p>
                        <div class="d-flex align-items-center">
                            <h4 class="mb-1 me-2">@ViewBag.TotalCompanies</h4>
                        </div>
                        <small class="mb-0">Registered service providers</small>
                    </div>
                    <div class="avatar">
                        <div class="avatar-initial bg-label-info rounded">
                            <div class="icon-base ri ri-building-line icon-26px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="me-1">
                        <p class="text-heading mb-1">Pending Companies</p>
                        <div class="d-flex align-items-center">
                            <h4 class="mb-1 me-2">@ViewBag.PendingCompanies</h4>
                        </div>
                        <small class="mb-0">Companies awaiting review</small>
                    </div>
                    <div class="avatar">
                        <div class="avatar-initial bg-label-warning rounded">
                            <div class="icon-base ri ri-time-line icon-26px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="me-1">
                        <p class="text-heading mb-1">Fraud Chats</p>
                        <div class="d-flex align-items-center">
                            <h4 class="mb-1 me-2">@ViewBag.FraudChats</h4>
                        </div>
                        <small class="mb-0">Chats flagged for review</small>
                    </div>
                    <div class="avatar">
                        <div class="avatar-initial bg-label-danger rounded">
                            <div class="icon-base ri ri-spam-2-line icon-26px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Row 2: Requests by Service + Requests by Status -->
<div class="row g-6 mb-6">
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <p class="text-heading mb-1 fw-semibold">Requests by Service</p>
                <h4 class="mb-0">@ViewBag.TotalRequests</h4>
                <p class="text-muted mb-4">Across all services</p>
                <ul class="p-0 m-0 list-unstyled">
                    <li class="d-flex align-items-center mb-3">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <div class="avatar-initial bg-label-primary rounded">
                                <div class="icon-base ri ri-truck-line icon-20px"></div>
                            </div>
                        </div>
                        <span class="flex-grow-1">@AnnotationEnum.General.Service.Moving</span>
                        <span class="fw-semibold me-3">@ViewBag.MovingCount</span>
                        <div class="progress bg-label-primary mb-0" style="height: 4px; width: 80px;">
                            <div class="progress-bar bg-primary" style="width: @(ViewBag.MovingPct)%" role="progressbar"></div>
                        </div>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <div class="avatar-initial bg-label-danger rounded">
                                <div class="icon-base ri ri-delete-bin-line icon-20px"></div>
                            </div>
                        </div>
                        <span class="flex-grow-1">@AnnotationEnum.General.Service.Removal</span>
                        <span class="fw-semibold me-3">@ViewBag.RemovalCount</span>
                        <div class="progress bg-label-danger mb-0" style="height: 4px; width: 80px;">
                            <div class="progress-bar bg-danger" style="width: @(ViewBag.RemovalPct)%" role="progressbar"></div>
                        </div>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <div class="avatar-initial bg-label-warning rounded">
                                <div class="icon-base ri ri-map-pin-line icon-20px"></div>
                            </div>
                        </div>
                        <span class="flex-grow-1">@AnnotationEnum.General.Service.Pickup</span>
                        <span class="fw-semibold me-3">@ViewBag.PickupCount</span>
                        <div class="progress bg-label-warning mb-0" style="height: 4px; width: 80px;">
                            <div class="progress-bar bg-warning" style="width: @(ViewBag.PickupPct)%" role="progressbar"></div>
                        </div>
                    </li>
                    <li class="d-flex align-items-center">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <div class="avatar-initial bg-label-info rounded">
                                <div class="icon-base ri ri-car-line icon-20px"></div>
                            </div>
                        </div>
                        <span class="flex-grow-1">@AnnotationEnum.General.Service.Transport</span>
                        <span class="fw-semibold me-3">@ViewBag.TransportCount</span>
                        <div class="progress bg-label-info mb-0" style="height: 4px; width: 80px;">
                            <div class="progress-bar bg-info" style="width: @(ViewBag.TransportPct)%" role="progressbar"></div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <p class="text-heading mb-1 fw-semibold">Requests by Status</p>
                <h4 class="mb-0">@ViewBag.TotalRequests</h4>
                <p class="text-muted mb-4">Current pipeline overview</p>
                <ul class="p-0 m-0 list-unstyled">
                    <li class="d-flex align-items-center mb-3">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <div class="avatar-initial bg-label-secondary rounded">
                                <div class="icon-base ri ri-play-circle-line icon-20px"></div>
                            </div>
                        </div>
                        <span class="flex-grow-1">Pending</span>
                        <span class="fw-semibold">@ViewBag.PendingRequests</span>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <div class="avatar-initial bg-label-info rounded">
                                <div class="icon-base ri ri-chat-1-line icon-20px"></div>
                            </div>
                        </div>
                        <span class="flex-grow-1">In Negotiation</span>
                        <span class="fw-semibold">@ViewBag.NegotiationRequests</span>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <div class="avatar-initial bg-label-primary rounded">
                                <div class="icon-base ri ri-handshake-line icon-20px"></div>
                            </div>
                        </div>
                        <span class="flex-grow-1">Agreed</span>
                        <span class="fw-semibold">@ViewBag.AgreedRequests</span>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <div class="avatar-initial bg-label-success rounded">
                                <div class="icon-base ri ri-check-double-line icon-20px"></div>
                            </div>
                        </div>
                        <span class="flex-grow-1">Resolved</span>
                        <span class="fw-semibold">@ViewBag.ResolvedRequests</span>
                    </li>
                    <li class="d-flex align-items-center">
                        <div class="avatar avatar-sm flex-shrink-0 me-3">
                            <div class="avatar-initial bg-label-danger rounded">
                                <div class="icon-base ri ri-close-circle-line icon-20px"></div>
                            </div>
                        </div>
                        <span class="flex-grow-1">Cancelled</span>
                        <span class="fw-semibold">@ViewBag.CancelledRequests</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
