@using Bewegdeal.Enums
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Users";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/notiflix/notiflix.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/vendor/libs/notiflix/notiflix.js"></script>
}

@section PageScripts {
    <script src="~/js/app-user-list.js"></script>
}

<!-- Stat Cards -->
<div class="row g-6 mb-6">
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="me-1">
                        <p class="text-heading mb-1">Total Users</p>
                        <div class="d-flex align-items-center">
                            <h4 class="mb-1 me-2">@ViewBag.TotalCount</h4>
                        </div>
                        <small class="mb-0">All registered accounts</small>
                    </div>
                    <div class="avatar">
                        <div class="avatar-initial bg-label-primary rounded">
                            <div class="icon-base ri ri-group-line icon-26px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="me-1">
                        <p class="text-heading mb-1">Customers</p>
                        <div class="d-flex align-items-center">
                            <h4 class="mb-1 me-2">@ViewBag.CustomerCount</h4>
                        </div>
                        <small class="mb-0">Registered customers</small>
                    </div>
                    <div class="avatar">
                        <div class="avatar-initial bg-label-success rounded">
                            <div class="icon-base ri ri-user-line icon-26px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="me-1">
                        <p class="text-heading mb-1">Companies</p>
                        <div class="d-flex align-items-center">
                            <h4 class="mb-1 me-2">@ViewBag.CompanyCount</h4>
                        </div>
                        <small class="mb-0">Registered service providers</small>
                    </div>
                    <div class="avatar">
                        <div class="avatar-initial bg-label-info rounded">
                            <div class="icon-base ri ri-building-line icon-26px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div class="me-1">
                        <p class="text-heading mb-1">Pending Approval</p>
                        <div class="d-flex align-items-center">
                            <h4 class="mb-1 me-2">@ViewBag.PendingCount</h4>
                        </div>
                        <small class="mb-0">Companies awaiting review</small>
                    </div>
                    <div class="avatar">
                        <div class="avatar-initial bg-label-warning rounded">
                            <div class="icon-base ri ri-time-line icon-26px"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Users Table -->
<div class="card">
    <div class="card-header border-bottom">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-7">
                <div class="input-group input-group-merge">
                    <span class="input-group-text"><i class="icon-base ri ri-search-line icon-20px"></i></span>
                    <input type="text" id="usersSearch" class="form-control" placeholder="Search users..." />
                </div>
            </div>
            <div class="col-12 col-md-5">
                <div class="row g-3">
                    <div class="col-6">
                        <select id="filterRole" class="selectpicker w-100" data-style="btn-default" data-width="100%">
                            <option value="">All Roles</option>
                            <option data-divider="true"></option>
                            <option value="@UserRoleEnum.Customer">Customer</option>
                            <option value="@UserRoleEnum.Company">Company</option>
                            <option value="@UserRoleEnum.Administrator">Administrator</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <select id="filterStatus" class="selectpicker w-100" data-style="btn-default" data-width="100%">
                            <option value="">All Statuses</option>
                            <option data-divider="true"></option>
                            <option value="@UserStatusEnum.Active">Active</option>
                            <option value="@UserStatusEnum.Pending">Pending</option>
                            <option value="@UserStatusEnum.Blocked">Blocked</option>
                            <option value="@UserStatusEnum.Unverified">Unverified</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-datatable">
        <table class="datatables-users table">
            <thead>
                <tr>
                    <th class="text-center">Status</th>
                    <th>Role</th>
                    <th>User</th>
                    <th>Contact</th>
                    <th>Interests</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
