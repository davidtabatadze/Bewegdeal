@using Bewegdeal.Enums
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Users";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/notiflix/notiflix.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/vendor/libs/notiflix/notiflix.js"></script>
}

@section PageScripts {
    <script src="~/js/app-user-list.js" asp-append-version="true"></script>
}

<div class="card mb-6">
    <div class="card-widget-separator-wrapper">
        <div class="card-body card-widget-separator pt-3 pb-3">
            <div class="row gy-4 gy-sm-1">
                <div class="col-6 col-sm-6 col-lg-3">
                    <div class="d-flex justify-content-between align-items-start card-widget-1 border-end pb-4 pb-sm-0">
                        <div>
                            <h4 class="mb-0 text-primary">@ViewBag.Total</h4>
                            <p class="mb-0 fw-bold">Active total</p>
                        </div>
                        <div class="avatar me-lg-6 mt-2">
                            <span class="avatar-initial rounded bg-label-primary">
                                <i class="icon-base ri ri-group-line icon-28px"></i>
                            </span>
                        </div>
                    </div>
                    <hr class="d-none d-sm-block d-lg-none me-6" />
                </div>
                <div class="col-6 col-sm-6 col-lg-3">
                    <div class="d-flex justify-content-between align-items-start card-widget-2 border-end pb-4 pb-sm-0">
                        <div>
                            <h4 class="mb-0 text-success">@ViewBag.Customer</h4>
                            <p class="mb-0 fw-bold">Customer active</p>
                        </div>
                        <div class="avatar me-sm-6 mt-2">
                            <span class="avatar-initial rounded bg-label-success">
                                <i class="icon-base ri ri-user-2-line icon-28px"></i>
                            </span>
                        </div>
                    </div>
                    <hr class="d-none d-sm-block d-lg-none" />
                </div>
                <div class="col-6 col-sm-6 col-lg-3">
                    <div class="d-flex justify-content-between align-items-start card-widget-3 border-bottom-0 border-end pb-4 pb-sm-0">
                        <div>
                            <h4 class="mb-0 text-info">@ViewBag.Company</h4>
                            <p class="mb-0 fw-bold">Company active</p>
                        </div>
                        <div class="avatar me-sm-6 mt-2">
                            <span class="avatar-initial rounded bg-label-info">
                                <i class="icon-base ri ri-building-line icon-28px"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-sm-6 col-lg-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h4 class="mb-0 text-warning">@ViewBag.Pending</h4>
                            <p class="mb-0 fw-bold">Pending users</p>
                        </div>
                        <div class="avatar mt-2">
                            <span class="avatar-initial rounded bg-label-warning">
                                <i class="icon-base ri ri-user-forbid-line icon-28px"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Users Table -->
<div class="card">
    <div class="card-header border-bottom">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-7">
                <div class="input-group input-group-merge">
                    <span class="input-group-text"><i class="icon-base ri ri-search-line icon-20px"></i></span>
                    <input type="text" id="usersSearch" class="form-control" placeholder="Search users..." />
                </div>
            </div>
            <div class="col-12 col-md-5">
                <div class="row g-3">
                    <div class="col-6">
                        <select id="filterRole" class="selectpicker w-100" data-style="btn-default" data-width="100%">
                            <option value="">All Roles</option>
                            <option data-divider="true"></option>
                            <option data-icon="icon-base ri ri-user-2-line icon-sm text-success" value="@UserRoleEnum.Customer">Customer</option>
                            <option data-icon="icon-base ri ri-building-line icon-sm text-info" value="@UserRoleEnum.Company">Company</option>
                            <option data-icon="icon-base ri ri-computer-line icon-sm text-danger" value="@UserRoleEnum.Administrator">Administrator</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <select id="filterStatus" class="selectpicker w-100" data-style="btn-default" data-width="100%">
                            <option value="">All Statuses</option>
                            <option data-divider="true"></option>
                            <option data-icon="icon-base ri ri-user-follow-line icon-sm text-success" value="@UserStatusEnum.Active">Active</option>
                            <option data-icon="icon-base ri ri-user-forbid-line icon-sm text-warning" value="@UserStatusEnum.Pending">Pending</option>
                            <option data-icon="icon-base ri ri-admin-line icon-sm text-danger" value="@UserStatusEnum.Blocked">Blocked</option>
                            <option data-icon="icon-base ri ri-user-settings-line icon-sm text-secondary" value="@UserStatusEnum.Unverified">Unverified</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-datatable">
        <table class="datatables-users table">
            <thead>
                <tr>
                    <th class="text-center">Status</th>
                    <th>Role</th>
                    <th>User</th>
                    <th>Contact</th>
                    <th>Date</th>
                    <th>Interests</th>
                    <th class="text-primary">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
