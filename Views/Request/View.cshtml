<div class="row g-5">
    <div class="col-12 col-md-8">
        <div class="card h-100 bg-transparent border-0">
            <div id="swiper-gallery">
                <div class="swiper gallery-top" style="@(allMedia.Count == 1 ? "block-size:100%;" : "")">
                    <div class="swiper-wrapper">
                        @foreach (var f in allMedia)
                        {
                            if (f.Type == RequestFileTypeEnum.Image)
                            {
                                <div class="swiper-slide" style="position:relative; overflow:hidden;">
                                    <div style="position:absolute; inset:0; background-image:url('@f.Url'); background-size:cover; background-position:center; filter:blur(18px); transform:scale(1.1); opacity:0.75;"></div>
                                    <img src="@f.Url" alt="@f.Name" style="position:absolute; inset:0; width:100%; height:100%; object-fit:contain;" />
                                </div>
                            }
                            else
                            {
                                <div class="swiper-slide d-flex align-items-center justify-content-center" style="background:#000;">
                                    <video controls style="max-height:100%; max-width:100%; object-fit:contain;">
                                        <source src="@f.Url" />
                                    </video>
                                </div>
                            }
                        }
                    </div>
                    <div class="swiper-button-next swiper-button-white"></div>
                    <div class="swiper-button-prev swiper-button-white"></div>
                </div>

                @if (allMedia.Count > 1)
                {
                    <div class="swiper gallery-thumbs">
                        <div class="swiper-wrapper">
                            @foreach (var f in allMedia)
                            {
                                if (f.Type == RequestFileTypeEnum.Image)
                                {
                                    <div class="swiper-slide" style="background-image:url(@f.Url)"></div>
                                }
                                else
                                {
                                    <div class="swiper-slide d-flex align-items-center justify-content-center" style="background:#111;">
                                        <i class="icon-base ri ri-play-circle-line text-white" style="font-size:1.75rem;"></i>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center justify-content-between gap-2 flex-wrap p-3">
                <div class="card-title m-0">
                    <h5 class="m-0 me-2">Details</h5>
                </div>
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Actions</button>
                    <ul class="dropdown-menu">
                        <li>
                            <a href="/Request/Edit?id=@req.Id" class="dropdown-item d-flex align-items-center text-primary ps-2 pe-2">
                                <i class="icon-base ri ri-exchange-line scaleX-n1-rtl text-warning me-1"></i>Edit Request
                            </a>
                        </li>
                        <li>
                            <a href="javascript:void(0);" class="dropdown-item d-flex align-items-center text-primary ps-2 pe-2">
                                <i class="icon-base ri ri-hand scaleX-n1-rtl text-danger me-1"></i>Cancel Request
                            </a>
                        </li>
                        <li>
                            <a href="javascript:void(0);" class="dropdown-item d-flex align-items-center text-primary ps-2 pe-2">
                                <i class="icon-base ri ri-check-double-line scaleX-n1-rtl text-success me-1"></i>Resolve Request
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="card-body p-5 pt-0">
                <hr class="m-0" />
                <ul class="list-group list-group-horizontal-md mt-2 mb-2">
                    <li class="list-group-item flex-fill border-0 p-0">
                        <h6 class="d-flex align-items-center gap-2 mb-0 text-secondary"><i class="icon-base ri ri-hand-coin-line icon-28px text-warning"></i>Terms</h6>
                        <address class="text-dark mb-0">
                            <dl class="row mb-0">
                                @if (req.ASAP)
                                {
                                    <dt class="col-8 fw-semibold">As soon as possible</dt>
                                }
                                else
                                {
                                    <dt class="col-8 fw-normal">
                                        <i class="icon-base ri ri-calendar-line icon-18px"></i>
                                        <span class="fw-semibold">@req.Date?.ToString("dd MMM yyyy")</span>
                                        <i class="icon-base ri ri-time-line icon-18px"></i>
                                        <span class="fw-semibold">@req.Time?.ToString("HH:mm")</span>
                                    </dt>
                                }
                                <dd class="col-4 text-end h4 mt-n4 m-0">€<strong>@req.Cost.ToString("0.##")</strong></dd>
                            </dl>
                        </address>
                    </li>
                </ul>
                <hr class="m-0" />
                <ul class="list-group list-group-horizontal-md mt-2 mb-2">
                    <li class="list-group-item flex-fill border-0 p-0">
                        <h6 class="d-flex align-items-center gap-2 mb-0 text-secondary"><i class="icon-base ri ri-map-pin-time-line icon-28px text-info"></i>Pickup address</h6>
                        <address class="text-dark mb-0">@(string.IsNullOrWhiteSpace(req.PickupZipCode) ? "" : "[" + req.PickupZipCode + "] ")@req.PickupAddress</address>
                    </li>
                </ul>
                <hr class="m-0" />
                <ul class="list-group list-group-horizontal-md mt-2 mb-2">
                    <li class="list-group-item flex-fill border-0 p-0">
                        <h6 class="d-flex align-items-center gap-2 mb-0 text-secondary"><i class="icon-base ri ri-map-pin-line icon-28px text-info"></i>Delivery address</h6>
                        <address class="text-dark mb-0">@(string.IsNullOrWhiteSpace(req.DeliveryZipCode) ? "" : "[" + req.DeliveryZipCode + "] ")@(string.IsNullOrWhiteSpace(req.DeliveryAddress) ? "N/A" : req.DeliveryAddress)</address>
                    </li>
                </ul>
                <hr class="m-0" />
                <ul class="list-group list-group-horizontal-md mt-2 mb-2">
                    <li class="list-group-item flex-fill border-0 p-0">
                        <h6 class="d-flex align-items-center gap-2 mb-0 text-secondary"><i class="icon-base ri ri-pencil-ruler-2-line icon-28px text-secondary"></i>Other details</h6>
                        <address class="text-dark mb-0">
                            @if (req.Service == ServiceEnum.Transport)
                            {
                                <dl class="row mb-0">
                                    <dt class="col-6 fw-normal">Vehicle type</dt>
                                    <dd class="col-6 text-end mb-0"><strong>@req.VehicleType</strong></dd>
                                </dl>
                                <dl class="row mb-0">
                                    <dt class="col-6 fw-normal">Vehicle condition</dt>
                                    <dd class="col-6 text-end mb-0"><strong>@req.VehicleCondition</strong></dd>
                                </dl>
                            }
                            else
                            {
                                <dl class="row mb-0">
                                    <dt class="col-10 fw-normal">There is an elevator</dt>
                                    <dd class="col-2 text-end mb-0">
                                        <i class="icon-base ri ri-@(req.PresentElevator ? "check-line" : "close-line") icon-md text-@(req.PresentElevator ? "success" : "danger")"></i>
                                    </dd>
                                </dl>
                                <dl class="row mb-0">
                                    <dt class="col-10 fw-normal">There is a parking</dt>
                                    <dd class="col-2 text-end mb-0">
                                        <i class="icon-base ri ri-@(req.PresentParking ? "check-line" : "close-line") icon-md text-@(req.PresentParking ? "success" : "danger")"></i>
                                    </dd>
                                </dl>
                            }
                        </address>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(req.Description))
{
    <div class="row g-5 mt-1">
        <div class="col-lg-12">
            <div class="card bg-label-info h-100">
                <div class="card-body d-flex flex-wrap-reverse">
                    <div class="mb-0 w-100">
                        <div class="card-title">
                            <h5 class="text-info mb-2"><i class="icon-base ri ri-information-line me-2"></i>Description</h5>
                            <p class="text-heading" style="white-space: pre-wrap;">@req.Description</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@await Html.PartialAsync("~/Views/Proposal/_ProposalModal.cshtml")
@await Html.PartialAsync("~/Views/Proposal/_ProposalReactModal.cshtml")

<!-- Floating chat tab — hidden until chat.js confirms mode != 'none' -->
<div id="chatFloatingBtn" style="position:fixed;right:1.5rem;bottom:3rem;z-index:1040;display:none;">
    <a href="#requestChatOffcanvas" data-bs-toggle="offcanvas"
       class="text-bg-primary d-flex flex-row align-items-center justify-content-center gap-2 text-decoration-none"
       style="padding:0.5rem 1.6rem;border-radius:0.375rem;box-shadow:0 1px 20px 8px rgba(var(--bs-primary-rgb),0.45);">
        <i class="icon-base ri ri-wechat-line"></i>
        <span style="font-size:0.72rem;font-weight:600;letter-spacing:0.04em;line-height:1;">Chat</span>
    </a>
</div>

<!-- Chat offcanvas — body populated by chat.js after context fetch -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="requestChatOffcanvas" aria-labelledby="requestChatOffcanvasLabel" style="--bs-offcanvas-width:450px;--bs-offcanvas-bg:#f7f6fa;">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title d-flex align-items-center text-primary gap-2" id="requestChatOffcanvasLabel">
            <i class="icon-base ri ri-wechat-line icon-22px"></i> Chat
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <div id="chatCard" class="app-chat card overflow-hidden h-100 m-0 rounded-0 border-0 shadow-none">
            <div class="row g-0 h-100" id="chatOffcanvasBody">
            </div>
        </div>
    </div>
</div>