@using Bewegdeal.Data.Entities
@using Bewegdeal.Enums
@{
    Layout = "_HomeLayout";
    var req = (RequestEntity)ViewBag.Request;
    var files = ((IEnumerable<dynamic>)ViewBag.Files).ToList();
    var allMedia = files;

    ViewData["Title"] = req.Title;

    string TimeAgo(DateTime date)
    {
        var diff = DateTime.UtcNow - date;
        if (diff.TotalSeconds < 60) { return "just now"; }
        if (diff.TotalMinutes < 60) { var m = (int)diff.TotalMinutes; return $"{m} minute{(m == 1 ? "" : "s")} ago"; }
        if (diff.TotalHours < 24) { var h = (int)diff.TotalHours; return $"{h} hour{(h == 1 ? "" : "s")} ago"; }
        if (diff.TotalDays < 30) { var d = (int)diff.TotalDays; return $"{d} day{(d == 1 ? "" : "s")} ago"; }
        if (diff.TotalDays < 365) { var mo = (int)(diff.TotalDays / 30); return $"{mo} month{(mo == 1 ? "" : "s")} ago"; }
        var yr = (int)(diff.TotalDays / 365); return $"{yr} year{(yr == 1 ? "" : "s")} ago";
    }

    var (badge, icon, color, label) = req.Service switch
    {
        ServiceEnum.Moving => ("bg-label-success", "ri-truck-line", "success", AnnotationEnum.General.Service.Moving),
        ServiceEnum.Removal => ("bg-label-danger", "ri-recycle-line", "danger", AnnotationEnum.General.Service.Removal),
        ServiceEnum.Pickup => ("bg-label-warning", "ri-shopping-bag-4-line", "warning", AnnotationEnum.General.Service.Pickup),
        ServiceEnum.Transport => ("bg-label-info", "ri-car-line", "info", AnnotationEnum.General.Service.Transport),
        _ => ("bg-label-secondary", "ri-question-line", "info", req.Service)
    };

    var (statusStyle, statusIcon) = req.Status switch
    {
        RequestStatusEnum.Pending => ("warning", "timer-flash-line"),
        RequestStatusEnum.Cancelled => ("danger", "hand"),
        RequestStatusEnum.Negotiation => ("info", "wechat-line"),
        RequestStatusEnum.Agreed => ("success", "shake-hands-line"),
        RequestStatusEnum.Resolved => ("success", "check-double-line"),
        RequestStatusEnum.Declined => ("dark", "rest-time-line"),
        _ => ("", "")
    };
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/swiper/swiper.css" />
    <link rel="stylesheet" href="~/vendor/css/pages/ui-carousel.css" />
    <link rel="stylesheet" href="~/vendor/css/pages/app-chat.css" />
    <link rel="stylesheet" href="~/vendor/libs/notiflix/notiflix.css" />
}

@section PageScripts {
    <script>
        const mediaCount = @allMedia.Count;
    </script>
    <script src="~/vendor/libs/swiper/swiper.js"></script>
    <script src="~/vendor/libs/notiflix/notiflix.js"></script>
    <script src="~/js/request-view.js"></script>
    <script>
        window.chatConfig = { requestNumber: '@req.Number' };
        window.ChatMode = { None: '@ChatModeEnum.None', Initiate: '@ChatModeEnum.Initiate', Active: '@ChatModeEnum.Active' };
    </script>
    <script src="~/vendor/libs/signalr/signalr.min.js"></script>
    <script src="~/js/chat.js"></script>
}

<div class="card bg-transparent shadow-none border-0 mb-6">
    <div class="card-body row g-6 p-0 pb-4">
        <div class="col-12 col-md-8 card-separator">
            <h5 class="mb-2 text-center">
                <small>
                    <span class="badge rounded-pill bg-label-@statusStyle">
                        <i class="icon-base ri ri-@statusIcon text-@statusStyle"></i>@req.Status.ToUpper()
                    </span>
                </small>
                <span class="h4 fw-semibold"> @req.Title</span>
            </h5>
            <div class="d-flex justify-content-between flex-wrap gap-4 me-0">
                <div class="d-flex align-items-center gap-1">
                    <button type="button" class="btn btn-text-secondary" onclick="window.location.href='/Request/List'">
                        <span class="icon-base ri ri-arrow-left-s-line me-1_5"></span>
                        Back to requests
                    </button>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button type="button" class="btn btn-text-secondary">
                        #@req.Id
                        <span class="icon-base ri ri-eye-fill ms-4"></span>
                        100
                        <span class="ri ri-circle-fill ms-2 me-2" style="font-size: 3px;"></span>
                        @TimeAgo(req.CreateDate)
                    </button>
                </div>
            </div>
            <hr class="m-0" />
            <div class="d-flex justify-content-between flex-wrap gap-4 me-0 mt-4">
                <div class="d-flex align-items-center gap-1">
                    <span class="badge rounded-pill @badge fun-facts-icon p-2">
                        <i class="icon-base ri @icon icon-42px"></i>
                    </span>
                    <div class="content-right">
                        <span class="text-@color mb-0 h5">@label</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <div class="content-right">
                        <span class="text-dark mb-0 h5">@ViewBag.RequesterName</span>
                    </div>
                    <div class="avatar avatar-md">
                        @if (ViewBag.RequesterPictureUrl is not null)
                        {
                            <img src="@ViewBag.RequesterPictureUrl" alt="@ViewBag.RequesterName" class="rounded-circle" style="object-fit:cover;width:100%;height:100%;" />
                        }
                        else
                        {
                            <span class="avatar-initial rounded-circle bg-label-primary w-100 h-100"
                                  style="display:flex;align-items:center;justify-content:center;">@ViewBag.RequesterInitials</span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="d-flex">
                Dial part coming soon
                @* <ul class="list-group list-group-horizontal-md mt-1 mb-3 border border-warning">
                    <li class="list-group-item flex-fill p-3">
                        <h6 class="d-flex align-items-center gap-2 mb-3"><i class="icon-base ri ri-hand-coin-line icon-28px text-warning"></i>Proposition</h6>
                        <address class="text-body mb-0">
                            <dl class="row mb-0">
                                <dt class="col-8 fw-normal text-heading">@(req.ASAP ? "As soon as possible" : req.Date?.ToString("MMMM d, yyyy") + (req.Time.HasValue ? " at " + req.Time.Value.ToString("HH:mm") : ""))</dt>
                                <dd class="col-4 text-end"><strong>@req.Currency</strong> @req.Cost.ToString("0.##")</dd>
                            </dl>
                        </address>
                    </li>
                </ul> *@
            </div>
        </div>
    </div>
</div>
<div class="row g-5">
    <div class="col-12 col-md-8">
        <div class="card h-100 bg-transparent shadow-none border-0">
            <div id="swiper-gallery">
                <div class="swiper gallery-top" style="@(allMedia.Count == 1 ? "block-size:100%;" : "")">
                    <div class="swiper-wrapper">
                        @foreach (var f in allMedia)
                        {
                            if (f.type == RequestFileTypeEnum.Image)
                            {
                                <div class="swiper-slide" style="position:relative; overflow:hidden;">
                                    <div style="position:absolute; inset:0; background-image:url('@f.url'); background-size:cover; background-position:center; filter:blur(18px); transform:scale(1.1); opacity:0.75;"></div>
                                    <img src="@f.url" alt="@f.fileName" style="position:absolute; inset:0; width:100%; height:100%; object-fit:contain;" />
                                </div>
                            }
                            else
                            {
                                <div class="swiper-slide d-flex align-items-center justify-content-center" style="background:#000;">
                                    <video controls style="max-height:100%; max-width:100%; object-fit:contain;">
                                        <source src="@f.url" />
                                    </video>
                                </div>
                            }
                        }
                    </div>
                    <div class="swiper-button-next swiper-button-white"></div>
                    <div class="swiper-button-prev swiper-button-white"></div>
                </div>

                @if (allMedia.Count > 1)
                {
                    <div class="swiper gallery-thumbs">
                        <div class="swiper-wrapper">
                            @foreach (var f in allMedia)
                            {
                                if (f.type == RequestFileTypeEnum.Image)
                                {
                                    <div class="swiper-slide" style="background-image:url(@f.url)"></div>
                                }
                                else
                                {
                                    <div class="swiper-slide d-flex align-items-center justify-content-center" style="background:#111;">
                                        <i class="icon-base ri ri-play-circle-line text-white" style="font-size:1.75rem;"></i>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card h-100">
            <div class="card-header d-flex">
                @* m-0 p-3 *@
                <div class="card-title m-0">
                    <h5 class="m-0 me-2">Details</h5>
                </div>
            </div>
            <div class="card-body p-5 pt-0">
                <ul class="list-group list-group-horizontal-md mt-1 mb-3 border border-warning">
                    <li class="list-group-item flex-fill p-3">
                        <h6 class="d-flex align-items-center gap-2 mb-3"><i class="icon-base ri ri-hand-coin-line icon-28px text-warning"></i>Proposition</h6>
                        <address class="text-body mb-0">
                            <dl class="row mb-0">
                                <dt class="col-8 fw-normal text-heading">@(req.ASAP ? "As soon as possible" : req.Date?.ToString("MMMM d, yyyy") + (req.Time.HasValue ? " at " + req.Time.Value.ToString("HH:mm") : ""))</dt>
                                <dd class="col-4 text-end"><strong>@req.Currency</strong> @req.Cost.ToString("0.##")</dd>
                            </dl>
                        </address>
                    </li>
                </ul>
                <ul class="list-group list-group-horizontal-md mt-1 mb-3 border border-info">
                    <li class="list-group-item flex-fill p-3">
                        <h6 class="d-flex align-items-center gap-2 mb-3"><i class="icon-base ri ri-map-pin-time-line icon-28px text-info"></i>Pickup address</h6>
                        <address class="text-body mb-0">@req.PickupAddress</address>
                    </li>
                </ul>
                <ul class="list-group list-group-horizontal-md mt-1 mb-0 border border-info">
                    <li class="list-group-item flex-fill p-3">
                        <h6 class="d-flex align-items-center gap-2 mb-3"><i class="icon-base ri ri-map-pin-line icon-28px text-info"></i>Delivery address</h6>
                        <address class="text-body mb-0">@(string.IsNullOrWhiteSpace(req.DeliveryAddress) ? "N/A" : req.DeliveryAddress)</address>
                    </li>
                </ul>
                @* <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="d-flex align-items-center">
                        <div class="avatar avatar me-4">
                            <img src="~/img/avatars/1.png" alt="Avatar" class="rounded-circle" />
                        </div>
                        <div>
                            <div>
                                <h6 class="mb-1 text-truncate">Maven Analytics</h6>
                                <p class="mb-0 text-truncate">Business Intelligence</p>
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <h6 class="mb-0">33</h6>
                    </div>
                </div> *@
            </div>
        </div>
    </div>
</div>
@if (!string.IsNullOrWhiteSpace(req.Description))
{
    <div class="row g-5">
        <div class="col-lg-12">
            <div class="card h-100 bg-transparent shadow-none border-0">
                <div class="alert alert-outline-danger mt-4" role="alert">
                    <h6 class="alert-heading d-flex align-items-center mb-2">
                        <i class="icon-base ri ri-information-line me-2"></i>Description
                    </h6>
                    <p class="mb-0" style="white-space: pre-wrap;">@req.Description</p>
                </div>
            </div>
        </div>
    </div>
}

<!-- Floating chat tab — hidden until chat.js confirms mode != 'none' -->
<div id="chatFloatingBtn" style="position:fixed;right:1.5rem;bottom:3rem;z-index:1040;display:none;">
    <a href="#requestChatOffcanvas" data-bs-toggle="offcanvas"
       class="text-bg-primary d-flex flex-row align-items-center justify-content-center gap-2 text-decoration-none"
       style="padding:0.5rem 1.6rem;border-radius:0.375rem;box-shadow:0 1px 20px 8px rgba(140,87,255,0.85);">
        <i class="icon-base ri ri-wechat-line"></i>
        <span style="font-size:0.72rem;font-weight:600;letter-spacing:0.04em;line-height:1;">Chat</span>
    </a>
</div>

<!-- Chat offcanvas — body populated by chat.js after context fetch -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="requestChatOffcanvas" aria-labelledby="requestChatOffcanvasLabel" style="--bs-offcanvas-width:450px;">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title d-flex align-items-center text-primary gap-2" id="requestChatOffcanvasLabel">
            <i class="icon-base ri ri-wechat-line icon-22px"></i> Chat
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-0">
        <div id="chatCard" class="app-chat card overflow-hidden h-100 m-0 rounded-0 border-0 shadow-none">
            <div class="row g-0 h-100" id="chatOffcanvasBody">
            </div>
        </div>
    </div>
</div>