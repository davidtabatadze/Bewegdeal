@using Bewegdeal.Enums
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Requests";

    var viewerRole = ViewBag.ViewerRole as string ?? "";
    var viewerInterests = (ViewBag.ViewerInterests as string[]) ?? [];

    var allServices = new[]
    {
        (ServiceEnum.Moving,    AnnotationEnum.General.Service.Moving),
        (ServiceEnum.Removal,   AnnotationEnum.General.Service.Removal),
        (ServiceEnum.Pickup,    AnnotationEnum.General.Service.Pickup),
        (ServiceEnum.Transport, AnnotationEnum.General.Service.Transport),
    };

    var serviceOptions = viewerRole == UserRoleEnum.Company
        ? allServices.Where(s => viewerInterests.Contains(s.Item1)).ToArray()
        : allServices;
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/notiflix/notiflix.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/vendor/libs/notiflix/notiflix.js"></script>
}

@section PageScripts {
    <script src="~/js/app-request-list.js" asp-append-version="true"></script>
}

@if (viewerRole != UserRoleEnum.Customer)
{
    <div class="card mb-6">
        <div class="card-widget-separator-wrapper">
            <div class="card-body card-widget-separator pt-3 pb-3">
                <div class="row gy-4 gy-sm-1">
                    <div class="col-6 col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start card-widget-1 border-end pb-4 pb-sm-0">
                            <div>
                                <h4 class="mb-0 text-primary">@ViewBag.Total</h4>
                                <p class="mb-0 fw-bold">Requests</p>
                            </div>
                            <div class="avatar me-lg-6 mt-2">
                                <span class="avatar-initial rounded bg-label-primary">
                                    <i class="icon-base ri ri-file-list-3-line icon-28px"></i>
                                </span>
                            </div>
                        </div>
                        <hr class="d-none d-sm-block d-lg-none me-6" />
                    </div>
                    <div class="col-6 col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start card-widget-2 border-end pb-4 pb-sm-0">
                            <div>
                                <h4 class="mb-0 text-warning">@ViewBag.Pending</h4>
                                @if (User.IsInRole(UserRoleEnum.Administrator))
                                {
                                    <p class="mb-0 fw-bold">Pending</p>
                                }
                                else
                                {
                                    <p class="mb-0 fw-bold">Potential</p>
                                }
                            </div>
                            <div class="avatar me-sm-6 mt-2">
                                <span class="avatar-initial rounded bg-label-warning">
                                    <i class="icon-base ri @(User.IsInRole(UserRoleEnum.Administrator) ? "ri-timer-flash-line" : "ri-lightbulb-line") icon-28px"></i>
                                </span>
                            </div>
                        </div>
                        <hr class="d-none d-sm-block d-lg-none" />
                    </div>
                    <div class="col-6 col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start card-widget-3 border-bottom-0 border-end pb-4 pb-sm-0">
                            <div>
                                <h4 class="mb-0 text-success">@ViewBag.Agreed</h4>
                                <p class="mb-0 fw-bold">Agreed</p>
                            </div>
                            <div class="avatar me-sm-6 mt-2">
                                <span class="avatar-initial rounded bg-label-success">
                                    <i class="icon-base ri ri-shake-hands-line icon-28px"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h4 class="mb-0 text-success">@ViewBag.Resolved</h4>
                                <p class="mb-0 fw-bold">Resolved</p>
                            </div>
                            <div class="avatar mt-2">
                                <span class="avatar-initial rounded bg-label-success">
                                    <i class="icon-base ri ri-check-double-line icon-28px"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (viewerRole == UserRoleEnum.Customer && !(bool)ViewBag.CustomerHasRequests)
{
    <!-- Empty state for customers with no requests -->
    <div class="row flex-grow-1 h-100">
        <div class="col-12 d-flex flex-column">
            <div class="card flex-grow-1">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <img src="~/img/backgrounds/void.png" alt="" style="width: 450px; opacity: 0.85;" class="mb-6" />
                    <h5 class="mb-2">You don't have any requests yet</h5>
                    <p class="text-muted mb-6">Let's fix that — create your first request and get things moving.</p>
                    <a asp-controller="Request" asp-action="Create" class="btn btn-primary">
                        <i class="icon-base ri ri-add-circle-line me-1_5"></i> New Request
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{

    <!-- Requests Table -->
    <div class="card">
        <div class="card-header border-bottom">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-6">
                    @if (viewerRole == UserRoleEnum.Company)
                    {
                        <div class="row g-3">
                            <div class="col-8">
                                <div class="input-group input-group-merge">
                                    <span class="input-group-text"><i class="icon-base ri ri-search-line icon-20px"></i></span>
                                    <input type="text" id="requestsSearch" class="form-control" placeholder="Search requests..." />
                                </div>
                            </div>
                            <div class="col-4">
                                <select id="filterRequest" class="selectpicker w-100" data-style="btn-default" data-width="100%">
                                    <option value="">All Requests</option>
                                    <option data-divider="true"></option>
                                    <option data-icon="icon-base ri ri-lightbulb-line icon-sm text-warning" value="@RequestViewerFocusEnum.Potential">Potential</option>
                                    <option data-icon="icon-base ri ri-medal-2-line icon-sm text-success" value="@RequestViewerFocusEnum.Mine">Only Mine</option>
                                </select>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="input-group input-group-merge">
                            <span class="input-group-text"><i class="icon-base ri ri-search-line icon-20px"></i></span>
                            <input type="text" id="requestsSearch" class="form-control" placeholder="Search requests..." />
                        </div>
                    }
                </div>
                <div class="col-12 col-md-6">
                    <div class="row g-3">
                        <div class="col-6">
                            <select id="filterStatus" class="selectpicker w-100" data-style="btn-default" data-width="100%">
                                <option value="">All Statuses</option>
                                <option data-divider="true"></option>
                                <option data-icon="icon-base ri ri-timer-flash-line icon-sm text-warning" value="@RequestStatusEnum.Pending">Pending</option>
                                <option data-icon="icon-base ri ri-wechat-line icon-sm text-info" value="@RequestStatusEnum.Negotiation">Negotiation</option>
                                <option data-icon="icon-base ri ri-shake-hands-line icon-sm text-success" value="@RequestStatusEnum.Agreed">Agreed</option>
                                <option data-icon="icon-base ri ri-check-double-line icon-sm text-success" value="@RequestStatusEnum.Resolved">Resolved</option>
                                <option data-icon="icon-base ri ri-hand icon-sm text-danger" value="@RequestStatusEnum.Cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <select id="filterService" class="selectpicker w-100" data-style="btn-default" data-width="100%">
                                <option value="">All Services</option>
                                <option data-divider="true"></option>
                                @foreach (var (value, label) in serviceOptions)
                                {
                                    var icon = value == "moving" ? "ri-truck-line" :
                                               value == "removal" ? "ri-recycle-line" :
                                               value == "pickup" ? "ri-shopping-bag-4-line" :
                                               value == "transport" ? "ri-car-line" : "";
                                    var color = value == "moving" ? "success" :
                                                value == "removal" ? "danger" :
                                                value == "pickup" ? "warning" :
                                                value == "transport" ? "info" : "";
                                    <option data-icon="icon-base ri @icon icon-sm text-@color" value="@value">@label</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-datatable">
            <table class="datatables-requests table">
                <thead>
                    <tr>
                        @* <th>Number</th> *@
                        <th>Request</th>
                        <th>Status</th>
                        <th>Job</th>
                        <th>Date</th>
                        <th>Details</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>

}
@* end else — customer has requests *@
