@using Bewegdeal.Enums
@using Bewegdeal.Models
@{
    Layout = "_HomeLayout";
    var vm = (RequestModel)ViewBag.Request;
    var settings = vm.Settings!;
    var req = vm.Data;
    var isEdit = req is not null;
    ViewData["Title"] = isEdit ? "Anfrage bearbeiten" : "Neue Anfrage";
    var existingFilesList = isEdit ? vm.Files : [];
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/dropzone/dropzone.css" />
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/vendor/libs/jquery-timepicker/jquery-timepicker.css" />
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
    <link rel="stylesheet" href="~/vendor/libs/notyf/notyf.css" />
    <link rel="stylesheet" href="~/vendor/libs/notiflix/notiflix.css" />
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/vendor/libs/spinkit/spinkit.css" />
    @if (isEdit && req!.Status == RequestStatusEnum.Agreed)
    {
        <link rel="stylesheet" href="~/vendor/libs/raty-js/raty-js.css" />
    }
}

@section VendorScripts {
    <script src="~/vendor/libs/dropzone/dropzone.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
    <script src="~/vendor/libs/jquery-timepicker/jquery-timepicker.js"></script>
    <script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/vendor/libs/notyf/notyf.js"></script>
    <script src="~/vendor/libs/notiflix/notiflix.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
    @if (isEdit && req!.Status == RequestStatusEnum.Agreed)
    {
        <script src="~/vendor/libs/raty-js/raty-js.js"></script>
    }
}

@section PageScripts {
    <script>
        const imageMaxCount   = @settings.RequestImageMaxCount;
        const imageMaxSize    = @settings.RequestImageMaxSize;
        const videoMaxCount   = @settings.RequestVideoMaxCount;
        const videoMaxSize    = @settings.RequestVideoMaxSize;
        const isEditMode      = @(isEdit ? "true" : "false");
        const requestNumber   = '@(isEdit ? req!.Number : "")';
        @if (isEdit)
        {
            <text>const existingFiles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                            existingFilesList.Select(f => new
                                                                            {
                                                                                fileId = f.Id,
                                                                                fileName = f.Name,
                                                                                size = f.Size,
                                                                                type = f.Type,
                                                                                isMain = f.IsMain,
                                                                                url = f.Url
                                                                            })
                                                                        ));</text>
            }
        </script>
        <script src="~/js/app-request-form.js" asp-append-version="true"></script>
    }

    <div class="row">
        <div class="col-12">
            <div class="card">

                <div class="card-body pt-5">
                    <form id="requestForm" asp-controller="Request" asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                        @if (isEdit)
                        {
                            <input type="hidden" name="Id" value="@req!.Id" />
                        }
                        <div class="row">
                            <div class="col-lg-8 mx-auto">

                                <!-- 1. Service Type -->
                                <h5 class="mb-4">1. Dienstleistungsart</h5>
                                <div class="row gy-3">
                                    <div class="col-6 col-lg-3 col-md-6 col-sm-6">
                                        <div class="form-check custom-option custom-option-icon">
                                            <label class="form-check-label custom-option-content" for="serviceMoving">
                                                <span class="custom-option-body">
                                                    <i class="icon-base ri ri-truck-line text-success"></i>
                                                    <span class="custom-option-title mb-1">@AnnotationEnum.General.Service.Moving</span>
                                                    @* <small>Household or office relocation</small> *@
                                                </span>
                                                <input name="service" class="form-check-input" type="radio" value="@ServiceEnum.Moving" id="serviceMoving" checked="@(isEdit && req!.Service == ServiceEnum.Moving ? "checked" : null)" />
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-lg-3 col-md-6 col-sm-6">
                                        <div class="form-check custom-option custom-option-icon">
                                            <label class="form-check-label custom-option-content" for="serviceRemoval">
                                                <span class="custom-option-body">
                                                    <i class="icon-base ri ri-recycle-line text-danger"></i>
                                                    <span class="custom-option-title mb-1">@AnnotationEnum.General.Service.Removal</span>
                                                    @* <small>Junk and waste removal</small> *@
                                                </span>
                                                <input name="service" class="form-check-input" type="radio" value="@ServiceEnum.Removal" id="serviceRemoval" checked="@(isEdit && req!.Service == ServiceEnum.Removal ? "checked" : null)" />
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-lg-3 col-md-6 col-sm-6">
                                        <div class="form-check custom-option custom-option-icon">
                                            <label class="form-check-label custom-option-content" for="servicePickup">
                                                <span class="custom-option-body">
                                                    <i class="icon-base ri ri-shopping-bag-4-line text-warning"></i>
                                                    <span class="custom-option-title mb-1">@AnnotationEnum.General.Service.Pickup</span>
                                                    @* <small>Store or warehouse pickup</small> *@
                                                </span>
                                                <input name="service" class="form-check-input" type="radio" value="@ServiceEnum.Pickup" id="servicePickup" checked="@(isEdit && req!.Service == ServiceEnum.Pickup ? "checked" : null)" />
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-6 col-lg-3 col-md-6 col-sm-6">
                                        <div class="form-check custom-option custom-option-icon">
                                            <label class="form-check-label custom-option-content" for="serviceTransport">
                                                <span class="custom-option-body">
                                                    <i class="icon-base ri ri-car-line text-info"></i>
                                                    <span class="custom-option-title mb-1">@AnnotationEnum.General.Service.Transport</span>
                                                    @* <small>Vehicle or cargo transport</small> *@
                                                </span>
                                                <input name="service" class="form-check-input" type="radio" value="@ServiceEnum.Transport" id="serviceTransport" checked="@(isEdit && req!.Service == ServiceEnum.Transport ? "checked" : null)" />
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div id="serviceError" class="text-danger small d-none mt-2">Bitte wählen Sie eine Dienstleistungsart aus.</div>

                                <hr class="my-6" />

                                <!-- 2. General Information -->
                                <h5 class="mb-4">2. Allgemeine Informationen</h5>
                                <div class="row g-6">
                                    <div class="col-12">
                                        <div class="form-floating form-floating-outline">
                                            <input type="text" id="title" name="title" class="form-control" placeholder="" maxlength="128" value="@(isEdit ? req!.Title : "")" />
                                            <label for="title">Titel</label>
                                            <div class="invalid-feedback">Titel ist erforderlich.</div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-floating form-floating-outline">
                                            <textarea id="description" name="description" class="form-control" placeholder="" style="height: 100px;" maxlength="2048">@(isEdit ? req!.Description : "")</textarea>
                                            <label for="description">Beschreibung <span class="text-muted">(optional)</span></label>
                                        </div>
                                    </div>
                                </div>

                                <hr class="my-6" />

                                <!-- 3. Media -->
                                <h5 class="mb-2">3. Medien</h5>

                                <p class="text-muted mb-3 small">
                                    <strong>Bilder</strong> (png, jpeg): bis zu @settings.RequestImageMaxCount Dateien, max. @settings.RequestImageMaxSize MB pro Datei. Mindestens ein Bild erforderlich. Sie können ein Hauptbild festlegen.<br />
                                    <strong>Videos</strong> (mp4, mov): bis zu @settings.RequestVideoMaxCount Dateien, max. @settings.RequestVideoMaxSize MB pro Datei. Optional.
                                </p>
                                <div id="dropzone-media" class="dropzone needsclick">
                                    <div class="dz-message needsclick">
                                        Bilder oder Videos hier ablegen oder zum Hochladen klicken
                                    </div>
                                </div>
                                <div id="mediaError" class="text-danger small d-none mt-2"></div>

                                <hr class="my-6" />

                                <!-- 4. Address Mapping -->
                                <h5 class="mb-4">4. Adressen</h5>
                                <div class="row g-6">
                                    <div class="col-12">
                                        <div class="row g-3">
                                            <div class="col-12 col-sm-9">
                                                <div class="form-floating form-floating-outline">
                                                    <input type="text" id="pickupAddress" name="pickupAddress" class="form-control" placeholder="" maxlength="512" value="@(isEdit ? req!.PickupAddress : "")" />
                                                    <label for="pickupAddress">Abholadresse</label>
                                                    <div class="invalid-feedback">Abholadresse ist erforderlich.</div>
                                                </div>
                                            </div>
                                            <div class="col-12 col-sm-3">
                                                <div class="form-floating form-floating-outline">
                                                    <input type="text" id="pickupZipCode" name="pickupZipCode" class="form-control" placeholder="" maxlength="8" value="@(isEdit ? req!.PickupZipCode : "")" />
                                                    <label for="pickupZipCode">Abholpostleitzahl</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="row g-3">
                                            <div class="col-12 col-sm-9">
                                                <div class="form-floating form-floating-outline">
                                                    <input type="text" id="deliveryAddress" name="deliveryAddress" class="form-control" placeholder="" maxlength="512" value="@(isEdit ? req!.DeliveryAddress : "")" />
                                                    <label for="deliveryAddress">Lieferadresse</label>
                                                    <div class="invalid-feedback">Lieferadresse ist erforderlich.</div>
                                                </div>
                                            </div>
                                            <div class="col-12 col-sm-3">
                                                <div class="form-floating form-floating-outline">
                                                    <input type="text" id="deliveryZipCode" name="deliveryZipCode" class="form-control" placeholder="" maxlength="8" value="@(isEdit ? req!.DeliveryZipCode : "")" />
                                                    <label for="deliveryZipCode">Lieferpostleitzahl</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <hr class="my-6" />

                                <!-- 5. Additional Details -->
                                <h5 class="mb-4">5. Weitere Details</h5>

                                <div id="noDetailsMsg">
                                    <p class="text-secondary">Keine weiteren Details.</p>
                                </div>

                                <div id="transportFields" class="d-none">
                                    <div class="row g-6">
                                        <div class="col-12 col-sm-8">
                                            <div class="form-floating form-floating-outline">
                                                <input type="text" id="vehicleType" name="vehicleType" class="form-control" placeholder="" maxlength="128" value="@(isEdit ? req!.VehicleType ?? "" : "")" />
                                                <label for="vehicleType">Fahrzeugtyp</label>
                                            </div>
                                            <div id="vehicleTypeError" class="text-danger small d-none mt-1">Fahrzeugtyp ist erforderlich.</div>
                                        </div>
                                        <div class="col-12 col-sm-4">
                                            <div class="form-floating form-floating-outline">
                                                <select id="vehicleCondition" name="vehicleCondition" class="selectpicker w-100" data-style="btn-default" title="@(!isEdit ? "..." : null)">
                                                    <option value="@VehicleConditionEnum.WorksProperly" selected="@(isEdit && req!.VehicleCondition == VehicleConditionEnum.WorksProperly ? "selected" : null)">Fahrbereit@* Works Properly *@</option>
                                                    <option value="@VehicleConditionEnum.CanRun" selected="@(isEdit && req!.VehicleCondition == VehicleConditionEnum.CanRun ? "selected" : null)">Springt an@* Can Run *@</option>
                                                    <option value="@VehicleConditionEnum.Damaged" selected="@(isEdit && req!.VehicleCondition == VehicleConditionEnum.Damaged ? "selected" : null)">Nicht fahrbereit@* Damaged *@</option>
                                                </select>
                                                <label for="vehicleCondition">Fahrzeugzustand</label>
                                            </div>
                                            <div id="vehicleConditionError" class="text-danger small d-none mt-1">Fahrzeugzustand ist erforderlich.</div>
                                        </div>
                                    </div>
                                </div>

                                <div id="elevatorParkingFields" class="d-none">
                                    <div class="row g-6">
                                        <div class="col-12 col-sm-6">
                                            <label class="switch">
                                                <input type="checkbox" id="presentElevator" name="presentElevator" value="true" class="switch-input" @(isEdit && req!.PresentElevator ? "checked" : "") />
                                                <span class="switch-toggle-slider">
                                                    <span class="switch-on"><i class="icon-base ri ri-check-line"></i></span>
                                                    <span class="switch-off"><i class="icon-base ri ri-close-line"></i></span>
                                                </span>
                                                <span class="switch-label">Es gibt einen Aufzug</span>
                                            </label>
                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <label class="switch">
                                                <input type="checkbox" id="presentParking" name="presentParking" value="true" class="switch-input" @(isEdit && req!.PresentParking ? "checked" : "") />
                                                <span class="switch-toggle-slider">
                                                    <span class="switch-on"><i class="icon-base ri ri-check-line"></i></span>
                                                    <span class="switch-off"><i class="icon-base ri ri-close-line"></i></span>
                                                </span>
                                                <span class="switch-label">Es gibt einen Parkplatz</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <hr class="my-6" />

                                <!-- 6. Estimated Cost -->
                                <h5 class="mb-4">6. Geschätzte Kosten</h5>
                                <div class="row g-6">
                                    <div class="col-auto" style="width: 200px;">
                                        <div class="input-group input-group-merge">
                                            <div class="form-floating form-floating-outline">
                                                <input type="number" id="proposedCost" name="cost" class="form-control" placeholder="" min="1" max="10000" step="1" value="@(isEdit ? req!.Cost : "")" />
                                                <label for="proposedCost">Kosten</label>
                                            </div>
                                            <span class="input-group-text">EUR</span>
                                        </div>
                                        <div class="invalid-feedback">Kosten sind erforderlich.</div>
                                    </div>
                                </div>

                                <hr class="my-6" />

                                <!-- 7. Desirable Timing -->
                                <h5 class="mb-4">7. Gewünschter Zeitpunkt</h5>
                                <div class="mb-4">
                                    <div class="form-check form-check-inline">
                                        <input name="isASAP" class="form-check-input" type="radio" value="true" id="timingInstant" checked="@(!isEdit || req!.ASAP ? "checked" : null)" />
                                        <label class="form-check-label" for="timingInstant">So schnell wie möglich</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input name="isASAP" class="form-check-input" type="radio" value="false" id="timingSpecified" checked="@(isEdit && !req!.ASAP ? "checked" : null)" />
                                        <label class="form-check-label" for="timingSpecified">Bestimmtes Datum und Uhrzeit</label>
                                    </div>
                                </div>

                                <div id="scheduled-fields" class="@(isEdit && !req!.ASAP ? "" : "d-none")">
                                    <div class="row g-6">
                                        <div class="col-auto" style="width: 200px;">
                                            <div class="input-group input-group-merge">
                                                <div class="form-floating form-floating-outline flex-grow-1">
                                                    <input type="text" id="proposedDate" name="date" class="form-control" placeholder="" value="@(isEdit ? req!.Date?.ToString("d. MMMM yyyy") : "")" />
                                                    <label for="proposedDate">Datum</label>
                                                </div>
                                                <span class="input-group-text"><i class="icon-base ri ri-calendar-line"></i></span>
                                            </div>
                                            <div class="invalid-feedback">Bitte wählen Sie ein Datum aus.</div>
                                        </div>
                                        <div class="col-auto" style="width: 200px;">
                                            <div class="input-group input-group-merge">
                                                <div class="form-floating form-floating-outline flex-grow-1">
                                                    <input type="text" id="proposedTime" name="time" class="form-control" placeholder="" value="@(isEdit ? req!.Time?.ToString("HH:mm") : "")" />
                                                    <label for="proposedTime">Uhrzeit</label>
                                                </div>
                                                <span class="input-group-text"><i class="icon-base ri ri-time-line"></i></span>
                                            </div>
                                            <div class="invalid-feedback">Bitte wählen Sie eine Uhrzeit aus.</div>
                                        </div>
                                    </div>
                                </div>

                                <hr class="my-6" />
                            </div>
                        </div>
                    </form>
                </div>

                <div class="card-footer d-flex align-items-center justify-content-end justify-content-sm-end justify-content-md-center">
                    <div class="action-btns">
                        @if (!isEdit || req?.Status == RequestStatusEnum.Pending || req?.Status == RequestStatusEnum.Negotiation)
                        {
                            <button id="btnCancel" type="button" class="btn btn-danger me-2" style="width: 120px;">Abbrechen</button>
                        }
                        @if (!isEdit || req?.Status == RequestStatusEnum.Pending)
                        {
                            <button id="btnSubmitRequest" type="button" class="btn btn-primary me-2" style="width: 120px;">Speichern</button>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>

