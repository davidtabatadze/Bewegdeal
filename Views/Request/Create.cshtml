@using Bewegdeal.Data.Entities
@using Bewegdeal.Enums
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "New Request";
    var settings = (SettingsEntity)ViewBag.Settings;
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/dropzone/dropzone.css" />
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/vendor/libs/jquery-timepicker/jquery-timepicker.css" />
    <link rel="stylesheet" href="~/vendor/libs/notyf/notyf.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/dropzone/dropzone.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr.js"></script>
    <script src="~/vendor/libs/jquery-timepicker/jquery-timepicker.js"></script>
    <script src="~/vendor/libs/notyf/notyf.js"></script>
}

@section PageScripts {
    <script>
        const imageMaxCount = @settings.RequestImageMaxCount;
        const imageMaxSize  = @settings.RequestImageMaxSize;
        const videoMaxCount = @settings.RequestVideoMaxCount;
        const videoMaxSize  = @settings.RequestVideoMaxSize;
    </script>
    <script src="~/js/request-create.js"></script>
}

<div class="row">
    <div class="col-12">
        <div class="card">

            <!-- Sticky header -->
            <div class="card-header sticky-element bg-label-secondary d-flex justify-content-sm-between align-items-sm-center flex-column flex-sm-row">
                <h5 class="card-title mb-sm-0 me-2">New Request</h5>
                <div class="action-btns">
                    <button id="btnCancel" type="button" class="btn btn-outline-secondary me-4">Cancel</button>
                    <button id="btnPlaceRequest" type="button" class="btn btn-primary">Place Request</button>
                </div>
            </div>

            <div class="card-body pt-5">
                <form id="requestCreateForm" asp-controller="Request" asp-action="Create" method="post">
                    <div class="row">
                        <div class="col-lg-8 mx-auto">

                            <!-- 1. Service Type -->
                            <h5 class="mb-4">1. Service Type</h5>
                            <div class="row gy-3">
                                <div class="col-md-3 col-sm-6">
                                    <div class="form-check custom-option custom-option-icon">
                                        <label class="form-check-label custom-option-content" for="serviceMoving">
                                            <span class="custom-option-body">
                                                <i class="icon-base ri ri-truck-line"></i>
                                                <span class="custom-option-title mb-1">Moving</span>
                                                <small>Household or office relocation</small>
                                            </span>
                                            <input name="service" class="form-check-input" type="radio" value="@ServiceEnum.Moving" id="serviceMoving" />
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <div class="form-check custom-option custom-option-icon">
                                        <label class="form-check-label custom-option-content" for="serviceRemoval">
                                            <span class="custom-option-body">
                                                <i class="icon-base ri ri-delete-bin-2-line"></i>
                                                <span class="custom-option-title mb-1">Removal</span>
                                                <small>Junk and waste removal</small>
                                            </span>
                                            <input name="service" class="form-check-input" type="radio" value="@ServiceEnum.Removal" id="serviceRemoval" />
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <div class="form-check custom-option custom-option-icon">
                                        <label class="form-check-label custom-option-content" for="servicePickup">
                                            <span class="custom-option-body">
                                                <i class="icon-base ri ri-store-2-line"></i>
                                                <span class="custom-option-title mb-1">Pickup</span>
                                                <small>Store or warehouse pickup</small>
                                            </span>
                                            <input name="service" class="form-check-input" type="radio" value="@ServiceEnum.Pickup" id="servicePickup" />
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <div class="form-check custom-option custom-option-icon">
                                        <label class="form-check-label custom-option-content" for="serviceTransport">
                                            <span class="custom-option-body">
                                                <i class="icon-base ri ri-car-line"></i>
                                                <span class="custom-option-title mb-1">Transport</span>
                                                <small>Vehicle or cargo transport</small>
                                            </span>
                                            <input name="service" class="form-check-input" type="radio" value="@ServiceEnum.Transport" id="serviceTransport" />
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div id="serviceError" class="text-danger small d-none mt-2">Service type is required.</div>

                            <hr class="my-6" />

                            <!-- 2. General Information -->
                            <h5 class="mb-4">2. General Information</h5>
                            <div class="row g-6">
                                <div class="col-12">
                                    <div class="form-floating form-floating-outline">
                                        <input type="text" id="title" name="title" class="form-control" placeholder="" maxlength="128" />
                                        <label for="title">Title</label>
                                        <div class="invalid-feedback">Title is required.</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-floating form-floating-outline">
                                        <textarea id="description" name="description" class="form-control" placeholder="" style="height: 100px;" maxlength="2048"></textarea>
                                        <label for="description">Description <span class="text-muted">(optional)</span></label>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-6" />

                            <!-- 3. Media -->
                            <h5 class="mb-2">3. Media Information</h5>

                            <p class="text-muted mb-3 small">
                                <strong>Images</strong> (png, jpg, jpeg): up to @settings.RequestImageMaxCount files, max @settings.RequestImageMaxSize MB each. At least one required. You may "Set Main" image.<br />
                                <strong>Videos</strong> (mp4, mov): up to @settings.RequestVideoMaxCount files, max @settings.RequestVideoMaxSize MB each. Optional.
                            </p>
                            <div id="dropzone-media" class="dropzone needsclick">
                                <div class="dz-message needsclick">
                                    Drop images or videos here, or click to upload
                                </div>
                            </div>
                            <div id="mediaError" class="text-danger small d-none mt-2"></div>

                            <hr class="my-6" />

                            <!-- 4. Address Mapping -->
                            <h5 class="mb-4">4. Address Mapping</h5>
                            <div class="row g-6">
                                <div class="col-12">
                                    <div class="form-floating form-floating-outline">
                                        <input type="text" id="sourceAddress" name="sourceAddress" class="form-control" placeholder="" maxlength="512" />
                                        <label for="sourceAddress">Source Address</label>
                                        <div class="invalid-feedback">Source address is required.</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-floating form-floating-outline">
                                        <input type="text" id="destinationAddress" name="destinationAddress" class="form-control" placeholder="" maxlength="512" />
                                        <label for="destinationAddress">Destination Address</label>
                                        <div class="invalid-feedback">Destination address is required.</div>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-6" />

                            <!-- 5. Estimated Cost -->
                            <h5 class="mb-4">5. Estimated Cost</h5>
                            <div class="row g-6">
                                <div class="col-auto" style="width: 200px;">
                                    <div class="input-group input-group-merge">
                                        <div class="form-floating form-floating-outline">
                                            <input type="number" id="proposedCost" name="proposedCost" class="form-control" placeholder="" min="1" max="10000" step="0.01" />
                                            <label for="proposedCost">Cost</label>
                                            <div class="invalid-feedback">Cost is required.</div>
                                        </div>
                                        <span class="input-group-text">EUR</span>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-6" />

                            <!-- 6. Desirable Timing -->
                            <h5 class="mb-4">6. Desirable Timing</h5>
                            <div class="mb-4">
                                <div class="form-check form-check-inline">
                                    <input name="isASAP" class="form-check-input" type="radio" value="true" id="timingInstant" checked />
                                    <label class="form-check-label" for="timingInstant">As soon as possible</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input name="isASAP" class="form-check-input" type="radio" value="false" id="timingSpecified" />
                                    <label class="form-check-label" for="timingSpecified">Specified date and time</label>
                                </div>
                            </div>

                            <div id="scheduled-fields" class="d-none">
                                <div class="row g-6">
                                    <div class="col-auto" style="width: 200px;">
                                        <div class="form-floating form-floating-outline">
                                            <input type="text" id="proposedDate" name="proposedDate" class="form-control" placeholder="" />
                                            <label for="proposedDate">Date</label>
                                            <div class="invalid-feedback">Please select a date.</div>
                                        </div>
                                    </div>
                                    <div class="col-auto" style="width: 200px;">
                                        <div class="form-floating form-floating-outline">
                                            <input type="text" id="proposedTime" name="proposedTime" class="form-control" placeholder="" />
                                            <label for="proposedTime">Time</label>
                                            <div class="invalid-feedback">Please select a time.</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>
