@{
    string? currentPage = ViewContext.HttpContext.Request.Path;

    var sessionName = Context.Session.GetString(ConstantEnum.SessionUserName) ?? "-";
    var sessionEmail = Context.Session.GetString(ConstantEnum.SessionUserEmail) ?? "-";
    var nameParts = sessionName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var userInitials = string.Concat(nameParts.Take(2).Select(p => char.ToUpper(p[0])));
    if (string.IsNullOrEmpty(userInitials)) { userInitials = "?"; }

    var pictureKey = Context.Session.GetString(ConstantEnum.SessionUserPictureKey);
    var pictureUrl = !string.IsNullOrEmpty(pictureKey)
        ? Url.Action("Download", "File", new { key = pictureKey })
        : null;
}

<!-- Menu -->
<aside id="layout-menu" class="layout-menu menu-vertical menu">

    <div class="app-brand demo">
        <a asp-controller="Home" asp-action="Index" class="app-brand-link gap-xl-0 gap-2">
            <span class="app-brand-logo demo me-1">
                @await Html.PartialAsync("../_Partials/_Macros")
            </span>
            <span class="app-brand-text demo menu-text fw-semibold ms-2">Bewegdeal</span>
        </a>
        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
            <i class="menu-toggle-icon d-xl-inline-block align-middle"></i>
        </a>
    </div>

    <div class="menu-inner-shadow"></div>

    <ul class="menu-inner py-1">

        <!-- ------ -->
        <li class="menu-header mt-3">
            <span class="menu-header-text" data-i18n="User">User</span>
        </li>

        <!-- User badge -->
        <li class='menu-item@(currentPage == "/User/Profile" ? " open" : "")'>
            <a href="javascript:void(0);" class="menu-link menu-toggle" style="padding-inline-start: 0.75rem;">
                @if (pictureUrl is not null)
                {
                    <img id="menuBadgeImg" src="@pictureUrl" alt="@sessionName"
                         class="menu-icon rounded-circle" style="object-fit:cover;width:45px;height:45px;" />
                    <span id="menuBadgeInitials" class="menu-icon avatar-initial rounded-circle bg-label-primary"
                          style="width:45px;height:45px;font-size:1rem;display:flex;align-items:center;justify-content:center;display:none;">@userInitials</span>
                }
                else
                {
                    <img id="menuBadgeImg" src="" alt="" class="menu-icon rounded-circle"
                         style="object-fit:cover;width:45px;height:45px;display:none;" />
                    <span id="menuBadgeInitials" class="menu-icon avatar-initial rounded-circle bg-label-primary"
                          style="width:45px;height:45px;font-size:1rem;display:flex;align-items:center;justify-content:center;">@userInitials</span>
                }
                @* <div data-i18n="@sessionName">@sessionName</div> margin-inline-end: 0px;  *@
                @* <div>
                    <h6 class="mb-0 small">@sessionName</h6>
                    <small class="text-body-secondary">@sessionEmail</small>
                </div> *@
                <div data-i18n="@sessionName">@sessionName</div>
            </a>
            <ul class="menu-sub">
                <li class='menu-item@(currentPage == "/User/Profile" ? " active" : "")'>
                    <a asp-controller="User" asp-action="Profile" class="menu-link">
                        <div>Profile</div>
                    </a>
                </li>
                <li class="menu-item">
                    <a href="javascript:void(0);" style="background: rgba(var(--bs-danger-rgb), 0.08);" class="menu-link" onclick="document.getElementById('menuLogoutForm').submit();">
                        <div class="text-danger">Logout</div>
                        @* <i class="menu-icon icon-base ri ri-logout-box-r-line text-danger"></i> *@
                    </a>
                </li>
            </ul>
        </li>
        <!-- / User badge -->

        <!-- ------ -->
        <li class="menu-header mt-2">
            <span class="menu-header-text" data-i18n="Navigation">Navigation</span>
        </li>

        <!-- Dashboard -->
        <li class='menu-item@((currentPage == "/Dashboard/Index" || currentPage == "/Dashboard") ? " active" : "")'>
            <a asp-controller="Dashboard" asp-action="Index" class="menu-link">
                <i class="menu-icon icon-base ri ri-home-smile-line"></i>
                <div data-i18n="Dashboard">Dashboard</div>
            </a>
        </li>

        @if (Context.Session.GetString(ConstantEnum.SessionUserRole) == UserRoleEnum.Customer)
        {
            <!-- New Request -->
            <li class='menu-item@(currentPage == "/Request/Create" ? " active" : "")'>
                <a asp-controller="Request" asp-action="Create" class="menu-link">
                    <i class="menu-icon icon-base ri ri-add-circle-line"></i>
                    <div data-i18n="New Request">New Request</div>
                </a>
            </li>

            <!-- My Requests -->
            <li class='menu-item@((currentPage == "/Request/List" || currentPage == "/Request/View") ? " active" : "")'>
                <a asp-controller="Request" asp-action="List" class="menu-link">
                    <i class="menu-icon icon-base ri ri-file-list-3-line"></i>
                    <div data-i18n="My Requests">My Requests</div>
                </a>
            </li>
        }

        @if (Context.Session.GetString(ConstantEnum.SessionUserRole) == UserRoleEnum.Administrator)
        {
            <!-- Users -->
            <li class='menu-item@(currentPage == "/User/List" ? " active" : "")'>
                <a asp-controller="User" asp-action="List" class="menu-link">
                    <i class="menu-icon icon-base ri ri-group-line"></i>
                    <div data-i18n="Users">Users</div>
                </a>
            </li>

            <!-- Fraud Dictionary -->
            <li class='menu-item@(currentPage == "/FraudWord/Index" || currentPage == "/FraudWord" ? " active" : "")'>
                <a asp-controller="FraudWord" asp-action="Index" class="menu-link">
                    <i class="menu-icon icon-base ri ri-spam-2-line"></i>
                    <div data-i18n="Fraud Dictionary">Fraud Dictionary</div>
                </a>
            </li>

            <!-- Requests -->
            <li class='menu-item@((currentPage == "/Request/List" || currentPage == "/Request/View") ? " active" : "")'>
                <a asp-controller="Request" asp-action="List" class="menu-link">
                    <i class="menu-icon icon-base ri ri-file-list-3-line"></i>
                    <div data-i18n="Requests">Requests</div>
                </a>
            </li>

            <!-- Settings -->
            <li class='menu-item@(currentPage == "/Settings" || currentPage == "/Settings/Index" ? " active" : "")'>
                <a asp-controller="Settings" asp-action="Index" class="menu-link">
                    <i class="menu-icon icon-base ri ri-settings-4-line"></i>
                    <div data-i18n="Settings">Settings</div>
                </a>
            </li>
        }

        @if (Context.Session.GetString(ConstantEnum.SessionUserRole) == UserRoleEnum.Customer)
        {
            <!-- How It Works -->
            <li class='menu-item@(currentPage == "/HowItWorks/Customer" ? " active" : "")'>
                <a asp-controller="HowItWorks" asp-action="Customer" class="menu-link">
                    <i class="menu-icon icon-base ri ri-question-line"></i>
                    <div data-i18n="How It Works">How It Works</div>
                </a>
            </li>
        }

        @if (Context.Session.GetString(ConstantEnum.SessionUserRole) == UserRoleEnum.Company)
        {
            <!-- Requests -->
            <li class='menu-item@((currentPage == "/Request/List" || currentPage == "/Request/View") ? " active" : "")'>
                <a asp-controller="Request" asp-action="List" class="menu-link">
                    <i class="menu-icon icon-base ri ri-file-list-3-line"></i>
                    <div data-i18n="Requests">Requests</div>
                </a>
            </li>

            <!-- How It Works -->
            <li class='menu-item@(currentPage == "/HowItWorks/Company" ? " active" : "")'>
                <a asp-controller="HowItWorks" asp-action="Company" class="menu-link">
                    <i class="menu-icon icon-base ri ri-question-line"></i>
                    <div data-i18n="How It Works">How It Works</div>
                </a>
            </li>
        }

    </ul>
    <form id="menuLogoutForm" asp-controller="Account" asp-action="Logout" method="post" class="d-none"></form>
</aside>

<div class="menu-mobile-toggler d-xl-none rounded-1">
    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large text-bg-primary p-2 rounded-1">
        <i class="ri ri-menu-line icon-base"></i>
        <i class="ri ri-arrow-right-s-line icon-base"></i>
    </a>
</div>
<!-- / Menu -->
