@{
    string? currentPage = ViewContext.HttpContext.Request.Path;
}

<!-- Menu -->
<aside id="layout-menu" class="layout-menu menu-vertical menu">

    <div class="app-brand demo">
        <a asp-controller="Home" asp-action="Index" class="app-brand-link gap-xl-0 gap-2">
            <span class="app-brand-logo demo me-1">
                @await Html.PartialAsync("../_Partials/_Macros")
            </span>
            <span class="app-brand-text demo menu-text fw-semibold ms-2">Bewegdeal</span>
        </a>
        <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
            <i class="menu-toggle-icon d-xl-inline-block align-middle"></i>
        </a>
    </div>

    <div class="menu-inner-shadow"></div>

    <ul class="menu-inner py-1">
        
        <!-- ------ -->
        <li class="menu-header mt-7" style="padding-inline: 0 !important">
        </li>

        <!-- Dashboard -->
        <li class='menu-item@((currentPage == "/Dashboard/Index" || currentPage == "/Dashboard") ? " active" : "")'>
            <a asp-controller="Dashboard" asp-action="Index" class="menu-link">
                <i class="menu-icon icon-base ri ri-home-smile-line"></i>
                <div data-i18n="Dashboard">Dashboard</div>
            </a>
        </li>

        @if (Context.Session.GetString("UserRole") == Bewegdeal.Enums.UserRoleEnum.Customer)
        {
            <!-- New Request -->
            <li class='menu-item@(currentPage == "/Request/Create" ? " active" : "")'>
                <a asp-controller="Request" asp-action="Create" class="menu-link">
                    <i class="menu-icon icon-base ri ri-add-circle-line"></i>
                    <div data-i18n="New Request">New Request</div>
                </a>
            </li>

            <!-- My Requests -->
            <li class='menu-item@((currentPage == "/Request/List" || currentPage == "/Request/View") ? " active" : "")'>
                <a asp-controller="Request" asp-action="List" class="menu-link">
                    <i class="menu-icon icon-base ri ri-file-list-3-line"></i>
                    <div data-i18n="My Requests">My Requests</div>
                </a>
            </li>
        }

        @if (Context.Session.GetString("UserRole") == Bewegdeal.Enums.UserRoleEnum.Administrator)
        {
            <!-- Users -->
            <li class='menu-item@(currentPage == "/User/List" ? " active" : "")'>
                <a asp-controller="User" asp-action="List" class="menu-link">
                    <i class="menu-icon icon-base ri ri-group-line"></i>
                    <div data-i18n="Users">Users</div>
                </a>
            </li>

            <!-- Fraud Dictionary -->
            <li class='menu-item@(currentPage == "/FraudWord/Index" || currentPage == "/FraudWord" ? " active" : "")'>
                <a asp-controller="FraudWord" asp-action="Index" class="menu-link">
                    <i class="menu-icon icon-base ri ri-spam-2-line"></i>
                    <div data-i18n="Fraud Dictionary">Fraud Dictionary</div>
                </a>
            </li>

            <!-- Requests -->
            <li class='menu-item@((currentPage == "/Request/List" || currentPage == "/Request/View") ? " active" : "")'>
                <a asp-controller="Request" asp-action="List" class="menu-link">
                    <i class="menu-icon icon-base ri ri-file-list-3-line"></i>
                    <div data-i18n="Requests">Requests</div>
                </a>
            </li>

            <!-- Settings -->
            <li class='menu-item@(currentPage == "/Settings" || currentPage == "/Settings/Index" ? " active" : "")'>
                <a asp-controller="Settings" asp-action="Index" class="menu-link">
                    <i class="menu-icon icon-base ri ri-settings-4-line"></i>
                    <div data-i18n="Settings">Settings</div>
                </a>
            </li>
        }

        @if (Context.Session.GetString("UserRole") == Bewegdeal.Enums.UserRoleEnum.Customer)
        {
            <!-- How It Works -->
            <li class='menu-item@(currentPage == "/HowItWorks/Customer" ? " active" : "")'>
                <a asp-controller="HowItWorks" asp-action="Customer" class="menu-link">
                    <i class="menu-icon icon-base ri ri-question-line"></i>
                    <div data-i18n="How It Works">How It Works</div>
                </a>
            </li>
        }

        @if (Context.Session.GetString("UserRole") == Bewegdeal.Enums.UserRoleEnum.Company)
        {
            <!-- Requests -->
            <li class='menu-item@((currentPage == "/Request/List" || currentPage == "/Request/View") ? " active" : "")'>
                <a asp-controller="Request" asp-action="List" class="menu-link">
                    <i class="menu-icon icon-base ri ri-file-list-3-line"></i>
                    <div data-i18n="Requests">Requests</div>
                </a>
            </li>

            <!-- How It Works -->
            <li class='menu-item@(currentPage == "/HowItWorks/Company" ? " active" : "")'>
                <a asp-controller="HowItWorks" asp-action="Company" class="menu-link">
                    <i class="menu-icon icon-base ri ri-question-line"></i>
                    <div data-i18n="How It Works">How It Works</div>
                </a>
            </li>
        }

    </ul>
</aside>
<!-- / Menu -->
