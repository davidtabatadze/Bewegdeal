@inject Bewegdeal.Data.Repositories.Abstractions.ISettingsRepository _footerSettingsRepo
@inject Bewegdeal.Data.Repositories.Abstractions.IFileRepository _footerFileRepo
@{
    var _footerSettings = await _footerSettingsRepo.Get();
    var _footerTcFile = await _footerFileRepo.Get(_footerSettings.TermsAndConditionsFileId);
    var _footerTcUrl = _footerTcFile is not null
        ? Url.Action("Download", "File", new { key = _footerTcFile.Key })
        : null;
}
<!-- Footer -->
<footer class="content-footer footer bg-footer-theme">
    <div class="container-xxl">
        <div class="footer-container d-flex align-items-center justify-content-between py-4 flex-md-row flex-column">
            <div class="mb-2 mb-md-0">
                &#169;
                <script>document.write(new Date().getFullYear());</script>
                , made with ❤️ by <a href="#" class="footer-link fw-medium"><strong>Bewegdeal</strong></a>
            </div>
            <div class="d-none d-lg-inline-block">
                @if (_footerTcUrl is not null)
                {
                    <a href="@_footerTcUrl" target="_blank" class="footer-link d-none d-sm-inline-block"><strong>Terms &amp; Conditions</strong></a>
                }
            </div>
        </div>
    </div>
</footer>
<!-- / Footer -->
