<!-- Footer: Start -->
<footer class="landing-footer">
  <div class="footer-top position-relative overflow-hidden">
    <img src="~/img/front-pages/backgrounds/footer-bg.png" alt="footer bg" class="footer-bg banner-bg-img" />
    <div class="container">
      <div class="row gx-0 gy-6 g-lg-10">
        <div class="col-lg-5">
          <a asp-controller="Landing" asp-action="Index" class="app-brand-link mb-6">
            <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
            <span class="app-brand-text demo text-white fw-semibold ms-2 ps-1">Bewegdeal</span>
          </a>
          <p class="footer-text footer-logo-description mb-6">Bewegdeal — connecting people with deals that move.</p>
          <form class="footer-form">
            <div class="d-flex mt-2 gap-4">
              <div class="form-floating form-floating-outline w-px-250">
                <input type="text" class="form-control bg-transparent" id="newsletter-1" placeholder="Your email" />
                <label for="newsletter-1">Subscribe to newsletter</label>
              </div>
              <button type="submit" class="btn btn-primary">Subscribe</button>
            </div>
          </form>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6">
          <h6 class="footer-title mb-4 mb-lg-6">Pages</h6>
          <ul class="list-unstyled mb-0">
            <li class="mb-4">
              <a href="javascript:void(0);" class="footer-link">Pricing</a>
            </li>
            <li class="mb-4">
              <a href="javascript:void(0);" class="footer-link">Help Center</a>
            </li>
            <li class="mb-4">
              <a href="javascript:void(0);" class="footer-link">Contact</a>
            </li>
            <li>
              <a href="javascript:void(0);" class="footer-link">Login / Register</a>
            </li>
          </ul>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6">
          <h6 class="footer-title mb-4 mb-lg-6">Company</h6>
          <ul class="list-unstyled mb-0">
            <li class="mb-4">
              <a href="javascript:void(0);" class="footer-link">About Us</a>
            </li>
            <li class="mb-4">
              <a href="javascript:void(0);" class="footer-link">Blog</a>
            </li>
            <li class="mb-4">
              <a href="javascript:void(0);" class="footer-link">Careers</a>
            </li>
            <li>
              <a href="javascript:void(0);" class="footer-link">Privacy Policy</a>
            </li>
          </ul>
        </div>
        <div class="col-lg-3 col-md-4">
          <h6 class="footer-title mb-4 mb-lg-6">Download our app</h6>
          <a href="javascript:void(0);" class="d-block footer-link mb-4">
            <img src="~/img/front-pages/landing-page/apple-icon.png" alt="apple icon" />
          </a>
          <a href="javascript:void(0);" class="d-block footer-link">
            <img src="~/img/front-pages/landing-page/google-play-icon.png" alt="google play icon" />
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom py-5">
    <div class="container d-flex flex-wrap justify-content-between flex-md-row flex-column text-center text-md-start">
      <div class="mb-2 mb-md-0">
        <span class="footer-bottom-text">©
          <script>document.write(new Date().getFullYear());</script>
          , Made with
          <i class="icon-base ri ri-heart-fill text-danger"></i>
          by
        </span>
        <a href="#" class="footer-link fw-medium footer-theme-link">Bewegdeal</a>
      </div>
      <div>
        <a href="javascript:void(0);" class="footer-link me-4">
          <i class="icon-base ri ri-github-fill icon-18px"></i>
        </a>
        <a href="javascript:void(0);" class="footer-link me-4">
          <i class="icon-base ri ri-facebook-circle-fill icon-18px"></i>
        </a>
        <a href="javascript:void(0);" class="footer-link me-4">
          <i class="icon-base ri ri-twitter-x-fill icon-18px"></i>
        </a>
        <a href="javascript:void(0);" class="footer-link">
          <i class="icon-base ri ri-instagram-line icon-18px"></i>
        </a>
      </div>
    </div>
