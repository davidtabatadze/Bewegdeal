@using Bewegdeal.Models
@model ChatHistoryViewModel

<div class="chat-history-wrapper d-flex flex-column h-100" data-chat-key="@Model.ChatKey">

    @* Header *@
    <div class="chat-history-header border-bottom px-4 py-3 flex-shrink-0">
        <div class="d-flex align-items-center gap-3">
            <div class="avatar avatar-sm flex-shrink-0">
                @if (Model.OtherPartyPictureUrl is not null)
                {
                    <img src="@Model.OtherPartyPictureUrl" class="rounded-circle"
                         style="object-fit:cover;width:100%;height:100%;"
                         alt="@Model.OtherPartyName" />
                }
                else
                {
                    <span class="avatar-initial rounded-circle bg-label-primary w-100 h-100"
                          style="display:flex;align-items:center;justify-content:center;font-size:0.75rem;">
                        @Model.OtherPartyInitials
                    </span>
                }
            </div>
            <h6 class="mb-0">@Model.OtherPartyName</h6>
        </div>
    </div>

    @* Message list *@
    <div class="chat-history-body flex-grow-1 overflow-auto p-4">
        <ul class="list-unstyled chat-history mb-0" id="chatMessageList">
            @foreach (var msg in Model.Messages)
            {
                var isMine = msg.SenderId == Model.ViewerId;
                if (isMine)
                {
                    <li class="chat-message chat-message-right">
                        <div class="d-flex overflow-hidden">
                            <div class="chat-message-wrapper flex-grow-1 w-50">
                                <div class="chat-message-text">
                                    <p class="mb-0">@msg.Content</p>
                                </div>
                                <div class="text-end text-body-secondary mt-1">
                                    <i class="icon-base ri ri-check-double-line icon-16px me-1"></i>
                                    <small>@msg.SentDate.ToString("HH:mm")</small>
                                </div>
                            </div>
                            <div class="user-avatar flex-shrink-0 ms-4">
                                <div class="avatar avatar-sm">
                                    @if (Model.ViewerPictureUrl is not null)
                                    {
                                        <img src="@Model.ViewerPictureUrl" class="rounded-circle"
                                             style="object-fit:cover;width:100%;height:100%;" alt="Me" />
                                    }
                                    else
                                    {
                                        <span class="avatar-initial rounded-circle bg-label-primary w-100 h-100"
                                              style="display:flex;align-items:center;justify-content:center;font-size:0.75rem;">
                                            @Model.ViewerInitials
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </li>
                }
                else
                {
                    <li class="chat-message">
                        <div class="d-flex overflow-hidden">
                            <div class="user-avatar flex-shrink-0 me-4">
                                <div class="avatar avatar-sm">
                                    @if (Model.OtherPartyPictureUrl is not null)
                                    {
                                        <img src="@Model.OtherPartyPictureUrl" class="rounded-circle"
                                             style="object-fit:cover;width:100%;height:100%;"
                                             alt="@Model.OtherPartyName" />
                                    }
                                    else
                                    {
                                        <span class="avatar-initial rounded-circle bg-label-primary w-100 h-100"
                                              style="display:flex;align-items:center;justify-content:center;font-size:0.75rem;">
                                            @Model.OtherPartyInitials
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="chat-message-wrapper flex-grow-1">
                                <div class="chat-message-text">
                                    <p class="mb-0">@msg.Content</p>
                                </div>
                                <div class="text-body-secondary mt-1">
                                    <small>@msg.SentDate.ToString("HH:mm")</small>
                                </div>
                            </div>
                        </div>
                    </li>
                }
            }

        </ul>
    </div>

    @* Message input *@
    <div class="chat-history-footer border-top px-4 py-3 flex-shrink-0">
        <form class="form-send-message d-flex gap-2 align-items-center">
            <input type="text" class="form-control message-input border-0 shadow-none"
                   placeholder="Type your message…" maxlength="2048" autocomplete="off" />
            <button type="submit" class="btn btn-primary btn-icon flex-shrink-0">
                <i class="icon-base ri ri-send-plane-line"></i>
            </button>
        </form>
    </div>

</div>
