@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en"
      class="customizer-hide"
      data-skin="default" data-bs-theme="light"
      data-assets-path="/" data-template="vertical-menu-template">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
  <title>@ViewData["Title"]</title>

  <!-- Sync theme from landing page — must run before stylesheets to prevent flash -->
  <script>
    (function () {
      var stored = localStorage.getItem('templateCustomizer-front-page--Theme');
      if (!stored) { return; }
      localStorage.setItem('templateCustomizer-vertical-menu-template--Theme', stored);
      document.documentElement.setAttribute('data-bs-theme', stored);
    })();
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="~/img/favicon/favicon.ico" />

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#696cff" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Bewegdeal" />
  <link rel="apple-touch-icon" sizes="180x180" href="/img/branding/icon-192.png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Core CSS -->
  <link rel="stylesheet" href="~/vendor/fonts/iconify-icons.css" />
  <link rel="stylesheet" href="~/vendor/libs/node-waves/node-waves.css" />
  <link rel="stylesheet" href="~/vendor/css/core.css" />
  <link rel="stylesheet" href="~/css/demo.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

  @RenderSection("VendorStyles", required: false)
  @RenderSection("PageStyles", required: false)

  <!-- Template helpers & config (must be in <head>) -->
  <script src="~/vendor/js/helpers.js"></script>
  <script src="~/js/config.js" asp-append-version="true"></script>
</head>
<body>

  @RenderBody()

  <!-- Core Scripts -->
  <script src="~/vendor/libs/jquery/jquery.js"></script>
  <script src="~/vendor/libs/popper/popper.js"></script>
  <script src="~/vendor/js/bootstrap.js"></script>
  <script src="~/vendor/libs/node-waves/node-waves.js"></script>
  <script src="~/js/site.js" asp-append-version="true"></script>

  @RenderSection("VendorScripts", required: false)

  <script src="~/js/main.js" asp-append-version="true"></script>

  @RenderSection("PageScripts", required: false)

  @if (Configuration.GetValue<bool>("Pwa:Enabled")) { <script src="~/js/pwa.js" asp-append-version="true"></script> }

</body>
</html>
