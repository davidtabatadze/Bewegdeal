@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "How It Works";
    var showBar = (bool)ViewBag.ShowBar;
}

<div class="row flex-grow-1 h-100">
    <div class="col-12 d-flex flex-column">
        <div class="card flex-grow-1">

            @if (showBar)
            {
                <div class="card-header sticky-element d-flex justify-content-center align-items-center">
                    <form asp-controller="User" asp-action="AcceptHIW" method="post">
                        <button type="submit" class="btn btn-primary">
                            <i class="icon-base ri ri-checkbox-circle-line me-1_5"></i>
                            I understand, don't show again
                        </button>
                    </form>
                </div>
            }

            <div class="card-body p-6">

                <div class="text-center mb-8">
                    <h3 class="mb-2">Get your job done in 4 simple steps</h3>
                    <p class="text-muted mb-0">Post what you need — let the right company come to you.</p>
                </div>

                <div class="row g-5 mb-8">

                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-4">
                            <div class="flex-shrink-0">
                                <span class="badge rounded-pill bg-label-success p-3">
                                    <i class="icon-base ri ri-file-add-line icon-28px"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-1">1. Post your request</h5>
                                <p class="text-muted mb-0">
                                    Describe the job — moving, junk removal, store pickup, or vehicle transport.
                                    Add photos or videos, set your pickup and delivery address, name your price, and choose when you need it done.
                                    The more detail you provide, the better offers you'll get.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-4">
                            <div class="flex-shrink-0">
                                <span class="badge rounded-pill bg-label-info p-3">
                                    <i class="icon-base ri ri-building-2-line icon-28px"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-1">2. Companies find you</h5>
                                <p class="text-muted mb-0">
                                    Your request goes live on the marketplace immediately.
                                    Qualified companies browsing for work in their area will see it and reach out.
                                    You don't have to search — they come to you.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-4">
                            <div class="flex-shrink-0">
                                <span class="badge rounded-pill bg-label-warning p-3">
                                    <i class="icon-base ri ri-wechat-line icon-28px"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-1">3. Chat and receive proposals</h5>
                                <p class="text-muted mb-0">
                                    When a company is interested, they open a chat on your request. You'll see a chat icon appear on the request page — click it to talk directly.
                                    Once you've aligned on the basics, the company sends you a formal <strong>proposal</strong> with their price, scheduled date, time, and service terms.
                                    Review it and accept or reject it right inside the chat.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-4">
                            <div class="flex-shrink-0">
                                <span class="badge rounded-pill bg-label-primary p-3">
                                    <i class="icon-base ri ri-check-double-line icon-28px"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-1">4. Job done</h5>
                                <p class="text-muted mb-0">
                                    The company shows up and gets the work done. Once you're satisfied, mark the request
                                    as resolved. That's it — no paperwork, no phone tag, no stress.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>

                <hr class="my-6" />

                <div class="row g-4 mb-8">
                    <div class="col-12">
                        <h6 class="text-muted text-uppercase mb-4" style="letter-spacing:.05em;">How the chat &amp; proposal work</h6>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-info p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-wechat-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Company starts the chat</strong>
                                <p class="text-muted mb-0 small">Only companies can initiate a conversation. Once they do, a chat button appears on your request. You can exchange messages freely from there.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-warning p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-shake-hands-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Review the proposal</strong>
                                <p class="text-muted mb-0 small">When the company is ready, they send a formal proposal: price, date, time, and their service terms. It appears as a card inside the chat. Only one proposal can be active at a time.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-success p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-thumb-up-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Accept or reject</strong>
                                <p class="text-muted mb-0 small">Accept to lock in the deal — the request moves to Agreed and an invoice is generated automatically. Reject (with an optional reason) to continue negotiating.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-6" />

                <div class="row g-4 mb-8">
                    <div class="col-12">
                        <h6 class="text-muted text-uppercase mb-4" style="letter-spacing:.05em;">What happens after you accept a proposal?</h6>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-success p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-shake-hands-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Request becomes Agreed</strong>
                                <p class="text-muted mb-0 small">The request status changes to Agreed and is locked to the company you chose. No other company can take it.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-primary p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-bill-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Invoice is created</strong>
                                <p class="text-muted mb-0 small">An invoice is generated automatically from the agreed proposal. You can view it under <strong>Invoices</strong> in the menu — it shows the service cost, platform fee, and total.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-info p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-check-double-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Job done → Resolved</strong>
                                <p class="text-muted mb-0 small">Once the company completes the work, mark the request as Resolved. This closes it and adds it to your history.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-6" />

                <div class="row g-4 mb-8">
                    <div class="col-12">
                        <h6 class="text-muted text-uppercase mb-4" style="letter-spacing:.05em;">What do request statuses mean?</h6>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-warning p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-timer-flash-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Pending</strong>
                                <p class="text-muted mb-0 small">Your request is live and visible to companies. Waiting for someone to reach out.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-info p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-wechat-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Negotiation</strong>
                                <p class="text-muted mb-0 small">A company has opened a chat. You're in active talks — proposals may be pending.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-success p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-shake-hands-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Agreed</strong>
                                <p class="text-muted mb-0 small">A proposal was accepted. The company is confirmed and an invoice has been generated.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-success p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-check-double-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Resolved</strong>
                                <p class="text-muted mb-0 small">Job complete. The request is closed and archived in your history.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-6" />

                <div class="row g-4">
                    <div class="col-12">
                        <h6 class="text-muted text-uppercase mb-4" style="letter-spacing:.05em;">What can you request?</h6>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border text-center p-4 h-100">
                            <i class="icon-base ri ri-truck-line icon-36px text-success mb-2"></i>
                            <strong>@AnnotationEnum.General.Service.Moving</strong>
                            <small class="text-muted d-block mt-1">Relocate belongings from A to B</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border text-center p-4 h-100">
                            <i class="icon-base ri ri-recycle-line icon-36px text-danger mb-2"></i>
                            <strong>@AnnotationEnum.General.Service.Removal</strong>
                            <small class="text-muted d-block mt-1">Clear out what you no longer need</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border text-center p-4 h-100">
                            <i class="icon-base ri ri-shopping-bag-4-line icon-36px text-warning mb-2"></i>
                            <strong>@AnnotationEnum.General.Service.Pickup</strong>
                            <small class="text-muted d-block mt-1">Pick up your purchase and deliver it</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="card border text-center p-4 h-100">
                            <i class="icon-base ri ri-car-line icon-36px text-info mb-2"></i>
                            <strong>@AnnotationEnum.General.Service.Transport</strong>
                            <small class="text-muted d-block mt-1">Move your vehicle to a new location</small>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
