@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "So funktioniert es";
    var showBar = (bool)ViewBag.ShowBar;
}

<div class="row flex-grow-1 h-100">
    <div class="col-12 d-flex flex-column">
        <div class="card flex-grow-1">

            @if (showBar)
            {
                <div class="card-header sticky-element d-flex justify-content-center align-items-center">
                    <form asp-controller="User" asp-action="AcceptHIW" method="post">
                        <button type="submit" class="btn btn-primary">
                            <i class="icon-base ri ri-checkbox-circle-line me-1_5"></i>
                            Ich habe verstanden, nicht mehr anzeigen
                        </button>
                    </form>
                </div>
            }

            <div class="card-body p-6">

                <div class="text-center mb-8">
                    <h3 class="mb-2">Aufträge finden. Deals abschließen. Bezahlt werden.</h3>
                    <p class="text-muted mb-0">Der Marktplatz bringt Kunden zu dir — deine Aufgabe ist es, den Deal zu gewinnen.</p>
                </div>

                <div class="row g-5 mb-8">

                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-4">
                            <div class="flex-shrink-0">
                                <span class="badge rounded-pill bg-label-info p-3">
                                    <i class="icon-base ri ri-search-eye-line icon-28px"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-1">1. Offene Anfragen durchsuchen</h5>
                                <p class="text-muted mb-0">
                                    Die Seite „Anfragen" zeigt alle aktiven Aufträge auf dem Marktplatz — alle ausstehenden Kundenanfragen
                                    sowie alle Aufträge, die dir bereits zugewiesen wurden. Filtere nach Serviceart, suche nach Stichwörtern und finde
                                    Arbeit, die zu deinen Kapazitäten passt.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-4">
                            <div class="flex-shrink-0">
                                <span class="badge rounded-pill bg-label-warning p-3">
                                    <i class="icon-base ri ri-hand-coin-line icon-28px"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-1">2. Die richtigen Aufträge auswählen</h5>
                                <p class="text-muted mb-0">
                                    Öffne jede Anfrage, um das vollständige Bild zu sehen — Fotos, Videos, Adressen, vorgeschlagenes Budget
                                    und Zeitplanung. Nimm nur Aufträge an, die du mit Sicherheit erfüllen kannst.
                                    Qualität ist wichtiger als Menge.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-4">
                            <div class="flex-shrink-0">
                                <span class="badge rounded-pill bg-label-primary p-3">
                                    <i class="icon-base ri ri-wechat-line icon-28px"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-1">3. Chat starten und Angebot senden</h5>
                                <p class="text-muted mb-0">
                                    Klicke auf der Anfrageseite auf <strong>Chat starten</strong>, um ein direktes Gespräch mit dem Kunden zu eröffnen.
                                    Besprecht die Details, und wenn du bereit bist, sende ein formelles <strong>Angebot</strong> —
                                    mit deinem Preis, geplantem Datum, Uhrzeit und Servicebedingungen.
                                    Der Kunde prüft es und akzeptiert oder lehnt es mit einer Begründung ab.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-4">
                            <div class="flex-shrink-0">
                                <span class="badge rounded-pill bg-label-success p-3">
                                    <i class="icon-base ri ri-shake-hands-line icon-28px"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-1">4. Ausführen — und den Kunden bitten, abzuschließen</h5>
                                <p class="text-muted mb-0">
                                    Erscheine, erledige die Arbeit und liefere. Der Auftrag gilt erst als abgeschlossen, wenn
                                    der <strong>Kunde</strong> die Anfrage auf „Abgeschlossen" setzt — du kannst das nicht selbst tun.
                                    Bitte ihn daher nach der Leistung aktiv darum. Abgeschlossene Aufträge zählen für deine Bewertung.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>

                <hr class="my-6" />

                <div class="row g-4 mb-8">
                    <div class="col-12">
                        <h6 class="text-muted text-uppercase mb-4" style="letter-spacing:.05em;">So funktionieren Chat &amp; Angebot</h6>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-primary p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-wechat-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Du startest den Chat</strong>
                                <p class="text-muted mb-0 small">Nur Unternehmen können ein Gespräch eröffnen. Öffne eine Anfrage und klicke auf <strong>Chat starten</strong>. Pro Anfrage gibt es nur einen aktiven Chat — wer zuerst kommt, mahlt zuerst.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-warning p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-shake-hands-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Angebot senden</strong>
                                <p class="text-muted mb-0 small">Nutze das Angebotsformular im Chat, um dein Angebot einzureichen: Preis, Datum, Uhrzeit und Servicebedingungen. Es kann immer nur ein Angebot ausstehend sein.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-info p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-refresh-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Bei Ablehnung anpassen</strong>
                                <p class="text-muted mb-0 small">Wenn der Kunde dein Angebot ablehnt (er kann eine Begründung angeben), kannst du es anpassen und ein neues senden. Ein neues Angebot ersetzt automatisch das vorherige.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-3">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-success p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-thumb-up-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Deal bei Annahme besiegelt</strong>
                                <p class="text-muted mb-0 small">Wenn der Kunde akzeptiert, wechselt die Anfrage zu Vereinbart, du wirst als Auftragnehmer eingetragen und eine Rechnung wird automatisch erstellt.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-6" />

                <div class="row g-4 mb-8">
                    <div class="col-12">
                        <h6 class="text-muted text-uppercase mb-4" style="letter-spacing:.05em;">Rechnungen</h6>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-success p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-bill-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Automatisch bei Dealabschluss</strong>
                                <p class="text-muted mb-0 small">Sobald ein Kunde dein Angebot annimmt, wird sofort eine Rechnung erstellt. Sie zeigt die Servicekosten, die Plattformprovision, die Steuer und den Gesamtbetrag.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-warning p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-timer-flash-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Zahlungsstatus verfolgen</strong>
                                <p class="text-muted mb-0 small">Deine Rechnungen starten als Ausstehend. Sobald die Zahlung von der Plattform bestätigt wird, werden sie als Bezahlt markiert. Alle Rechnungen findest du unter <strong>Rechnungen</strong> im Menü.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-danger p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-close-circle-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Stornierte Rechnungen</strong>
                                <p class="text-muted mb-0 small">Wenn ein Deal nach der Einigung scheitert, kann die Rechnung von der Plattform storniert werden. Dies wird separat von abgeschlossenen Anfragen erfasst.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-6" />

                <div class="row g-4 mb-8">
                    <div class="col-12">
                        <h6 class="text-muted text-uppercase mb-4" style="letter-spacing:.05em;">Anfragenliste filtern</h6>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-secondary p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-list-check icon-20px"></i>
                            </span>
                            <div>
                                <strong>Alle Anfragen</strong>
                                <p class="text-muted mb-0 small">Zeigt alle offenen Aufträge auf dem Markt, die deinen Serviceinteressen entsprechen, sowie alle dir zugewiesenen Aufträge.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-info p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-flashlight-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Potenzielle</strong>
                                <p class="text-muted mb-0 small">Nur offene Marktaufträge, die dir noch nicht zugewiesen wurden — nützlich, wenn du nach neuen Aufträgen suchst.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-primary p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-briefcase-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Nur meine</strong>
                                <p class="text-muted mb-0 small">Nur Aufträge, bei denen du der zugewiesene Auftragnehmer bist — dein aktiver Arbeitsbestand auf einen Blick.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-6" />

                <div class="row g-4 mb-8">
                    <div class="col-12">
                        <h6 class="text-muted text-uppercase mb-4" style="letter-spacing:.05em;">Leistung im Dashboard verfolgen</h6>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-warning p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-star-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Persönliche Bewertung</strong>
                                <p class="text-muted mb-0 small">Deine Sternebewertung basiert auf abgeschlossenen vs. stornierten Aufträgen, aufgeschlüsselt nach Service. Nur Aufträge, die der Kunde als <strong>Abgeschlossen</strong> markiert, zählen positiv — bitte ihn also aktiv darum.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-success p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-bar-chart-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Abgeschlossen &amp; Umsatz</strong>
                                <p class="text-muted mb-0 small">Sieh, wie viele Aufträge du abgeschlossen hast und wie viel du verdient hast — gefiltert nach Zeitraum.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-info p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-calendar-check-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Zeitraumfilter</strong>
                                <p class="text-muted mb-0 small">Alle Dashboard-Statistiken reagieren auf den Monatsbereich oben — vergleiche beliebige Zeiträume.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert alert-warning d-flex gap-3 align-items-start mt-2 mb-0" role="alert">
                    <i class="icon-base ri ri-star-line icon-22px flex-shrink-0 mt-1"></i>
                    <div>
                        <strong>Deine Bewertung hängt vom Kunden ab.</strong>
                        Nur der Kunde kann eine Anfrage auf <strong>„Abgeschlossen"</strong> setzen — du hast keinen Einfluss darauf.
                        Bitte ihn nach Erbringung der Leistung aktiv darum, die Anfrage abzuschließen.
                        Abgeschlossene Aufträge verbessern deine Sternebewertung und stärken dein Profil auf dem Marktplatz.
                    </div>
                </div>

                <hr class="my-6" />

                <div class="row g-4">
                    <div class="col-12">
                        <h6 class="text-muted text-uppercase mb-4" style="letter-spacing:.05em;">Sichtbarkeitsregeln für Anfragen</h6>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-warning p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-timer-flash-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Ausstehende Anfragen</strong>
                                <p class="text-muted mb-0 small">Für alle Unternehmen offen. Wer zuerst einen Deal macht, gewinnt den Auftrag.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-info p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-wechat-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Anfragen in Verhandlung</strong>
                                <p class="text-muted mb-0 small">Sichtbar, solange Gespräche laufen. Noch offen, bis ein Angebot angenommen wird.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-success p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-shake-hands-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Deine zugewiesenen Aufträge</strong>
                                <p class="text-muted mb-0 small">Anfragen, bei denen du der Auftragnehmer bist — unabhängig vom Status.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
