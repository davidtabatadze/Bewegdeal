@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "How It Works";
    var showBar = (bool)ViewBag.ShowBar;
}

<div class="row flex-grow-1 h-100">
    <div class="col-12 d-flex flex-column">
        <div class="card flex-grow-1">

            @if (showBar)
            {
                <div class="card-header sticky-element d-flex justify-content-center align-items-center">
                    <form asp-controller="User" asp-action="AcceptHIW" method="post">
                        <button type="submit" class="btn btn-primary">
                            <i class="icon-base ri ri-checkbox-circle-line me-1_5"></i>
                            I understand, don't show again
                        </button>
                    </form>
                </div>
            }

            <div class="card-body p-6">

                <div class="text-center mb-8">
                    <h3 class="mb-2">Find work. Close deals. Get paid.</h3>
                    <p class="text-muted mb-0">The marketplace brings customers to you — your job is to win the deal.</p>
                </div>

                <div class="row g-5 mb-8">

                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-4">
                            <div class="flex-shrink-0">
                                <span class="badge rounded-pill bg-label-info p-3">
                                    <i class="icon-base ri ri-search-eye-line icon-28px"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-1">1. Browse open requests</h5>
                                <p class="text-muted mb-0">
                                    The Requests page shows every active job on the marketplace — all pending requests from customers
                                    plus any jobs already assigned to you. Filter by service type, search by keyword, and find
                                    work that fits your capacity.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-4">
                            <div class="flex-shrink-0">
                                <span class="badge rounded-pill bg-label-warning p-3">
                                    <i class="icon-base ri ri-hand-coin-line icon-28px"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-1">2. Pick the right jobs</h5>
                                <p class="text-muted mb-0">
                                    Open each request to see the full picture — photos, videos, addresses, proposed budget,
                                    and timing. Only take on work you're confident you can deliver.
                                    Quality matters more than volume.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-4">
                            <div class="flex-shrink-0">
                                <span class="badge rounded-pill bg-label-primary p-3">
                                    <i class="icon-base ri ri-wechat-line icon-28px"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-1">3. Negotiate directly</h5>
                                <p class="text-muted mb-0">
                                    Reach out to the customer, propose your terms, and negotiate a price and schedule that
                                    works for both sides. No middlemen, no commissions eating into your margin —
                                    what you agree is what you earn.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="d-flex gap-4">
                            <div class="flex-shrink-0">
                                <span class="badge rounded-pill bg-label-success p-3">
                                    <i class="icon-base ri ri-shake-hands-line icon-28px"></i>
                                </span>
                            </div>
                            <div>
                                <h5 class="mb-1">4. Execute and close</h5>
                                <p class="text-muted mb-0">
                                    Show up, do the work, and deliver. Once the customer confirms the job is done,
                                    the request is marked resolved. A clean track record builds your reputation
                                    and brings more work your way.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>

                <hr class="my-6" />

                <div class="row g-4 mb-8">
                    <div class="col-12">
                        <h6 class="text-muted text-uppercase mb-4" style="letter-spacing:.05em;">Use the request list filters</h6>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-secondary p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-list-check icon-20px"></i>
                            </span>
                            <div>
                                <strong>All Requests</strong>
                                <p class="text-muted mb-0 small">Shows every open job on the market that matches your service interests, plus all jobs assigned to you.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-info p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-flashlight-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Potential</strong>
                                <p class="text-muted mb-0 small">Only open market jobs not yet assigned to you — useful when hunting for new work.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-primary p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-briefcase-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Only Mine</strong>
                                <p class="text-muted mb-0 small">Only jobs where you are the assigned executor — your active workload at a glance.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-6" />

                <div class="row g-4 mb-8">
                    <div class="col-12">
                        <h6 class="text-muted text-uppercase mb-4" style="letter-spacing:.05em;">Track your performance on the dashboard</h6>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-warning p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-star-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Personal Rating</strong>
                                <p class="text-muted mb-0 small">Your star rating based on resolved vs cancelled jobs, broken down per service.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-success p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-bar-chart-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Completed &amp; Revenue</strong>
                                <p class="text-muted mb-0 small">See how many jobs you've completed and how much you've earned, filtered by time period.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-info p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-calendar-check-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Period Filter</strong>
                                <p class="text-muted mb-0 small">All dashboard stats respond to the month range at the top — compare any period you like.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-6" />

                <div class="row g-4">
                    <div class="col-12">
                        <h6 class="text-muted text-uppercase mb-4" style="letter-spacing:.05em;">Request visibility rules</h6>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-warning p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-timer-flash-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Pending requests</strong>
                                <p class="text-muted mb-0 small">Open to all companies. First to make a deal wins the job.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-info p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-wechat-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Negotiation requests</strong>
                                <p class="text-muted mb-0 small">Visible while talks are ongoing. Still open until a deal is agreed.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge rounded-pill bg-label-success p-2 flex-shrink-0 mt-1">
                                <i class="icon-base ri ri-shake-hands-line icon-20px"></i>
                            </span>
                            <div>
                                <strong>Your assigned jobs</strong>
                                <p class="text-muted mb-0 small">Requests where you are the executor, regardless of status.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
