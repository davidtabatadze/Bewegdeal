@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Rechnung (Druckversion)";
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/app-invoice-print.css" />
}

@section PageScripts {
    <script src="~/js/app-invoice-print.js" asp-append-version="true"></script>
}

@{
    var invoice = (Bewegdeal.Models.InvoicePrintModel)ViewBag.Invoice;
    var data = invoice.Data!;
    var company = invoice.Company!;
    var proposal = invoice.Proposal!;
    var companyContact = invoice.CompanyContact;
    var service = data.Service switch
    {
        ServiceEnum.Moving => AnnotationEnum.General.Service.Moving,
        ServiceEnum.Removal => AnnotationEnum.General.Service.Removal,
        ServiceEnum.Pickup => AnnotationEnum.General.Service.Pickup,
        ServiceEnum.Transport => AnnotationEnum.General.Service.Transport,
        _ => data.Service
    };
}

@* ************** Content ************** *@
<div class="invoice-print p-6">
    <div class="d-flex justify-content-between flex-row">
        <div class="mb-6">
            <div class="d-flex svg-illustration align-items-center gap-2">
                <span class="app-brand-logo demo">@await Html.PartialAsync("~/Views/_Partials/_Macros.cshtml")</span>
                <span class="h4 mb-0 app-brand-text fw-semibold">Bewegdeal</span>
            </div>
            <p class="mb-6 fw-bold">Online-Vermittlungsplattform</p>
            <p class="mb-1">Giorgi Chochishvili - Einzelunternehmen</p>
            <p class="mb-1">Obere donaustrasse 35/16, 1020 Wien, Österreich</p>
            <p class="mb-1">UID: 12345678</p>
            <p class="mb-1">kontakt@bewegdeal.at</p>
            <p class="mb-0">+43 676 4976027</p>
        </div>
        <div class="text-end">
            <h4 class="mb-11">RECHNUNG Nr. @data.Id.ToString("D6")</h4>
            <div>
                <span>Leistungsdatum:</span>
                <span>@proposal.Date!.Value.ToString("d. MMMM yyyy")</span>
            </div>
            <div>
                <span>Rechnungsdatum:</span>
                <span>@data.CreateDate.ToString("d. MMMM yyyy")</span>
            </div>
            <div>
                <span>Fällig am:</span>
                <span>@data.DueDate.ToString("d. MMMM yyyy")</span>
            </div>
        </div>
    </div>

    <hr class="mb-6" />

    <div class="d-flex justify-content-between mb-6 gap-3">
        <div class="my-2">
            <h6 class="fw-bold">Rechnungsempfänger:</h6>
            <p class="mb-1">@company.Name - @companyContact?.Owner</p>
            <p class="mb-1">UID/GISA: @company.Number</p>
            <p class="mb-1">@company.Mobile</p>
            <p class="mb-0">@company.Email</p>
            <p class="mb-1">@companyContact?.Address, @companyContact?.ZipCode @companyContact?.City</p>
        </div>
        <div class="my-2">
            <h6 class="fw-bold">Bankverbindung:</h6>
            <table>
                <tbody>
                    <tr>
                        <td class="pe-2">Kontoinhaber:</td>
                        <td>Giorgi Chochishvili</td>
                    </tr>
                    @* <tr>
                        <td class="pe-2">Land:</td>
                        <td>Österreich</td>
                    </tr> *@
                    <tr>
                        <td class="pe-2">Bank:</td>
                        <td>TBC Bank</td>
                    </tr>
                    <tr>
                        <td class="pe-2">IBAN:</td>
                        <td>AT46 1420 0200 1448 5091</td>
                    </tr>
                    <tr>
                        <td class="pe-2">BIC:</td>
                        <td>BAWAATWW</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="table-responsive border border-bottom-0 rounded">
        <table class="table m-0">
            <thead class="table-light">
                <tr>
                    <th>Leistung</th>
                    <th>Auftragsnummer</th>
                    <th>Auftragswert netto</th>
                    <th>Provision</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@service</td>
                    <td>Nr. @data.RequestId</td>
                    <td>€@data.ServiceCost</td>
                    <td>€@data.CommissionCost</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="table-responsive">
        <table class="table m-0 table-borderless">
            <tbody>
                <tr>
                    <td class="align-top px-6 py-6">
                        <p class="mb-1">
                            <span class="me-2 fw-medium"></span>
                            <span></span>
                        </p>
                        <span></span>
                    </td>
                    <td class="px-0 py-12 w-px-100 text-end">
                        <p class="mb-2">Provision&nbsp<span style="font-size: 0.6rem">(@data.CommissionPersent%)</span>:</p>
                        <p class="mb-2">USt&nbsp<span style="font-size: 0.6rem">(@data.TaxPersent%)</span>:</p>
                        <p class="mb-2 border-bottom pb-2">Rabatt:</p>
                        <p class="mb-0 pt-2">Gesamtsumme:</p>
                    </td>
                    <td class="px-0 py-6 w-px-100 text-end">
                        <p class="fw-medium mb-2">€@data.CommissionCost</p>
                        <p class="fw-medium mb-2">€@data.TaxCost</p>
                        <p class="fw-medium mb-2 border-bottom pb-2">€0.00</p>
                        <p class="fw-medium mb-0 pt-2">€@data.TotalCost</p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <hr class="mt-0 mb-6" />
    <div class="row">
        @* <div class="col-12">
            <span class="fw-medium">Danke schön!</span>
        </div> *@
        <div class="col-12 text-center">
            <span>Vielen Dank für Ihr Vertrauen und die gute Zusammenarbeit. Ihr Team von <span class="fw-bold">bewegdeal.at</span></span>
        </div>
    </div>
</div>
