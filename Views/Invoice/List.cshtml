@using Bewegdeal.Enums
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Invoices";

    string FormatAmount(decimal value)
        => value < 1000 ? value.ToString("0.##") : (value / 1000m).ToString("0.##") + "K";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.css" />
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/vendor/libs/notiflix/notiflix.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/sweetalert2/sweetalert2.js"></script>
    <script src="~/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/vendor/libs/notiflix/notiflix.js"></script>
}

@section PageScripts {
    <script>
        window.invoiceStatusLabels = {
        pending:   '@AnnotationEnum.General.InvoiceStatus.Pending',
        paid:      '@AnnotationEnum.General.InvoiceStatus.Paid',
        cancelled: '@AnnotationEnum.General.InvoiceStatus.Cancelled'
        };
    </script>
    <script src="~/js/app-invoice-list.js" asp-append-version="true"></script>
}

@if (User.IsInRole(UserRoleEnum.Company) && (int)(ViewBag.Total ?? 0) == 0)
{
    <div class="row flex-grow-1 h-100">
        <div class="col-12 d-flex flex-column">
            <div class="card flex-grow-1">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center">
                    <img src="~/img/backgrounds/void.png" alt="" style="width: 450px; opacity: 0.85;" class="mb-6" />
                    <h5 class="mb-2">Sie haben noch keine Rechnung erhalten</h5>
                </div>
            </div>
        </div>
    </div>
}
else
{

    <div class="card mb-6">
        <div class="card-widget-separator-wrapper">
            <div class="card-body card-widget-separator pt-3 pb-3">
                <div class="row gy-4 gy-sm-1">
                    <div class="col-6 col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start card-widget-1 border-end pb-4 pb-sm-0">
                            <div>
                                <h4 class="mb-0 text-primary">@ViewBag.Total</h4>
                                <p class="mb-0 fw-bold">Rechnungen</p>
                            </div>
                            <div class="avatar me-lg-6 mt-2">
                                <span class="avatar-initial rounded bg-label-primary">
                                    <i class="icon-base ri ri-pages-line icon-28px"></i>
                                </span>
                            </div>
                        </div>
                        <hr class="d-none d-sm-block d-lg-none me-6" />
                    </div>
                    <div class="col-6 col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start card-widget-2 border-end pb-4 pb-sm-0">
                            <div>
                                <h4 class="mb-0 text-info">@ViewBag.Users</h4>
                                @if (User.IsInRole(UserRoleEnum.Administrator))
                                {
                                    <p class="mb-0 fw-bold">Unternehmen</p>
                                }
                                else
                                {
                                    <p class="mb-0 fw-bold">Kunden</p>
                                }
                            </div>
                            <div class="avatar me-sm-6 mt-2">
                                <span class="avatar-initial rounded bg-label-info">
                                    <i class="icon-base ri @(User.IsInRole(UserRoleEnum.Administrator) ? "ri-building-line" : "ri-user-2-line") icon-28px"></i>
                                </span>
                            </div>
                        </div>
                        <hr class="d-none d-sm-block d-lg-none" />
                    </div>
                    <div class="col-6 col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start card-widget-3 border-bottom-0 border-end pb-4 pb-sm-0">
                            <div>
                                <h4 class="mb-0 text-success">€@FormatAmount((decimal)ViewBag.Paid)</h4>
                                <p class="mb-0 fw-bold">Bezahlt</p>
                            </div>
                            <div class="avatar me-sm-6 mt-2">
                                <span class="avatar-initial rounded bg-label-success">
                                    <i class="icon-base ri ri-wallet-line icon-28px"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-6 col-lg-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h4 class="mb-0 text-warning">€@FormatAmount((decimal)ViewBag.Pending)</h4>
                                <p class="mb-0 fw-bold">Ausstehend</p>
                            </div>
                            <div class="avatar mt-2">
                                <span class="avatar-initial rounded bg-label-warning">
                                    <i class="icon-base ri ri-timer-flash-line icon-28px"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Invoices Table -->
    <div class="card">
        <div class="card-header border-bottom">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-lg-6">
                    <div class="input-group input-group-merge">
                        <span class="input-group-text"><i class="icon-base ri ri-search-line icon-20px"></i></span>
                        <input type="text" id="invoicesSearch" class="form-control" placeholder="Rechnungen durchsuchen..." />
                    </div>
                </div>
                <div class="col-12 col-lg-6">
                    <div class="row g-3">
                        <div class="col-12 col-sm-6">
                            <div class="row g-3">
                                <div class="form-floating form-floating-outline col-6">
                                    <input type="number" id="amountFrom" class="form-control" placeholder="" min="1" max="10000" step="1" />
                                    <label for="amountFrom">Betrag Von</label>
                                </div>
                                <div class="form-floating form-floating-outline col-6">
                                    <input type="number" id="amountTo" class="form-control" placeholder="" min="1" max="10000" step="1" />
                                    <label for="amountTo">Betrag Bis</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6">
                            <select id="filterStatus" class="selectpicker w-100" data-style="btn-default" data-width="100%">
                                <option value="">Alle Status</option>
                                <option data-divider="true"></option>
                                <option data-icon="icon-base ri ri-timer-flash-line icon-sm text-warning" value="@InvoiceStatusEnum.Pending">
                                    @AnnotationEnum.General.InvoiceStatus.Pending
                                </option>
                                <option data-icon="icon-base ri ri-wallet-line icon-sm text-success" value="@InvoiceStatusEnum.Paid">
                                    @AnnotationEnum.General.InvoiceStatus.Paid
                                </option>
                                <option data-icon="icon-base ri ri-hand icon-sm text-danger" value="@InvoiceStatusEnum.Cancelled">
                                    @AnnotationEnum.General.InvoiceStatus.Cancelled
                                </option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-datatable">
            <table class="datatables-invoices table">
                <thead>
                    <tr>
                        <th>Status</th>
                        @if (User.IsInRole(UserRoleEnum.Administrator))
                        {
                            <th>Unternehmen</th>
                        }
                        else
                        {
                            <th>Kunde</th>
                        }
                        <th>Dienstleistung</th>
                        <th>Gebühr</th>
                        <th>Datum</th>
                        <th>Anfrage</th>
                        <th>Rechnung</th>
                        @if (User.IsInRole(UserRoleEnum.Administrator))
                        {
                            <th class="text-primary">Aktionen</th>
                        }
                    </tr>
                </thead>
            </table>
        </div>
    </div>

}