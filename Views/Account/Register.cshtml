@inject Bewegdeal.Services.SettingService _settingsService
@model Bewegdeal.ViewModels.RegistrationViewModel
@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Register";
    var _settings = await _settingsService.GetCached();
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/bs-stepper/bs-stepper.css" />
    <link rel="stylesheet" href="~/vendor/libs/bootstrap-select/bootstrap-select.css" />
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.css" />
    <link rel="stylesheet" href="~/vendor/libs/@("@form-validation")/form-validation.css" />
    <link rel="stylesheet" href="~/vendor/libs/notyf/notyf.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/cleave-zen/cleave-zen.js"></script>
    <script src="~/vendor/libs/bs-stepper/bs-stepper.js"></script>
    <script src="~/vendor/libs/select2/select2.js"></script>
    <script src="~/vendor/libs/@("@form-validation")/popular.js"></script>
    <script src="~/vendor/libs/@("@form-validation")/bootstrap5.js"></script>
    <script src="~/vendor/libs/@("@form-validation")/auto-focus.js"></script>
    <script src="~/vendor/libs/notyf/notyf.js"></script>
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css" />
}

@section PageScripts {
    <script src="~/js/app-auth-multisteps.js" asp-append-version="true"></script>
    @{ ViewData["AcceptMode"] = true; ViewData["RegistrationMode"] = true; }
    @await Html.PartialAsync("~/Views/Shared/_Partials/_TermsModal.cshtml")
    @{ ViewData.Remove("AcceptMode"); ViewData.Remove("RegistrationMode"); }
    <script>
        (function () {
            var modalEl = document.getElementById('termsModal');
            if (!modalEl) { return; }

            var checkbox   = document.getElementById('agreeTerms');
            var acceptBtn  = document.getElementById('termsAcceptBtn');
            var body       = document.getElementById('termsModalBody');
            var scrollHint = document.getElementById('termsScrollHint');

            checkbox.addEventListener('click', function (e) {
                if (this.checked) {
                    e.preventDefault();
                    acceptBtn.disabled = true;
                    scrollHint.style.display = '';
                    body.scrollTop = 0;
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                }
            });

            document.getElementById('termsLink').addEventListener('click', function () {
                acceptBtn.disabled = true;
                scrollHint.style.display = '';
                body.scrollTop = 0;
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            });
        })();
    </script>
    <script>
        (function () {
            var stored = localStorage.getItem('templateCustomizer-front-page--Theme');
            if (stored === 'light' || stored === 'dark') {
                document.getElementById('registerTheme').value = stored;
            }
        })();
    </script>
    @if (ViewBag.Error is string error)
    {
        <script>
            new Notyf({ duration: 10000, position: { x: 'center', y: 'top' } }).error(@Json.Serialize(error));
        </script>
    }
}

<div class="position-relative">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner py-6 mx-4" style="max-width: 740px;">
            <div class="card p-sm-7 p-2">
                <!-- Logo -->
                <div class="app-brand justify-content-center mt-5">
                    <a href="/" class="app-brand-link gap-3">
                        <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
                        <span class="app-brand-text demo text-heading fw-semibold">Bewegdeal</span>
                    </a>
                </div>
                <!-- /Logo -->

                <div class="card-body mt-1">
                    <div id="multiStepsValidation" class="bs-stepper wizard-numbered shadow-none">
                        <div class="bs-stepper-header border-bottom-0 mb-2">
                            <div class="step" data-target="#roleSelectionValidation">
                                <button type="button" class="step-trigger">
                                    <span class="bs-stepper-circle"><i class="icon-base ri ri-check-line"></i></span>
                                    <span class="bs-stepper-label">
                                        <span class="bs-stepper-number">01</span>
                                        <span class="d-flex flex-column ms-1">
                                            <span class="bs-stepper-title">Rolle</span>
                                            <span class="bs-stepper-subtitle">Auswahl</span>
                                        </span>
                                    </span>
                                </button>
                            </div>
                            <div class="line"></div>
                            <div class="step" data-target="#personalInfoValidation">
                                <button type="button" class="step-trigger">
                                    <span class="bs-stepper-circle"><i class="icon-base ri ri-check-line"></i></span>
                                    <span class="bs-stepper-label">
                                        <span class="bs-stepper-number">02</span>
                                        <span class="d-flex flex-column ms-1">
                                            <span class="bs-stepper-title">Allgemein</span>
                                            <span class="bs-stepper-subtitle">Angaben</span>
                                        </span>
                                    </span>
                                </button>
                            </div>
                            <div class="line"></div>
                            <div class="step" data-target="#accountDetailsValidation">
                                <button type="button" class="step-trigger">
                                    <span class="bs-stepper-circle"><i class="icon-base ri ri-check-line"></i></span>
                                    <span class="bs-stepper-label">
                                        <span class="bs-stepper-number">03</span>
                                        <span class="d-flex flex-column ms-1">
                                            <span class="bs-stepper-title">Konto</span>
                                            <span class="bs-stepper-subtitle">Abschließen</span>
                                        </span>
                                    </span>
                                </button>
                            </div>
                        </div>

                        <div class="bs-stepper-content">
                            <form id="multiStepsForm" method="post" enctype="multipart/form-data" asp-controller="Account" asp-action="Register" onsubmit="return false">
                                <input type="hidden" name="Theme" id="registerTheme" value="@UserThemeEnum.Light" />
                                <!-- Step 1: Role -->
                                <div id="roleSelectionValidation" class="content">
                                    <div class="content-header mb-5">
                                        <h4 class="mb-0">Ihre Rolle wählen</h4>
                                        <span>Wie möchten Sie Bewegdeal nutzen?</span>
                                    </div>
                                    <div class="row gap-md-0 gap-4 gx-5 form-control-validation">
                                        <div class="col-md">
                                            <div class="form-check custom-option custom-option-icon h-100">
                                                <label class="form-check-label custom-option-content h-100" for="roleCustomer">
                                                    <span class="custom-option-body">
                                                        <i class="icon-base ri ri-user-2-line icon-32px mb-2 text-success"></i>
                                                        <span class="fs-6 d-block fw-medium text-heading mb-2">Kunde</span>
                                                        <small>Ich benötige Dienstleistungen – Umzug, Entrümpelung, Einkaufsabholung oder Fahrzeugtransport</small>
                                                    </span>
                                                    <input name="role" class="form-check-input" type="radio" value="@UserRoleEnum.Customer" id="roleCustomer" checked="@(Model.Role == UserRoleEnum.Customer ? "checked" : null)" />
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md">
                                            <div class="form-check custom-option custom-option-icon h-100">
                                                <label class="form-check-label custom-option-content h-100" for="roleCompany">
                                                    <span class="custom-option-body">
                                                        <i class="icon-base ri ri-building-line icon-32px mb-2 text-info"></i>
                                                        <span class="fs-6 d-block fw-medium text-heading mb-2">Unternehmen</span>
                                                        <small>Ich biete Dienstleistungen an und möchte Kunden gewinnen</small>
                                                    </span>
                                                    <input name="role" class="form-check-input" type="radio" value="@UserRoleEnum.Company" id="roleCompany" checked="@(Model.Role == UserRoleEnum.Company ? "checked" : null)" />
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12 d-flex justify-content-between mt-8">
                                        <button class="btn btn-outline-secondary btn-prev" disabled>
                                            <i class="icon-base ri ri-arrow-left-line icon-16px me-sm-1_5 me-0"></i>
                                            <span class="align-middle d-sm-inline-block d-none">Zurück</span>
                                        </button>
                                        <button class="btn btn-primary btn-next">
                                            <span class="align-middle d-sm-inline-block d-none me-sm-1_5 me-0">Weiter</span>
                                            <i class="icon-base ri ri-arrow-right-line icon-16px"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Step 2: Personal Information -->
                                <div id="personalInfoValidation" class="content">
                                    <div class="content-header mb-5">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <h4 class="mb-0">Kurz zu Ihrer Person</h4>
                                            <span id="roleIndicator" class="badge d-none"></span>
                                        </div>
                                        <span>Bitte geben Sie Ihre Daten sorgfältig ein</span>
                                    </div>
                                    <div class="row gx-5">
                                        <div class="col-sm-6 mb-5 form-control-validation">
                                            <div class="form-floating form-floating-outline">
                                                <input type="text" id="name" name="name" class="form-control" placeholder="" value="@Model.Name" />
                                                <label for="name">Name</label>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 mb-5">
                                            <div class="input-group input-group-merge">
                                                <span class="input-group-text">@_settings.MobilePrefix</span>
                                                <div class="form-floating form-floating-outline">
                                                    <input type="text" id="mobile" name="mobile" class="form-control" placeholder="" value="@Model.Mobile" />
                                                    <label for="mobile">Mobilnummer</label>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="numberCol" class="col-sm-6 mb-5 d-none">
                                            <div class="form-floating form-floating-outline">
                                                <input type="text" id="number" name="number" class="form-control" placeholder="" value="@Model.Number" />
                                                <label for="number">UID/GISA</label>
                                            </div>
                                        </div>
                                        <div id="addressCol" class="col-sm-6 mb-5 form-control-validation d-none">
                                            <div class="form-floating form-floating-outline">
                                                <input type="text" id="address" name="address" class="form-control" placeholder="" value="@Model.Address" />
                                                <label for="address">Adresse</label>
                                            </div>
                                        </div>
                                        <div class="col-12 d-flex justify-content-between">
                                            <button class="btn btn-outline-secondary btn-prev">
                                                <i class="icon-base ri ri-arrow-left-line icon-16px me-sm-1_5 me-0"></i>
                                                <span class="align-middle d-sm-inline-block d-none">Zurück</span>
                                            </button>
                                            <button class="btn btn-primary btn-next">
                                                <span class="align-middle d-sm-inline-block d-none me-sm-1_5 me-0">Weiter</span>
                                                <i class="icon-base ri ri-arrow-right-line icon-16px"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Step 3: Account Details -->
                                <div id="accountDetailsValidation" class="content">
                                    <div class="content-header mb-5">
                                        <h4 class="mb-0">Konto erstellen</h4>
                                        <span>Noch ein paar letzte Angaben</span>
                                    </div>
                                    <div class="row gx-5">
                                        <div class="col-sm-6 mb-5 form-control-validation">
                                            <div class="form-floating form-floating-outline">
                                                <input type="email" name="email" id="email" class="form-control" placeholder="" value="@Model.Email" />
                                                <label for="email">E-Mail</label>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 mb-5 form-control-validation d-flex align-items-center">
                                            <div class="form-check mb-0">
                                                <input class="form-check-input" type="checkbox" id="agreeTerms" name="agreeTerms" />
                                                <label class="form-check-label" for="agreeTerms">
                                                    Ich stimme den <span class="text-primary" style="cursor:pointer;" id="termsLink">AGB</span> zu
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 form-password-toggle mb-5 form-control-validation">
                                            <div class="input-group input-group-merge">
                                                <div class="form-floating form-floating-outline">
                                                    <input type="password" id="password" name="password" class="form-control" placeholder="" />
                                                    <label for="password">Passwort</label>
                                                </div>
                                                <span class="input-group-text cursor-pointer"><i class="icon-base ri ri-eye-off-line ri-20px"></i></span>
                                            </div>
                                        </div>
                                        <div class="col-sm-6 form-password-toggle mb-5 form-control-validation">
                                            <div class="input-group input-group-merge">
                                                <div class="form-floating form-floating-outline">
                                                    <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" placeholder="" />
                                                    <label for="confirmPassword">Passwort bestätigen</label>
                                                </div>
                                                <span class="input-group-text cursor-pointer"><i class="icon-base ri ri-eye-off-line ri-20px"></i></span>
                                            </div>
                                        </div>
                                        <!-- Services -->
                                        <div id="servicesSection" class="col-12 mb-5 d-none">
                                            <p class="fw-medium mb-3">Ihre Interessen</p>
                                            <div class="row gy-3">
                                                <div class="col-6 col-sm-6 col-md-6">
                                                    <div class="form-check custom-option custom-option-icon">
                                                        <label class="form-check-label custom-option-content" for="serviceMoving">
                                                            <span class="custom-option-body">
                                                                <i class="icon-base ri ri-truck-line text-success"></i>
                                                                <span class="custom-option-title mb-1">@AnnotationEnum.General.Service.Moving</span>
                                                            </span>
                                                            <input class="form-check-input" type="checkbox" name="Interests" id="serviceMoving" value="@ServiceEnum.Moving" checked="@(Model.Interests?.Contains(ServiceEnum.Moving) == true ? "checked" : null)" />
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-6 col-sm-6 col-md-6">
                                                    <div class="form-check custom-option custom-option-icon">
                                                        <label class="form-check-label custom-option-content" for="serviceJunk">
                                                            <span class="custom-option-body">
                                                                <i class="icon-base ri ri-recycle-line text-danger"></i>
                                                                <span class="custom-option-title mb-1">@AnnotationEnum.General.Service.Removal</span>
                                                            </span>
                                                            <input class="form-check-input" type="checkbox" name="Interests" id="serviceJunk" value="@ServiceEnum.Removal" checked="@(Model.Interests?.Contains(ServiceEnum.Removal) == true ? "checked" : null)" />
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-6 col-sm-6 col-md-6">
                                                    <div class="form-check custom-option custom-option-icon">
                                                        <label class="form-check-label custom-option-content" for="serviceStorePickup">
                                                            <span class="custom-option-body">
                                                                <i class="icon-base ri ri-shopping-bag-4-line text-warning"></i>
                                                                <span class="custom-option-title mb-1">@AnnotationEnum.General.Service.Pickup</span>
                                                            </span>
                                                            <input class="form-check-input" type="checkbox" name="Interests" id="serviceStorePickup" value="@ServiceEnum.Pickup" checked="@(Model.Interests?.Contains(ServiceEnum.Pickup) == true ? "checked" : null)" />
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="col-6 col-sm-6 col-md-6">
                                                    <div class="form-check custom-option custom-option-icon">
                                                        <label class="form-check-label custom-option-content" for="serviceVehicle">
                                                            <span class="custom-option-body">
                                                                <i class="icon-base ri ri-car-line text-info"></i>
                                                                <span class="custom-option-title mb-1">@AnnotationEnum.General.Service.Transport</span>
                                                            </span>
                                                            <input class="form-check-input" type="checkbox" name="Interests" id="serviceVehicle" value="@ServiceEnum.Transport" checked="@(Model.Interests?.Contains(ServiceEnum.Transport) == true ? "checked" : null)" />
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- /Services -->
                                        <div id="companyTermsUpload" class="col-12 mb-5 d-none">
                                            <p class="fw-medium mb-3">Ihre AGB (nur PDF-Dateien)</p>
                                            <input class="form-control form-control-sm" id="companyTermsFile" name="TermsFile" type="file" accept=".pdf" />
                                        </div>
                                        <div class="col-12 d-flex justify-content-between">
                                            <button class="btn btn-outline-secondary btn-prev">
                                                <i class="icon-base ri ri-arrow-left-line icon-16px me-sm-1_5 me-0"></i>
                                                <span class="align-middle d-sm-inline-block d-none">Zurück</span>
                                            </button>
                                            <button type="submit" class="btn btn-primary btn-next btn-submit">
                                                Absenden <i class="icon-base ri ri-check-line icon-16px ms-1_5"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <p class="text-center mt-5 mb-0">
                        <span>Bereits ein Konto?</span>
                        <a href="/Account/Login"><span>Jetzt anmelden</span></a>
                    </p>
                </div>
            </div>

            <img src="~/img/illustrations/bewegdeal-truck.png" alt="auth-tree" class="authentication-image-object-left d-none d-lg-block" />
            <img src="~/img/illustrations/auth-basic-mask-light.png" class="authentication-image d-none d-lg-block scaleX-n1-rtl" height="172" alt="triangle-bg" data-app-light-img="illustrations/auth-basic-mask-light.png" data-app-dark-img="illustrations/auth-basic-mask-dark.png" />
            <img src="~/img/illustrations/bewegdeal-delivery.png" alt="auth-tree" class="authentication-image-object-right d-none d-lg-block" />
        </div>
    </div>
</div>

<script>
    window.Helpers.initCustomOptionCheck();

    // Restore company-only sections when the page reloads with a pre-selected role
    document.addEventListener('DOMContentLoaded', function () {
        const selected = document.querySelector('[name="role"]:checked');
        if (selected && selected.value === 'company') {
            const servicesSection = document.querySelector('#servicesSection');
            if (servicesSection) { servicesSection.classList.remove('d-none'); }
            const companyTermsUpload = document.querySelector('#companyTermsUpload');
            if (companyTermsUpload) { companyTermsUpload.classList.remove('d-none'); }
            const numberCol = document.getElementById('numberCol');
            if (numberCol) { numberCol.classList.remove('d-none'); }
            const addressCol = document.getElementById('addressCol');
            if (addressCol) { addressCol.classList.remove('d-none'); }
        }
    });
</script>
