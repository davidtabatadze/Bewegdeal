@{
    Layout = "_BlankLayout";
    ViewData["Title"] = "Forgot Password";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/@("@form-validation")/form-validation.css" />
    <link rel="stylesheet" href="~/vendor/libs/notyf/notyf.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/@("@form-validation")/popular.js"></script>
    <script src="~/vendor/libs/@("@form-validation")/bootstrap5.js"></script>
    <script src="~/vendor/libs/@("@form-validation")/auto-focus.js"></script>
    <script src="~/vendor/libs/notyf/notyf.js"></script>
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-auth.css" />
}

@section PageScripts {
    <script src="~/js/pages-auth.js"></script>
    @if (TempData["ForgotSuccess"] is string success)
    {
        <script>
            new Notyf({ duration: 5000, position: { x: 'center', y: 'top' } }).success(@Json.Serialize(success));
        </script>
    }
    @if (TempData["ForgotError"] is string error)
    {
        <script>
            new Notyf({ duration: 5000, position: { x: 'center', y: 'top' } }).error(@Json.Serialize(error));
        </script>
    }
}

<div class="position-relative">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner py-6 mx-4">
            <div class="card p-sm-7 p-2">
                <!-- Logo -->
                <div class="app-brand justify-content-center mt-5">
                    <a href="/" class="app-brand-link gap-3">
                        <span class="app-brand-logo demo">@await Html.PartialAsync("../_Partials/_Macros")</span>
                        <span class="app-brand-text demo text-heading fw-semibold">Bewegdeal</span>
                    </a>
                </div>
                <!-- /Logo -->

                <div class="card-body mt-1">
                    <h4 class="mb-1">Forgot Password? 🔒</h4>
                    <p class="mb-5">Enter your email and we'll send you a reset link</p>

                    <form id="formAuthentication" class="mb-5" asp-action="ForgotPassword" asp-controller="Account" method="post">
                        <div class="form-floating form-floating-outline mb-5 form-control-validation">
                            <input type="text" class="form-control" id="email" name="email" placeholder="" autofocus />
                            <label for="email">Email</label>
                        </div>
                        <button class="btn btn-primary d-grid w-100 mb-5">Send Reset Link</button>
                    </form>

                    <div class="text-center">
                        <a asp-controller="Account" asp-action="Login" class="d-flex align-items-center justify-content-center">
                            <i class="icon-base ri ri-arrow-left-s-line scaleX-n1-rtl icon-20px me-1_5"></i>
                            Back to login
                        </a>
                    </div>
                </div>
            </div>

            <img src="~/img/illustrations/tree-3.png" alt="auth-tree" class="authentication-image-object-left d-none d-lg-block" />
            <img src="~/img/illustrations/auth-basic-mask-light.png" class="authentication-image d-none d-lg-block scaleX-n1-rtl" height="172" alt="triangle-bg" data-app-light-img="illustrations/auth-basic-mask-light.png" data-app-dark-img="illustrations/auth-basic-mask-dark.png" />
            <img src="~/img/illustrations/tree.png" alt="auth-tree" class="authentication-image-object-right d-none d-lg-block" />
        </div>
    </div>
</div>
