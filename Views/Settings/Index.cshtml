@model Bewegdeal.Data.Entities.SettingsEntity

@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Settings";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/quill/katex.css" />
    <link rel="stylesheet" href="~/vendor/libs/quill/editor.css" />
    <link rel="stylesheet" href="~/vendor/libs/quill/typography.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/quill/katex.js"></script>
    <script src="~/vendor/libs/quill/quill.js"></script>
}

@section PageScripts {
    <script>
        (function () {
        var fullToolbar = [
        [{ font: [] }, { size: [] }],
        ['bold', 'italic', 'underline', 'strike'],
        [{ color: [] }, { background: [] }],
        [{ script: 'super' }, { script: 'sub' }],
        [{ list: 'ordered' }, { indent: '-1' }, { indent: '+1' }],
        [{ align: [] }],
        ['link']
        ];

        var quill = new Quill('#tcEditorCustomer', {
        bounds: '#tcEditorCustomer',
        placeholder: '',
        modules: { toolbar: fullToolbar },
        theme: 'snow'
        });

        quill.root.style.maxHeight = '300px';
        quill.root.style.overflowY = 'auto';

        quill.root.innerHTML = @Html.Raw(Json.Serialize(Model.TermsAndConditionsContentCustomer));

        document.getElementById('tcFormCustomer').addEventListener('submit', function () {
        document.getElementById('tcCustomer').value = quill.root.innerHTML;
        });

        var quillCompany = new Quill('#tcEditorCompany', {
        bounds: '#tcEditorCompany',
        placeholder: '',
        modules: { toolbar: fullToolbar },
        theme: 'snow'
        });

        quillCompany.root.style.maxHeight = '300px';
        quillCompany.root.style.overflowY = 'auto';

        quillCompany.root.innerHTML = @Html.Raw(Json.Serialize(Model.TermsAndConditionsContentCompany));

        document.getElementById('tcFormCompany').addEventListener('submit', function () {
        document.getElementById('tcCompany').value = quillCompany.root.innerHTML;
        });

        var quillAboutUs = new Quill('#aboutUsEditor', {
        bounds: '#aboutUsEditor',
        placeholder: '',
        modules: { toolbar: fullToolbar },
        theme: 'snow'
        });

        quillAboutUs.root.style.maxHeight = '300px';
        quillAboutUs.root.style.overflowY = 'auto';

        quillAboutUs.root.innerHTML = @Html.Raw(Json.Serialize(Model.AboutUs));

        document.getElementById('aboutUsForm').addEventListener('submit', function () {
        document.getElementById('aboutUsContent').value = quillAboutUs.root.innerHTML;
        });
        })();
    </script>
}

<div class="row g-6">

    <!-- Mobile -->
    <div class="col-12">
        <form asp-controller="Settings" asp-action="SaveMobile" method="post">
            <div class="card">

                <div class="card-header">
                    <h5 class="card-title m-0">Mobile</h5>
                </div>

                <div class="card-body">

                    @* @if (TempData["MobileError"] is string mobileError)
                    {
                        <div class="alert alert-danger mb-4 text-center" role="alert">@mobileError</div>
                    }
                    @if (TempData["MobileSuccess"] is string mobileSuccess)
                    {
                        <div class="alert alert-success mb-4 text-center" role="alert">@mobileSuccess</div>
                    } *@

                    <div class="row justify-content-center">
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="text" class="form-control" id="mobilePrefix"
                                       name="mobilePrefix" value="@Model.MobilePrefix"
                                       placeholder="" />
                                <label for="mobilePrefix">Mobile Prefix</label>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>

            </div>
        </form>
    </div>

    <!-- Invoice -->
    <div class="col-12">
        <form asp-controller="Settings" asp-action="SaveInvoice" method="post">
            <div class="card">

                <div class="card-header">
                    <h5 class="card-title m-0">Invoice</h5>
                </div>

                <div class="card-body">

                    @* @if (TempData["InvoiceError"] is string invoiceError)
                    {
                        <div class="alert alert-danger mb-4 text-center" role="alert">@invoiceError</div>
                    }
                    @if (TempData["InvoiceSuccess"] is string invoiceSuccess)
                    {
                        <div class="alert alert-success mb-4 text-center" role="alert">@invoiceSuccess</div>
                    }*@

                    <div class="row justify-content-center g-5">
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="commissionPersent"
                                       name="commissionPersent" value="@Model.InvoiceCommissionPersent"
                                       min="1" placeholder="" />
                                <label for="commissionPersent">Commission %</label>
                            </div>
                        </div>
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="taxPersent"
                                       name="taxPersent" value="@Model.InvoiceTaxPersent"
                                       min="1" placeholder="" />
                                <label for="taxPersent">Tax %</label>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>

            </div>
        </form>
    </div>

    <!-- Request -->
    <div class="col-12">
        <form asp-controller="Settings" asp-action="SaveRequest" method="post">
            <div class="card">

                <div class="card-header">
                    <h5 class="card-title m-0">Request</h5>
                </div>

                <div class="card-body">

                    @* @if (TempData["RequestError"] is string requestError)
                    {
                        <div class="alert alert-danger mb-4 text-center" role="alert">@requestError</div>
                    }
                    @if (TempData["RequestSuccess"] is string requestSuccess)
                    {
                        <div class="alert alert-success mb-4 text-center" role="alert">@requestSuccess</div>
                    } *@

                    <!-- Negotiation -->
                    @* <div class="row justify-content-center">
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="requestNegotiationMinutes"
                                       name="requestNegotiationMinutes" value="@Model.RequestNegotiationMinutes"
                                       min="1" placeholder="" />
                                <label for="requestNegotiationMinutes">Negotiation Minutes</label>
                            </div>
                        </div>
                    </div> *@

                    @* <hr class="my-6 mx-n4" /> *@

                    <!-- Images -->
                    <div class="row justify-content-center g-5">
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="requestImageMaxCount"
                                       name="imageMaxCount" value="@Model.RequestImageMaxCount"
                                       min="1" placeholder="" />
                                <label for="requestImageMaxCount">Image Max Count</label>
                            </div>
                        </div>
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="requestImageMaxSize"
                                       name="imageMaxSize" value="@Model.RequestImageMaxSize"
                                       min="1" placeholder="" />
                                <label for="requestImageMaxSize">Image Max Size (MB)</label>
                            </div>
                        </div>
                    </div>

                    <hr class="my-6 mx-n4" />

                    <!-- Videos -->
                    <div class="row justify-content-center g-5">
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="requestVideoMaxCount"
                                       name="videoMaxCount" value="@Model.RequestVideoMaxCount"
                                       min="1" placeholder="" />
                                <label for="requestVideoMaxCount">Video Max Count</label>
                            </div>
                        </div>
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="requestVideoMaxSize"
                                       name="videoMaxSize" value="@Model.RequestVideoMaxSize"
                                       min="1" placeholder="" />
                                <label for="requestVideoMaxSize">Video Max Size (MB)</label>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>

            </div>
        </form>
    </div>

    <!-- About Us -->
    <div class="col-12">
        <form id="aboutUsForm" asp-controller="Settings" asp-action="SaveAboutUs" method="post">
            <input type="hidden" id="aboutUsContent" name="content" />
            <div class="card">

                <div class="card-header">
                    <h5 class="card-title m-0">About Us</h5>
                </div>

                <div class="card-body">

                    @* @if (TempData["TermsError"] is string termsError)
                    {
                        <div class="alert alert-danger mb-4 text-center" role="alert">@termsError</div>
                    }
                    @if (TempData["TermsSuccess"] is string termsSuccess)
                    {
                        <div class="alert alert-success mb-4 text-center" role="alert">@termsSuccess</div>
                    } *@

                    <div id="aboutUsEditor"></div>

                </div>

                <div class="card-footer d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>

            </div>
        </form>
    </div>

    <!-- Terms & Conditions for Customer -->
    <div class="col-12">
        <form id="tcFormCustomer" asp-controller="Settings" asp-action="SaveTermsAndConditionsCustomer" method="post">
            <input type="hidden" id="tcCustomer" name="content" />
            <div class="card">

                <div class="card-header">
                    <h5 class="card-title m-0">T&amp;C for the <strong>Customer</strong></h5>
                </div>

                <div class="card-body">

                    @* @if (TempData["TermsError"] is string termsError)
                    {
                        <div class="alert alert-danger mb-4 text-center" role="alert">@termsError</div>
                    }
                    @if (TempData["TermsSuccess"] is string termsSuccess)
                    {
                        <div class="alert alert-success mb-4 text-center" role="alert">@termsSuccess</div>
                    } *@

                    <div class="alert alert-danger mb-4" role="alert">
                        <div class="d-flex align-items-center mb-2">
                            <i class="icon-base ri ri-error-warning-line me-2 icon-22px"></i>
                            <strong>Handle with care</strong>
                        </div>
                        <ul class="mb-0">
                            <li>Saving changes will require existing customers to re-agree to the Terms &amp; Conditions.</li>
                        </ul>
                    </div>

                    <div id="tcEditorCustomer"></div>

                </div>

                <div class="card-footer d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>

            </div>
        </form>
    </div>

    <!-- Terms & Conditions for Company -->
    <div class="col-12">
        <form id="tcFormCompany" asp-controller="Settings" asp-action="SaveTermsAndConditionsCompany" method="post">
            <input type="hidden" id="tcCompany" name="content" />
            <div class="card">

                <div class="card-header">
                    <h5 class="card-title m-0">T&amp;C for the <strong>Company</strong></h5>
                </div>

                <div class="card-body">

                    @* @if (TempData["TermsError"] is string termsError)
                    {
                        <div class="alert alert-danger mb-4 text-center" role="alert">@termsError</div>
                    }
                    @if (TempData["TermsSuccess"] is string termsSuccess)
                    {
                        <div class="alert alert-success mb-4 text-center" role="alert">@termsSuccess</div>
                    } *@

                    <div class="alert alert-danger mb-4" role="alert">
                        <div class="d-flex align-items-center mb-2">
                            <i class="icon-base ri ri-error-warning-line me-2 icon-22px"></i>
                            <strong>Handle with care</strong>
                        </div>
                        <ul class="mb-0">
                            <li>Saving changes will require existing companies to re-agree to the Terms &amp; Conditions.</li>
                        </ul>
                    </div>

                    <div id="tcEditorCompany"></div>

                </div>

                <div class="card-footer d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>

            </div>
        </form>
    </div>

</div>
