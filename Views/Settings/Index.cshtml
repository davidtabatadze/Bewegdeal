@model Bewegdeal.Data.Entities.SettingsEntity

@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Settings";
    var openSection = TempData["OpenSection"] as string ?? "";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/quill/katex.css" />
    <link rel="stylesheet" href="~/vendor/libs/quill/editor.css" />
    <link rel="stylesheet" href="~/vendor/libs/quill/typography.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/quill/katex.js"></script>
    <script src="~/vendor/libs/quill/quill.js"></script>
}

@section PageScripts {
    <script>
        (function () {
        var fullToolbar = [
        [{ font: [] }, { size: [] }],
        ['bold', 'italic', 'underline', 'strike'],
        [{ color: [] }, { background: [] }],
        [{ script: 'super' }, { script: 'sub' }],
        [{ list: 'ordered' }, { indent: '-1' }, { indent: '+1' }],
        [{ align: [] }],
        ['link']
        ];

        var quill = new Quill('#tcEditorCustomer', {
        bounds: '#tcEditorCustomer',
        placeholder: '',
        modules: { toolbar: fullToolbar },
        theme: 'snow'
        });

        quill.root.style.maxHeight = '300px';
        quill.root.style.overflowY = 'auto';

        quill.root.innerHTML = @Html.Raw(Json.Serialize(Model.TermsAndConditionsContentCustomer));

        document.getElementById('tcFormCustomer').addEventListener('submit', function () {
        document.getElementById('tcCustomer').value = quill.root.innerHTML;
        });

        var quillCompany = new Quill('#tcEditorCompany', {
        bounds: '#tcEditorCompany',
        placeholder: '',
        modules: { toolbar: fullToolbar },
        theme: 'snow'
        });

        quillCompany.root.style.maxHeight = '300px';
        quillCompany.root.style.overflowY = 'auto';

        quillCompany.root.innerHTML = @Html.Raw(Json.Serialize(Model.TermsAndConditionsContentCompany));

        document.getElementById('tcFormCompany').addEventListener('submit', function () {
        document.getElementById('tcCompany').value = quillCompany.root.innerHTML;
        });

        var quillAboutUs = new Quill('#aboutUsEditor', {
        bounds: '#aboutUsEditor',
        placeholder: '',
        modules: { toolbar: fullToolbar },
        theme: 'snow'
        });

        quillAboutUs.root.style.maxHeight = '300px';
        quillAboutUs.root.style.overflowY = 'auto';

        quillAboutUs.root.innerHTML = @Html.Raw(Json.Serialize(Model.AboutUs));

        document.getElementById('aboutUsForm').addEventListener('submit', function () {
        document.getElementById('aboutUsContent').value = quillAboutUs.root.innerHTML;
        });

        var quillPrivacyPolicy = new Quill('#privacyPolicyEditor', {
        bounds: '#privacyPolicyEditor',
        placeholder: '',
        modules: { toolbar: fullToolbar },
        theme: 'snow'
        });

        quillPrivacyPolicy.root.style.maxHeight = '300px';
        quillPrivacyPolicy.root.style.overflowY = 'auto';

        quillPrivacyPolicy.root.innerHTML = @Html.Raw(Json.Serialize(Model.PrivacyPolicy));

        document.getElementById('privacyPolicyForm').addEventListener('submit', function () {
        document.getElementById('privacyPolicyContent').value = quillPrivacyPolicy.root.innerHTML;
        });
        })();

        // Sync .active class for server-pre-opened accordion items (main.js only adds it via Bootstrap events)
        document.querySelectorAll('.accordion-collapse.show').forEach(function (el) {
        var item = el.closest('.accordion-item');
        item.classList.add('active');
        if (item.previousElementSibling) {
        item.previousElementSibling.classList.add('previous-active');
        }
        });
    </script>
}

@{
    string Show(string section) => openSection == section ? "show" : "";
    string Collapsed(string section) => openSection == section ? "" : "collapsed";
}

<div class="accordion" id="settingsAccordion">

    <!-- Mobile -->
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button @Collapsed("mobile")" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapseMobile"
                    aria-expanded="@(openSection == "mobile" ? "true" : "false")"
                    aria-controls="collapseMobile">
                Mobile
            </button>
        </h2>
        <div id="collapseMobile" class="accordion-collapse collapse @Show("mobile")"
             data-bs-parent="#settingsAccordion">
            <form asp-controller="Settings" asp-action="SaveMobile" method="post">
                <div class="accordion-body p-4">
                    <div class="row justify-content-center">
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="text" class="form-control" id="mobilePrefix"
                                       name="mobilePrefix" value="@Model.MobilePrefix"
                                       placeholder="" />
                                <label for="mobilePrefix">Mobile Prefix</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-body pt-0 d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Invoice -->
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button @Collapsed("invoice")" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapseInvoice"
                    aria-expanded="@(openSection == "invoice" ? "true" : "false")"
                    aria-controls="collapseInvoice">
                Invoice
            </button>
        </h2>
        <div id="collapseInvoice" class="accordion-collapse collapse @Show("invoice")"
             data-bs-parent="#settingsAccordion">
            <form asp-controller="Settings" asp-action="SaveInvoice" method="post">
                <div class="accordion-body p-4">
                    <div class="row justify-content-center g-5 pb-5">
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="commissionPersent"
                                       name="commissionPersent" value="@Model.InvoiceCommissionPersent"
                                       min="1" placeholder="" />
                                <label for="commissionPersent">Commission %</label>
                            </div>
                        </div>
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="taxPersent"
                                       name="taxPersent" value="@Model.InvoiceTaxPersent"
                                       min="1" placeholder="" />
                                <label for="taxPersent">Tax %</label>
                            </div>
                        </div>
                    </div>
                    <div class="row justify-content-center g-5">
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="invoiceDueDays"
                                       name="dueDays" value="@Model.InvoiceDueDays"
                                       min="1" placeholder="" />
                                <label for="invoiceDueDays">Due Days</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-body pt-0 d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Request -->
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button @Collapsed("request")" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapseRequest"
                    aria-expanded="@(openSection == "request" ? "true" : "false")"
                    aria-controls="collapseRequest">
                Request
            </button>
        </h2>
        <div id="collapseRequest" class="accordion-collapse collapse @Show("request")"
             data-bs-parent="#settingsAccordion">
            <form asp-controller="Settings" asp-action="SaveRequest" method="post">
                <div class="accordion-body p-4">
                    <!-- Images -->
                    <div class="row justify-content-center g-5 pb-5">
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="requestImageMaxCount"
                                       name="imageMaxCount" value="@Model.RequestImageMaxCount"
                                       min="1" placeholder="" />
                                <label for="requestImageMaxCount">Image Max Count</label>
                            </div>
                        </div>
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="requestImageMaxSize"
                                       name="imageMaxSize" value="@Model.RequestImageMaxSize"
                                       min="1" placeholder="" />
                                <label for="requestImageMaxSize">Image Max Size (MB)</label>
                            </div>
                        </div>
                    </div>
                    <!-- Videos -->
                    <div class="row justify-content-center g-5">
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="requestVideoMaxCount"
                                       name="videoMaxCount" value="@Model.RequestVideoMaxCount"
                                       min="1" placeholder="" />
                                <label for="requestVideoMaxCount">Video Max Count</label>
                            </div>
                        </div>
                        <div class="col-auto" style="width: 200px">
                            <div class="form-floating form-floating-outline">
                                <input type="number" class="form-control" id="requestVideoMaxSize"
                                       name="videoMaxSize" value="@Model.RequestVideoMaxSize"
                                       min="1" placeholder="" />
                                <label for="requestVideoMaxSize">Video Max Size (MB)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="accordion-body pt-0 d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- About Us -->
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button @Collapsed("aboutUs")" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapseAboutUs"
                    aria-expanded="@(openSection == "aboutUs" ? "true" : "false")"
                    aria-controls="collapseAboutUs">
                About Us
            </button>
        </h2>
        <div id="collapseAboutUs" class="accordion-collapse collapse @Show("aboutUs")"
             data-bs-parent="#settingsAccordion">
            <form id="aboutUsForm" asp-controller="Settings" asp-action="SaveAboutUs" method="post">
                <input type="hidden" id="aboutUsContent" name="content" />
                <div class="accordion-body p-4">
                    <div id="aboutUsEditor"></div>
                </div>
                <div class="accordion-body pt-0 d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Privacy Policy -->
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button @Collapsed("privacyPolicy")" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapsePrivacyPolicy"
                    aria-expanded="@(openSection == "privacyPolicy" ? "true" : "false")"
                    aria-controls="collapsePrivacyPolicy">
                Privacy Policy
            </button>
        </h2>
        <div id="collapsePrivacyPolicy" class="accordion-collapse collapse @Show("privacyPolicy")"
             data-bs-parent="#settingsAccordion">
            <form id="privacyPolicyForm" asp-controller="Settings" asp-action="SavePrivacyPolicy" method="post">
                <input type="hidden" id="privacyPolicyContent" name="content" />
                <div class="accordion-body p-4">
                    <div id="privacyPolicyEditor"></div>
                </div>
                <div class="accordion-body pt-0 d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Terms & Conditions for Customer -->
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button @Collapsed("tcCustomer")" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapseTcCustomer"
                    aria-expanded="@(openSection == "tcCustomer" ? "true" : "false")"
                    aria-controls="collapseTcCustomer">
                T&amp;C for the <strong class="ms-1">Customer</strong>
            </button>
        </h2>
        <div id="collapseTcCustomer" class="accordion-collapse collapse @Show("tcCustomer")"
             data-bs-parent="#settingsAccordion">
            <form id="tcFormCustomer" asp-controller="Settings" asp-action="SaveTermsAndConditionsCustomer" method="post">
                <input type="hidden" id="tcCustomer" name="content" />
                <div class="accordion-body">
                    <div class="alert alert-danger mb-4" role="alert">
                        <div class="d-flex align-items-center mb-2">
                            <i class="icon-base ri ri-error-warning-line me-2 icon-22px"></i>
                            <strong>Handle with care</strong>
                        </div>
                        <ul class="mb-0">
                            <li>Saving changes will require existing customers to re-agree to the Terms &amp; Conditions.</li>
                        </ul>
                    </div>
                    <div id="tcEditorCustomer"></div>
                </div>
                <div class="accordion-body pt-0 d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Terms & Conditions for Company -->
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button @Collapsed("tcCompany")" type="button"
                    data-bs-toggle="collapse" data-bs-target="#collapseTcCompany"
                    aria-expanded="@(openSection == "tcCompany" ? "true" : "false")"
                    aria-controls="collapseTcCompany">
                T&amp;C for the <strong class="ms-1">Company</strong>
            </button>
        </h2>
        <div id="collapseTcCompany" class="accordion-collapse collapse @Show("tcCompany")"
             data-bs-parent="#settingsAccordion">
            <form id="tcFormCompany" asp-controller="Settings" asp-action="SaveTermsAndConditionsCompany" method="post">
                <input type="hidden" id="tcCompany" name="content" />
                <div class="accordion-body">
                    <div class="alert alert-danger mb-4" role="alert">
                        <div class="d-flex align-items-center mb-2">
                            <i class="icon-base ri ri-error-warning-line me-2 icon-22px"></i>
                            <strong>Handle with care</strong>
                        </div>
                        <ul class="mb-0">
                            <li>Saving changes will require existing companies to re-agree to the Terms &amp; Conditions.</li>
                        </ul>
                    </div>
                    <div id="tcEditorCompany"></div>
                </div>
                <div class="accordion-body pt-0 d-flex justify-content-center">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

</div>
